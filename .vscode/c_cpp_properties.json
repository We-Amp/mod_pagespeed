{
  "configurations": [
    {
      "name": "Linux",
      "intelliSenseMode": "linux-clang-x64",
      "compilerPath": "/usr/bin/clang++",
      "includePath": [
        "${workspaceFolder}",
        "${workspaceFolder}/bazel-mod_pagespeed/external/**",
        "${workspaceFolder}/bazel-bin/**",
        "/usr/local/include",
        "/usr/include/x86_64-linux-gnu",
        "/usr/include"
      ],
      "defines": [
        "__linux__",
        "NDEBUG"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}",
          "${workspaceFolder}/bazel-mod_pagespeed/external/**"
        ],
        "limitSymbolsToIncludedHeaders": true
      },
      "cStandard": "c17",
      "cppStandard": "c++20",
      "compileCommands": "${workspaceFolder}/compile_commands.json"
    }
  ],
  "version": 4
}
