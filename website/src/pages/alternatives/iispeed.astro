---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { offerJsonLd } from '../../data/offer-jsonld';
import NugetCmd from '../../components/release/NugetCmd.astro';
import { COMMERCIAL_EMAIL, FREE_TO_RUN_LINE, LICENSE_CLAUSE } from '../../data/product-facts.mjs';

const faq = [
  {
    q: 'Is IISpeed still supported?',
    a: 'Existing IISpeed installations keep working with ongoing support, but IISpeed itself no longer receives updates: its IIS integration lives on in the mod_pagespeed IIS module. New IIS deployments should use mod_pagespeed for IIS, and ASP.NET Core deployments the WeAmp.PageSpeed.AspNetCore NuGet package.',
  },
  {
    q: 'I hold an IISpeed license. What do I need to do?',
    a: `Request the transfer through the license-transfer form at https://modpagespeed.com/contact/?topic=iispeed-transfer, with your order number or the email address the license was bought under. The transfer is at no cost: paid terms are honored to expiry, and you keep your current rate when you move to a support subscription. No new license is needed; the software is free to install and run. Other questions go to ${COMMERCIAL_EMAIL}.`,
  },
  {
    q: 'What replaces IISpeed for IIS deployments?',
    a: 'mod_pagespeed ships a native IIS module with the same web.config surface IISpeed offered — a modernized, secured filter stack with new optimizers, same admin console, plus security patches, current toolchain, and Cyclone Cache. The IIS package ships as a signed installer on the mod_pagespeed GitHub release.',
  },
  {
    q: 'Does WeAmp.PageSpeed.AspNetCore work with classic ASP.NET?',
    a: "WeAmp.PageSpeed.AspNetCore is for ASP.NET Core. For classic ASP.NET / WebForms / MVC 5 on IIS, mod_pagespeed for IIS is the right path — it's an IIS module, no application code changes required.",
  },
  {
    q: 'Can I run both mod_pagespeed for IIS and the WeAmp.PageSpeed.AspNetCore package?',
    a: 'Yes. Both can run side by side, each configured its own way: pagespeed.config directives on IIS, appsettings.json settings in ASP.NET Core.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'mod_pagespeed for IIS',
    applicationCategory: 'DeveloperApplication',
    applicationSubCategory: 'IIS module',
    operatingSystem: ['Windows'],
    description:
      'Native IIS module that continues the IISpeed lineage. Same web.config surface, plus security patches, current toolchain, and Cyclone Cache.',
    publisher: {
      '@type': 'Organization',
      name: 'We-Amp B.V.',
      url: 'https://we-amp.com/',
    },
    offers: offerJsonLd({ url: 'https://modpagespeed.com/pricing/' }),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'WeAmp.PageSpeed.AspNetCore (ASP.NET Core middleware)',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: ['Linux', 'macOS', 'Windows'],
    softwareRequirements: '.NET 8 or .NET 10',
    description:
      'ASP.NET Core middleware that runs inside your app: image optimization, CSS/JS minification and critical CSS, with no separate reverse proxy.',
    sameAs: 'https://www.nuget.org/packages/WeAmp.PageSpeed.AspNetCore',
    publisher: {
      '@type': 'Organization',
      name: 'We-Amp B.V.',
      url: 'https://we-amp.com/',
    },
    offers: offerJsonLd({ url: 'https://modpagespeed.com/pricing/' }),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((entry) => ({
      '@type': 'Question',
      name: entry.q,
      acceptedAnswer: { '@type': 'Answer', text: entry.a },
    })),
  },
];
---

<BaseLayout
  title="IISpeed successor: PageSpeed for IIS (2026)"
  description="IISpeed is deprecated. Its successor is the mod_pagespeed IIS module, with a free license transfer; ASP.NET Core apps use the AspNetCore NuGet package."
  jsonLd={jsonLd}
>
  <PageHero id="iispeed-title" width="prose" class="max-w-3xl" title="IISpeed alternative">
    <Fragment slot="lede">
      <p>
        IISpeed is deprecated because We-Amp consolidated two IIS code paths into one (mod_pagespeed
        1.15). Existing customers get a free license transfer. IISpeed was We-Amp's native IIS port
        of mod_pagespeed, first released in 2012 &mdash; image optimization, CSS/JS minification,
        and critical CSS injection on the IIS pipeline for Windows-hosted sites.
      </p>
    </Fragment>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href="/download/" class="btn-primary" data-umami-event="cta_alternatives_iispeed_install">
        Download &amp; run mod_pagespeed for IIS
      </a>
      <a
        href="/pricing/"
        class="rounded-md border border-border-strong px-4 py-2 text-sm font-medium text-text-body hover:border-border-strong"
        data-umami-event="cta_alternatives_iispeed_pricing"
      >
        Support pricing
      </a>
      <a
        href="/contact/?topic=iispeed-transfer"
        class="rounded-md border border-border-strong px-4 py-2 text-sm font-medium text-text-body hover:border-border-strong"
      >
        Transfer my IISpeed license
      </a>
    </div>
    <p class="mt-3 text-small text-text-annotation">{FREE_TO_RUN_LINE}</p>
  </PageHero>

  <article class="container-prose max-w-3xl pb-16">
    <div class="prose prose-stone max-w-none prose-headings:font-semibold prose-a:text-interactive dark:prose-invert">
      <p>
        IISpeed is now deprecated. Existing customers get a free license transfer to either
        mod_pagespeed (native IIS port) or to the WeAmp.PageSpeed.AspNetCore NuGet package for
        ASP.NET Core. Existing installations keep working with ongoing support, but IISpeed itself
        no longer receives updates: its IIS integration lives on in the mod_pagespeed IIS module.
      </p>
      <p>This page explains both forward paths.</p>

      <h2>What IISpeed was</h2>
      <p>
        IISpeed wrapped the mod_pagespeed optimization libraries in an IIS module (
        <code>IISpeedModule.dll</code>) that registered against the IIS request pipeline.
        Configuration sat in <code>web.config</code> under <code>&lt;system.webServer&gt;</code>.
        Filters, variants, and the admin console all worked the same way as the Apache and nginx
        ports.
      </p>
      <p>
        Customers ran it on Windows Server 2008 R2 through 2019. The IIS module ABI stayed
        compatible across those releases.
      </p>

      <h2>Why it's deprecated</h2>
      <ul>
        <li>
          The .NET 4 and IIS 7-era toolchain is increasingly painful to build and test against
          modern Windows.
        </li>
        <li>
          The current image pipeline (WebP variants), Core Web Vitals signals, and the newer variant
          fan-out never landed in the IISpeed build.
        </li>
        <li>
          Customer demand consolidated on either drop-in IIS replacements (where 1.15 fits) or on
          ASP.NET Core (where the WeAmp.PageSpeed.AspNetCore NuGet package fits).
        </li>
        <li>
          One IIS code path is better than two. The IIS port now lives inside
          <code>mod_pagespeed</code>, shared with the Apache and nginx ports.
        </li>
      </ul>

      <h2>Path 1 &mdash; mod_pagespeed for IIS</h2>
      <p>
        If you have an IIS deployment and want a drop-in replacement, mod_pagespeed for IIS is a
        native IIS port with the same module surface IISpeed offered. Same <code>web.config</code>
        syntax, a modernized, secured filter stack with new optimizers, same admin console &mdash;
        plus security patches, current toolchain, and Cyclone Cache.
      </p>

      <pre><code>{`<!-- web.config -->
<system.webServer>
  <modules>
    <add name="ModPagespeedModule" type="ModPagespeed.IIS.Module, ModPagespeed.IIS" />
  </modules>
  <pagespeed enabled="true">
    <fileCachePath>C:\\inetpub\\modpagespeed\\cache</fileCachePath>
  </pagespeed>
</system.webServer>`}</code></pre>

      <p>
        The MSI installer from the
        <a href="/download/">downloads page</a> registers the module, creates the cache directory,
        and warm-starts the worker.
      </p>

      <p>
        <a href="/docs/">mod_pagespeed docs</a> &middot;
        <a href="/mod-pagespeed-still-maintained/">IIS migration guide</a> &middot;
        <a href="/download/">Download the MSI</a>
      </p>

      <h2>Path 2 &mdash; WeAmp.PageSpeed.AspNetCore NuGet package for ASP.NET Core</h2>
      <p>
        If your stack is ASP.NET Core, IIS is no longer the natural integration point. The
        <code>WeAmp.PageSpeed.AspNetCore</code> NuGet package is ASP.NET Core middleware: it runs
        inside your app's request pipeline, with no separate reverse proxy:
      </p>

      <pre><code>{`// Program.cs
using WeAmp.PageSpeed.AspNetCore;

var builder = WebApplication.CreateBuilder(args);
builder.Services.AddPageSpeed();

var app = builder.Build();
app.UsePageSpeed();
app.Run();`}</code></pre>

      <pre><code><NugetCmd /></code></pre>

      <p>
        No IIS module registration, no <code>web.config</code> editing, no <code>gacutil</code>. It
        targets .NET 8 and .NET 10 on Linux (x64, arm64), macOS (Apple Silicon) and Windows (x64).
      </p>

      <p>
        <a href="/blog/aspnet-core-middleware/">How the integration works</a> &middot;
        <a href="/go/nuget/?pkg=aspnetcore&from=alternatives-iispeed-inline">NuGet package</a>
      </p>

      <h2>Which path fits</h2>
      <table>
        <thead>
          <tr>
            <th>Use case</th>
            <th>Choose</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Classic ASP.NET / WebForms / MVC 5 on IIS</td>
            <td>mod_pagespeed for IIS</td>
          </tr>
          <tr>
            <td>Existing IISpeed install you want to keep running with security patches</td>
            <td>mod_pagespeed for IIS</td>
          </tr>
          <tr>
            <td>ASP.NET Core (.NET 8 or 10) on Kestrel</td>
            <td>WeAmp.PageSpeed.AspNetCore NuGet package</td>
          </tr>
          <tr>
            <td>Linux container deployment of an ASP.NET Core app</td>
            <td>WeAmp.PageSpeed.AspNetCore NuGet package</td>
          </tr>
          <tr>
            <td>ASP.NET Core hosted on Windows / IIS</td>
            <td>
              WeAmp.PageSpeed.AspNetCore NuGet package (it runs on Windows x64), or mod_pagespeed
              for IIS
            </td>
          </tr>
          <tr>
            <td>Mixed environment (some sites on classic IIS, some on .NET Core)</td>
            <td>
              Run both side by side, each configured its own way (pagespeed.config on IIS,
              appsettings.json in ASP.NET Core)
            </td>
          </tr>
        </tbody>
      </table>

      <h2>License transfer</h2>
      <p>
        If you hold an IISpeed license, request the transfer through the
        <a href="/contact/?topic=iispeed-transfer">license-transfer form</a>, with your order number
        or the email address the license was bought under. The transfer is at no cost: paid terms
        are honored to expiry, and you keep your current rate when you move to a support
        subscription. No new license is needed; the software is free to install and run. Other
        questions go to <a href={`mailto:${COMMERCIAL_EMAIL}`}>{COMMERCIAL_EMAIL}</a>. The IISpeed
        transition is documented at
        <a href="https://iispeed.com/" rel="noopener noreferrer">
          iispeed.com
        </a>
        .
      </p>

      <h2>Frequently asked questions</h2>
      {faq.map((entry) => (
        <>
          <h3>{entry.q}</h3>
          <p>{entry.a}</p>
        </>
      ))}

      <h2>Install and run</h2>
      <p>
        Install either path and it optimizes right away. mod_pagespeed is {LICENSE_CLAUSE} &mdash;
        free in development and in production.
      </p>
      <p>The IIS package ships as a signed installer on the mod_pagespeed GitHub release.</p>
      <ul>
        <li>
          <strong>mod_pagespeed for IIS</strong> &mdash;
          <a href="/download/">Download the MSI</a> &middot; <a href="/pricing/">Support pricing</a>{' '}
          &middot;
          <a href="/docs/iis-configuration/">IIS docs</a>
        </li>
        <li>
          <strong>WeAmp.PageSpeed.AspNetCore NuGet package</strong> &mdash;
          <a href="/go/nuget/?pkg=aspnetcore&from=alternatives-iispeed-tryone">
            NuGet package
          </a>{' '}
          &middot;
          <a href="/docs/aspnet-getting-started/">ASP.NET Core docs</a>
        </li>
      </ul>

      <h2>Related</h2>
      <ul>
        <li>
          <a href="/alternatives/mod-pagespeed/">mod_pagespeed alternative</a>
        </li>
        <li>
          <a href="/alternatives/ngx-pagespeed/">ngx_pagespeed alternative</a>
        </li>
        <li>
          <a href="/alternatives/google-pagespeed-module/">Google PageSpeed Module alternative</a>
        </li>
        <li>
          <a href="/blog/mod-pagespeed-deprecated-2026/">
            Is mod_pagespeed deprecated? &mdash; what changed and what to use
          </a>
        </li>
        <li>
          <a href="https://iispeed.com/" rel="noopener noreferrer">
            iispeed.com
          </a>{' '}
          &mdash; transition information for existing customers
        </li>
        <li>
          <a href="https://iispeed.com/iis-core-web-vitals-2026/" rel="noopener noreferrer">
            IIS &amp; Core Web Vitals in 2026
          </a>
        </li>
      </ul>

      <p class="text-xs text-text-annotation">
        IIS, ASP.NET, Windows Server, and other product names are trademarks of their respective
        owners. mod_pagespeed is an open-source project originally developed at Google; its
        maintained continuation, the current mod_pagespeed, is developed by We-Amp B.V. Comparisons
        reflect publicly available information as of 2026 and are provided for evaluation; We-Amp
        B.V. is not affiliated with or endorsed by Microsoft Corporation or Google.
      </p>
    </div>
  </article>
</BaseLayout>
