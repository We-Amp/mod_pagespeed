---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import SectionHeader from '../../components/instrument/SectionHeader.astro';
import ScanBox from '../../components/scan/ScanBox.astro';
import ScanUiBoot from '../../components/scan/ScanUiBoot.astro';
import ResultsView from '../../components/scan/ResultsView.astro';
import NoscriptLead from '../../components/scan/NoscriptLead.astro';
import { ORGANIZATION_REF } from '../../data/organization';
import { LICENSE_CLAUSE } from '../../data/product-facts.mjs';

// Public front end for the AI-readability scanner (D10). The render backend
// runs on a separate box; nginx proxies /ai-readability/api/* to it.
// Local dev (page served from localhost): append ?api=http://localhost:8787 to point at a local render service.
const title = 'AI readability checker: can ChatGPT read your page? (free)';
const description =
  'Free check for one page: how much of it an AI crawler can read without running JavaScript. It does not measure whether AI answers mention you.';
const webApp = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'AI Readability Checker',
  alternateName: ['RenderPeek', 'AI crawler checker'],
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  url: 'https://modpagespeed.com/ai-readability/',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  description,
  publisher: ORGANIZATION_REF,
  featureList: [
    'Share of the page text that is in the HTML without running JavaScript',
    'Tokens of readable text in the raw HTML and after rendering',
    'Structured data found on the page, such as JSON-LD and Open Graph',
    'robots.txt rules for AI crawlers',
    'llms.txt detection',
    'A grade from A to F with a score out of 100',
  ],
};

// One array feeds both the visible FAQ below and the FAQPage JSON-LD, so the
// structured data and the on-page text cannot drift. Order: the questions
// people ask most come first.
const faqEntries = [
  {
    q: 'Can AI crawlers read JavaScript-rendered content?',
    a: 'Most do not, as far as published measurements show. A 2024 study of crawler traffic found that the crawlers of OpenAI, Anthropic and Perplexity fetch the HTML and do not run JavaScript, so content that appears only after your scripts run is invisible to them. Google is different: Gemini draws on pages that Googlebot fetches, and Googlebot does run JavaScript.',
  },
  {
    q: 'How do I check what an AI crawler sees on my page?',
    a: 'Turn off JavaScript in your browser and reload the page. What remains is roughly what a crawler that does not run scripts reads. Or paste your URL into the checker on this page: it shows how many tokens of readable text are in the raw HTML and how many appear after JavaScript runs.',
  },
  {
    q: 'How do I make my page readable to AI crawlers?',
    a: 'Put the content that matters in the HTML the server sends, through server-side rendering or pre-rendering, so it does not depend on JavaScript. Then run the check again.',
  },
  {
    q: 'Does this show whether ChatGPT mentions or cites my site?',
    a: 'No. It checks one page: how much of its text is in the HTML a crawler receives without running JavaScript, and how clearly the page describes itself to machines through structured data, robots.txt rules for AI crawlers and llms.txt. It does not ask ChatGPT or any other assistant a question, so it cannot tell you whether they mention you.',
  },
  {
    q: 'What are AEO and GEO, and where does this check fit?',
    a: 'AEO (answer engine optimization) and GEO (generative engine optimization) are names for the work of getting a site cited in AI answers. This check covers the technical precondition: that an AI crawler can read the page at all. The rest depends on things this check does not measure, such as what the page says.',
  },
  {
    q: 'Will a better grade get me into AI answers?',
    a: 'Not by itself. A crawler has to be able to read a page before an assistant can use it, so readable HTML is necessary. It is not sufficient: the assistant decides which pages it cites, and this tool does not measure that.',
  },
  {
    q: 'How do I see whether AI crawlers are blocked on my site?',
    a: 'Your robots.txt file can allow or block each crawler by name. The scan reads it and lists the AI crawlers it blocks by name, such as GPTBot or ClaudeBot. Some crawlers collect pages to train models and others fetch a page when a person asks an assistant a question. They use different names, and some of the second kind state that they may not follow robots.txt.',
  },
  {
    q: 'Does llms.txt make my site AI-readable?',
    a: 'No. llms.txt is an optional hint file. It does not fix content that is invisible because it needs JavaScript to render: readability still depends on the content being in the HTML the crawler fetches. The scan reports when a site has one.',
  },
  {
    q: 'Does it work for Wix, Squarespace or Shopify sites?',
    a: 'Yes. The check works for any public page, whatever it runs on. On a hosted builder you make the fixes in the builder’s settings and in your content. Server software such as mod_pagespeed cannot be installed there.',
  },
  {
    q: 'Who is mod_pagespeed for?',
    a: `For sites that run their own web server, such as Apache, nginx or IIS. mod_pagespeed is free software, ${LICENSE_CLAUSE}, that optimizes the pages and images the server sends. A site on a hosted builder cannot install it.`,
  },
];
const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqEntries.map((entry) => ({
    '@type': 'Question',
    name: entry.q,
    acceptedAnswer: { '@type': 'Answer', text: entry.a },
  })),
};

// Per-bot rendering matrix shown in the visible table. The three non-Google
// rows rest on a 2024 study of crawler traffic, not on vendor documentation;
// Google documents that Googlebot renders JavaScript.
const botRendering = [
  { bot: 'GPTBot', agent: 'OpenAI', rendersJs: false },
  { bot: 'ClaudeBot', agent: 'Anthropic', rendersJs: false },
  { bot: 'PerplexityBot', agent: 'Perplexity', rendersJs: false },
  { bot: 'Googlebot', agent: 'Google', rendersJs: true },
];

const jsonLd = [webApp, faqPage];
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  breadcrumbLeafName="AI readability checker"
  ogImage="/og-cards/ai-readability.png"
>
  <section
    class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 pt-16 sm:pt-20"
    aria-labelledby="airead-title"
  >
    <SectionHeader
      id="airead-title"
      eyebrow="AI readability checker · a free tool"
      title="Can AI crawlers read your page?"
      as="h1"
      titleClass="text-3xl sm:text-4xl font-bold tracking-tight text-balance"
    >
      A free technical check for AEO and GEO: what ChatGPT, Claude and Perplexity get from your
      HTML.
    </SectionHeader>

    <ScanUiBoot />
    <div data-scan-variant="v1">
      <!-- novalidate: the input is type=url for the mobile URL keyboard, but we accept a
         bare host (e.g. "example.com") and prepend https:// in normalizeUrl(), so we
         let the JS validator govern rather than the browser's scheme-required check. -->
      <form id="ar-form" class="mt-8 flex flex-col sm:flex-row gap-3" autocomplete="off" novalidate>
        <input
          id="ar-url"
          type="url"
          inputmode="url"
          autocomplete="url"
          spellcheck="false"
          autocapitalize="off"
          placeholder="example.com"
          aria-label="URL to scan"
          class="flex-1 rounded-lg border border-control-border bg-bg-elevated px-4 py-3 text-base text-text-body placeholder:text-text-annotation focus:border-interactive focus:ring-2 focus:ring-interactive"
        />
        <button
          id="ar-go"
          type="submit"
          class="btn-primary px-8 w-full sm:w-auto aria-disabled:opacity-50 aria-disabled:cursor-wait"
        >
          Scan
        </button>
      </form>
      <p class="mt-3 text-sm text-text-annotation">
        Free &middot; no signup &middot; one page at a time &middot; renders your page in a headless
        browser (~5&ndash;10s).
      </p>

      <p class="mt-3 text-xs text-text-annotation leading-relaxed max-w-2xl">
        Only scan sites you own or are authorized to test. Results and the share link are kept for
        at most 24 hours. If you send the form, we keep your email and a summary of the result. Your
        IP address is logged and rate-limited to 20 requests per minute per visitor to prevent
        abuse. See our
        <a
          href="https://we-amp.com/privacy/"
          class="text-interactive hover:text-interactive-hover underline"
        >
          Privacy policy
        </a>
        .
      </p>
    </div>
    <div data-scan-variant="v2" data-pagefind-ignore>
      <ScanBox surface="airead" />
    </div>

    <p class="mt-10 max-w-2xl text-sm text-text-muted leading-relaxed" data-airead-audience>
      This tool checks one page: how much of its text an AI crawler can read without running
      JavaScript, and how clearly the page describes itself to machines. It does not measure whether
      ChatGPT, Perplexity or Google mention your site in their answers. The check works for any
      site, whatever it runs on. Most of the fixes we offer need a web server you run yourself (such
      as Apache, nginx or IIS); on a hosted builder such as Wix, Squarespace or Shopify, what you
      can change is in the builder's settings.
    </p>

    <p class="mt-4 max-w-2xl text-sm text-text-muted leading-relaxed">
      As far as published measurements show, most AI crawlers read your raw HTML and do not run your
      JavaScript, so anything your scripts render is invisible to them. Paste a URL above to see the
      gap. The same self-hosted mod_pagespeed worker that powers this site then optimizes and cleans
      that HTML inline, on your own servers rather than behind a CDN. The optimizer worker can also
      serve AI agents a Markdown version of a page at the same URL. That is an
      <a
        href="/blog/serve-markdown-to-ai-agents/"
        class="text-interactive underline underline-offset-2"
      >
        experimental feature
      </a>
      and is off by default. This site's docs and blog posts are also served as Markdown at a
      <code>.md</code> address.
    </p>

    <!-- prettier-ignore -->
    <p class="mt-4 text-sm text-text-annotation">
      From <a href="/about/" class="text-interactive underline underline-offset-2">We-Amp</a>,
      who helped build ngx_pagespeed.
    </p>
  </section>

  <NoscriptLead topic="agents" />

  <!-- The shared results sit outside the narrow reading column so they get the
       full tool width; the v1 result slot and everything below stay in it. -->
  <div data-scan-variant="v2" data-pagefind-ignore class="[&_.scan-results]:mt-20">
    <ResultsView />
  </div>

  <section class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 pb-16 sm:pb-20">
    <div data-scan-variant="v1">
      <div id="ar-out" aria-live="polite"></div>
    </div>

    <!-- No-JS fallback (UX-9). The live scan is interactive, but the page should not
         be blank for crawlers and no-JS visitors. This is a static, illustrative sample
         result (not a live measurement) so the page is self-explanatory without scripts. -->
    <noscript>
      <div class="mt-6 rounded-2xl border border-border bg-bg-elevated p-6">
        <p class="text-sm font-semibold text-text-body">Live scanning needs JavaScript</p>
        <p class="mt-1 text-sm text-text-annotation leading-relaxed">
          Enable JavaScript to scan a URL. Here is an example of the kind of result the check
          produces. It is an illustrative sample, not a live measurement:
        </p>
        <div class="mt-5 flex items-center gap-4">
          <div class="flex h-16 w-16 items-center justify-center rounded-xl border-2 border-accent text-3xl font-bold text-accent">
            C
          </div>
          <div>
            <div class="text-xl font-bold text-text-body">58/100</div>
            <div class="text-xs text-text-annotation">example.com</div>
          </div>
        </div>
        <dl class="mt-5 space-y-3 text-sm">
          <div class="flex justify-between font-medium text-text-body">
            <dt>
              Content fidelity
              <span class="ml-1 badge-accent">invisible without JS</span>
            </dt>
            <dd class="tabular-nums">2/30</dd>
          </div>
          <div class="flex justify-between font-medium text-text-body">
            <dt>Token efficiency</dt>
            <dd class="tabular-nums">12/20</dd>
          </div>
          <div class="flex justify-between font-medium text-text-body">
            <dt>Structured data</dt>
            <dd class="tabular-nums">18/20</dd>
          </div>
          <div class="flex justify-between font-medium text-text-body">
            <dt>Crawler access</dt>
            <dd class="tabular-nums">18/20</dd>
          </div>
          <div class="flex justify-between font-medium text-text-body">
            <dt>Citation readiness</dt>
            <dd class="tabular-nums">8/10</dd>
          </div>
        </dl>
        <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2">
          <div class="rounded-lg border border-border bg-bg-secondary p-3">
            <p class="text-xs font-semibold text-text-body">Raw HTML: what most AI crawlers read</p>
            <p class="mt-1 text-xs text-text-annotation">
              ~80 tokens an agent can read. Almost nothing is there before JavaScript runs.
            </p>
          </div>
          <div class="rounded-lg border border-border bg-bg-secondary p-3">
            <p class="text-xs font-semibold text-text-body">After rendering JavaScript</p>
            <p class="mt-1 text-xs text-text-annotation">
              ~1,400 tokens an agent can read. The real content appears only once the browser runs
              your scripts.
            </p>
          </div>
        </div>
      </div>
    </noscript>

    <!-- Direct answer to the "can AI crawlers execute JavaScript" query, from the
         top-1,000 study on /blog/can-ai-read-your-website/ (numbers as published
         there). -->
    <div class="mt-14 max-w-2xl">
      <h2 class="text-xl font-semibold text-text-body">Can AI crawlers execute JavaScript?</h2>
      <p class="mt-2 text-sm text-text-annotation leading-relaxed">
        Most do not, as far as published measurements show. A 2024 study of crawler traffic found
        that the crawlers of OpenAI, Anthropic and Perplexity fetched HTML without running the
        scripts in it. Googlebot does run JavaScript, and Gemini draws on the pages it fetches. When
        we rendered the top 1,000 sites on 28 May 2026, 403 of them showed a non-rendering agent a
        nearly empty page, with content that appeared only after JavaScript ran: that is 40% of all
        1,000 sites, and 57% of the 711 we could read at all, because the other 289 returned little
        even after rendering. Read
        <a
          href="/blog/can-ai-read-your-website/"
          class="text-interactive underline underline-offset-2"
        >
          the full results
        </a>
        .
      </p>
    </div>

    <!-- Per-bot rendering matrix: the measured behavior of three AI crawlers and
         the documented behavior of Googlebot. -->
    <div class="mt-14 max-w-2xl">
      <h2 class="text-xl font-semibold text-text-body">Which AI crawlers render JavaScript?</h2>
      <p class="mt-2 text-sm text-text-annotation leading-relaxed">
        The table lists what is known for four crawlers. For the first three it rests on a 2024
        study of crawler traffic, because their operators do not document whether they run
        JavaScript. Google documents that Googlebot does. Crawler behavior can change, so scan your
        page again to see what a crawler that does not run scripts reads now. We measured the same
        rendering gap across the top 1,000 sites: see
        <a
          href="/blog/can-ai-read-your-website/"
          class="text-interactive underline underline-offset-2"
        >
          what we found
        </a>
        .
      </p>
      <div class="mt-5 overflow-hidden rounded-2xl border border-border">
        <table class="w-full text-left text-sm">
          <thead class="bg-bg-secondary">
            <tr>
              <th scope="col" class="px-4 py-3 font-semibold text-text-body">
                Crawler
              </th>
              <th scope="col" class="px-4 py-3 font-semibold text-text-body">
                Operated by
              </th>
              <th scope="col" class="px-4 py-3 font-semibold text-text-body">
                Renders JavaScript?
              </th>
            </tr>
          </thead>
          <tbody>
            {botRendering.map((row) => (
              <tr class="border-t border-border">
                <td class="px-4 py-3 font-medium text-text-body">{row.bot}</td>
                <td class="px-4 py-3 text-text-muted">{row.agent}</td>
                <td class="px-4 py-3">
                  {row.rendersJs ? (
                    <span class="font-medium text-success">Yes, documented by Google</span>
                  ) : (
                    <span class="font-medium text-text-annotation">No, in the 2024 study</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Visible FAQ rendering the same faqPage.mainEntity array emitted as
         FAQPage JSON-LD (single source of truth). Native <details>/<summary>
         accordion; the disclosure marker is hidden via the scoped <style> below. -->
    <div class="mt-14 max-w-2xl">
      <h2 class="text-xl font-semibold text-text-body">Frequently asked questions</h2>
      <div class="mt-6 space-y-3">
        {faqEntries.map((item) => (
          <details class="group rounded-2xl border border-border bg-bg-elevated">
            <summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-4 text-sm font-semibold text-text-body">
              {item.q}
              <Icon
                name="chevron-down"
                class="h-5 w-5 shrink-0 text-text-annotation group-open:rotate-180"
              />
            </summary>
            <p class="px-5 pb-5 text-sm text-text-annotation leading-relaxed">{item.a}</p>
          </details>
        ))}
      </div>
      <p class="mt-6 text-sm text-text-muted leading-relaxed">
        Two related free tools: the
        <a href="/ai-crawler-cost/" class="text-interactive underline underline-offset-2">
          AI crawler cost meter
        </a>
        reads your access log and reports what each AI crawler requested, and the
        <a href="/analyze/" class="text-interactive underline underline-offset-2">
          PageSpeed Insights test
        </a>
        maps each failing audit to the mod_pagespeed filter that fixes it, or labels it when none
        can.
      </p>
      <p class="mt-3 text-sm text-text-muted">
        Docs:{' '}
        <a href="/docs/agent-optimize/" class="text-interactive underline">
          Serve Markdown to AI agents
        </a>
        ,{' '}
        <a href="/docs/web-bot-auth/" class="text-interactive underline">
          Verify AI crawlers with Web Bot Auth
        </a>{' '}
        and{' '}
        <a href="/docs/rsl-cap/" class="text-interactive underline">
          Validate RSL license capability tokens
        </a>
        .
      </p>
    </div>
  </section>

  <!-- Scoped: hide the native disclosure marker on the FAQ <details> so the
       custom chevron (rotated via group-open) is the only affordance. -->
  <style>
    details > summary {
      list-style: none;
    }
    details > summary::-webkit-details-marker {
      display: none;
    }
  </style>

  <!-- is:global — the scan result is injected via innerHTML at runtime, so it lacks
       Astro's scoped-style attribute; scoped CSS would not reach it. All selectors are
       .ar-* namespaced, so global scope does not affect the rest of the site. The
       runtime-injected card also can't rely on Tailwind utility classes (the build would
       purge any class string that only ever appears inside a JS string literal), so the
       result UI is styled here against the site's semantic tokens (--color-bg-*,
       --color-text-*, --color-interactive, --color-success, --color-accent) so it
       follows the light/dark theme and reads as a first-class property. -->
  <style is:global>
    /* Reserve the result area while a scan runs: a real scan takes 5–10 s,
       so the loading → result swap falls outside the CLS input-exclusion
       window. Pushing the content below out of view at click time is
       input-excluded; the later swap then shifts nothing visible. A failed
       scan keeps the reservation (data-hold) until the visitor edits the
       URL, so the small error card doesn't pull the content below back up
       mid-read; that release follows a keystroke, so it is also excluded. */
    #ar-out[aria-busy='true'] {
      min-block-size: 100svh;
    }
    /* After a failed scan the hold shrinks to the fold (--ar-hold, set by
       holdToFold), so no blank space is left below it. */
    #ar-out[data-hold] {
      min-block-size: var(--ar-hold, 100svh);
    }
    .ar-card {
      /* Custom props consumed by the lens evidence list + Ghost-Layer block
         below (border hairline + dimmed selector text). */
      --ar-border: var(--color-border);
      --dim: var(--color-text-annotation);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-card);
      background: var(--color-bg-elevated);
      padding: 1.4rem;
      margin-top: 1.4rem;
      color: var(--color-text-body);
    }
    .ar-card:focus {
      outline: none;
    }
    /* Section primitive — one divider rhythm. 1px section-top = "new
       section"; rows within a section use hairline/none. */
    .ar-sec {
      margin-top: 1.4rem;
      padding-top: 1.3rem;
      border-top: 1px solid var(--color-border);
    }
    .ar-h2 {
      margin: 0 0 0.2rem;
      font-size: 1.35rem;
      font-weight: 700;
      letter-spacing: -0.01em;
    }
    .ar-h4 {
      margin: 0 0 0.2rem;
      font-size: 0.92rem;
      font-weight: 700;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 0.5rem;
    }
    .ar-h4-l {
      display: inline-flex;
      align-items: baseline;
      gap: 0.4rem;
      flex-wrap: wrap;
    }
    .ar-h4-r {
      color: var(--color-text-annotation);
      font-size: 0.78rem;
      font-weight: 600;
      white-space: nowrap;
    }
    .ar-sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
      border: 0;
    }
    /* Impact pills — squared chips. The printed level word carries the
       severity (never color alone); the token set has one caution hue, so
       critical/serious/moderate share the accent tone and minor is neutral. */
    .ar-impacts {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      margin: 0.5rem 0 0.1rem;
    }
    .ar-pill {
      display: inline-block;
      border-radius: var(--radius-chip);
      padding: 0.05rem 0.45rem;
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.02em;
      line-height: 1.4;
    }
    .ar-pill-critical,
    .ar-pill-serious,
    .ar-pill-moderate {
      background: var(--color-accent-wash);
      color: var(--color-accent);
    }
    .ar-pill-minor {
      background: var(--color-bg-secondary);
      color: var(--color-text-muted);
    }
    /* "addressable inline" tag — NON-completion (interactive, never success). */
    .ar-fix {
      display: inline-block;
      font-size: 0.66rem;
      font-weight: 600;
      border-radius: var(--radius-chip);
      padding: 0.02rem 0.4rem;
      color: var(--color-interactive);
      background: color-mix(in srgb, var(--color-interactive) 8%, transparent);
      border: 1px solid color-mix(in srgb, var(--color-interactive) 40%, transparent);
    }
    /* Itemized accessibility issue list. */
    .ar-issues {
      list-style: none;
      margin: 0.5rem 0 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .ar-issue {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.4rem 0.55rem;
      font-size: 0.85rem;
    }
    .ar-issue-help {
      color: var(--color-text-muted);
      flex: 1 1 14rem;
    }
    .ar-issue-n {
      color: var(--color-text-muted);
      font-size: 0.72rem;
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
    }
    .ar-issue-id {
      font:
        0.7rem ui-monospace,
        Menlo,
        monospace;
      color: var(--color-text-muted);
    }
    /* Crawler chips + raw-HTML exposure meter. */
    .ar-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      margin: 0.5rem 0 0.3rem;
    }
    .ar-chip {
      font-size: 0.72rem;
      border-radius: var(--radius-chip);
      padding: 0.05rem 0.5rem;
      background: var(--color-bg-secondary);
      color: var(--color-text-muted);
      border: 1px solid var(--color-border);
    }
    .ar-chip-block {
      background: var(--color-accent-wash);
      color: var(--color-accent);
      border-color: color-mix(in srgb, var(--color-accent) 35%, transparent);
    }
