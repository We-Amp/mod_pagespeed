          'The no-JavaScript fetch was refused, so only the rendered page was checked. ' +
          'Not measured: whether the ' +
          names.join(', ') +
          ' in the served HTML match the page after JavaScript.'
        );
      }
      function sdVerdict(sd) {
        if (sd.verdict === 'unknown')
          return sdPartialText(sd)
            ? 'The no-JavaScript fetch was refused, so only the rendered page was checked and it showed no defect; the comparison with the served HTML did not run.'
            : 'We could not render this page, so we could not check its head.';
        if (sd.verdict === 'clean' && sd.staticCompared === false)
          return 'No defects found on the rendered page; the comparison with the served HTML did not run. One page only; not a ranking assessment.';
        if (sd.verdict === 'clean')
          return 'No defects found: the canonical, title, meta description, hreflang and structured data in the served HTML match the page after JavaScript. One page only; not a ranking assessment.';
        return (
          sd.counts.total +
          ' issue(s): ' +
          sdFiredGroups(sd)
            .map((g) => g[1] + ' ' + sd.counts[g[0]])
            .join(', ') +
          '. ' +
          sdServedBy(sd) +
          ' One page only; not a ranking assessment.'
        );
      }
      function sdBlock(sd) {
        if (!sd || sd.status === 'disabled') return '';
        if (sd.status !== 'ok') {
          const why =
            typeof sd.note === 'string' && sd.note.trim()
              ? sd.note.trim()
              : 'Not measured: the site blocked the scanner.';
          return (
            '<div class="ar-lens">' +
            '<h4 class="ar-h4"><span class="ar-h4-l">SEO defects ' +
            NS_BADGE +
            '</span><span class="ar-h4-r">not measured</span></h4>' +
            '<p class="ar-def">' +
            esc(why) +
            '</p></div>'
          );
        }
        const label =
          sd.verdict === 'attention' ? 'attention' : sd.verdict === 'clean' ? 'clean' : 'unknown';
        const fired = sd.verdict === 'attention' ? sdFiredGroups(sd) : [];
        const chips = fired.length
          ? '<div class="ar-chips">' +
            fired
              .map(
                (g) =>
                  '<span class="ar-chip ar-chip-block">' +
                  esc(g[1]) +
                  ' · ' +
                  esc(String(sd.counts[g[0]])) +
                  '</span>',
              )
              .join('') +
            '</div>'
          : '';
        const partial = sdPartialText(sd);
        return (
          '<div class="ar-lens' +
          (sd.verdict === 'attention' ? ' ar-finding' : '') +
          '">' +
          '<h4 class="ar-h4"><span class="ar-h4-l">SEO defects ' +
          NS_BADGE +
          '</span><span class="ar-h4-r">' +
          label +
          '</span></h4>' +
          '<div class="ar-v">' +
          esc(sdVerdict(sd)) +
          '</div>' +
          chips +
          (partial ? '<p class="ar-def">' + esc(partial) + '</p>' : '') +
          '</div>'
        );
      }

      // Hidden-layer lens (NON-SCORED): human-invisible-but-agent-readable
      // content found on the owner's OWN page. Reports observations to the owner; it
      // never asserts a "safe/screened" status. Technique chips + per-node evidence
      // list + the full-page screenshot with overlay boxes (emitted only when actually
      // detected, see wireGhostOverlay). KEEP IN SYNC with the scanner.
      function ghostBlock(gl) {
        if (!gl) return '';
        const techs = Object.entries(gl.byTechnique || {})
          .map((entry) => {
            const t = entry[0],
              n = entry[1];
            const node = (gl.nodes || []).find((x) => x.technique === t) || {};
            return '<span class="ar-chip">' + esc(node.label || t) + ' ×' + n + '</span>';
          })
          .join('');
        const list = (gl.nodes || [])
          .slice(0, 40)
          .map(
            (nd) =>
              '<div class="ar-gnode"><b>' +
              esc(nd.label) +
              '</b>' +
              (nd.gloss ? '<div class="ar-v">' + esc(nd.gloss) + '</div>' : '') +
              (nd.selector ? '<div class="ar-gsel">' + esc(nd.selector) + '</div>' : '') +
              '</div>',
          )
          .join('');
        // Nodes with a real on-screen rectangle can be boxed on the screenshot; some
        // findings live only in the text/accessibility layer and have no box.
        const boxed = (gl.nodes || []).filter(
          (nd) => nd.rect && nd.rect.width > 0 && nd.rect.height > 0,
        );
        // Only emit the (large, base64) screenshot when something was actually detected —
        // the clean/none state stays light.
        const shot = gl.screenshot
          ? '<div class="ar-shotwrap" id="ar-ghostshot-wrap"><img id="ar-ghostshot" src="' +
            esc(gl.screenshot) +
            '" alt="full-page render of the scanned page" /></div>'
          : '';
        return (
          '<div class="ar-lens' +
          (gl.detected ? ' ar-finding' : '') +
          '">' +
          '<h4 class="ar-h4"><span class="ar-h4-l">Ghost Layer — hidden-but-agent-readable content ' +
          NS_BADGE +
          '</span><span class="ar-h4-r">' +
          (gl.detected ? gl.count + ' found' : 'none') +
          '</span></h4>' +
          '<div class="ar-v">' +
          esc(gl.verdict) +
          '</div>' +
          (techs ? '<div class="ar-chips">' + techs + '</div>' : '') +
          (gl.detected ? shot : '') +
          (gl.detected && gl.screenshot && boxed.length
            ? '<p class="ar-shotnote">Full-page render — scroll within the frame to see every highlighted node.</p>'
            : '') +
          (gl.detected && !boxed.length
            ? '<p class="ar-shotnote">These findings live in the text or accessibility layer and have no on-screen box to highlight.</p>'
            : '') +
          (gl.detected ? '<div class="ar-glist">' + list + '</div>' : '') +
          '</div>'
        );
      }

      // After the ghost panel is in the DOM, position the overlay boxes once the screenshot
      // <img> has loaded and we know its rendered size (to scale page coords → displayed px).
      // No-ops unless the report actually detected ghost nodes and carries a screenshot, so the
      // clean/none state pays nothing. rect coords are CSS px; the screenshot is device px, hence
      // the dpr factor before the display scale.
      function wireGhostOverlay(gl) {
        // Drop any prior scan's resize handler first — render() is SPA-like (each scan
        // replaces out.innerHTML without a reload), so without this a stale closure per
        // scan would leak, pinning the previous scan's detached screenshot in memory.
        if (window.__arGhostDraw) {
          window.removeEventListener('resize', window.__arGhostDraw);
          window.__arGhostDraw = null;
        }
        if (!gl || !gl.detected || !gl.screenshot) return;
        const img = document.getElementById('ar-ghostshot');
        const wrap = document.getElementById('ar-ghostshot-wrap');
        if (!img || !wrap) return;
        const draw = () => {
          wrap.querySelectorAll('.ar-gbox').forEach((b) => b.remove());
          const natW = img.naturalWidth || 1;
          const scale = img.clientWidth / natW; // displayed px per natural (device) px
          const dpr = (gl.viewport && gl.viewport.dpr) || 1; // page CSS px → device px
          for (const nd of gl.nodes || []) {
            const rr = nd.rect;
            if (!rr || !rr.width || !rr.height) continue;
            const box = document.createElement('div');
            box.className = 'ar-gbox';
            box.style.left = rr.x * dpr * scale + 'px';
            box.style.top = rr.y * dpr * scale + 'px';
            box.style.width = Math.max(3, rr.width * dpr * scale) + 'px';
            box.style.height = Math.max(3, rr.height * dpr * scale) + 'px';
            box.title = nd.gloss ? nd.label + ' — ' + nd.gloss : nd.label;
            wrap.appendChild(box);
          }
        };
        if (img.complete && img.naturalWidth) draw();
        else img.addEventListener('load', draw, { once: true });
        // Exactly one live resize handler at a time (see the cleanup at the top).
        window.__arGhostDraw = draw;
        window.addEventListener('resize', window.__arGhostDraw);
      }

      // Section 4 — product paragraph + the ONE filled primary CTA + the two text links,
      // the wedge CONTEXT block(s) (copy only, no form), the ONE consolidated contact form
      // (single email + optional note [+ topic radios when both wedges fire]; wedge leads
      // only), and the legal disclosure. wireNext() runs after. When no wedge fires there
      // is no form: keeping the result is the share section's copy-link control.
      function nextStep(r, primaryWedge, firedWedges) {
        const av = r.agentVerifiability;
        const ax = r.accessibility;
        const sa = r.signedAgentVerification;
        const bothWedges = firedWedges.length >= 2;
        const product =
          '<p class="ar-v">mod_pagespeed optimizes your pages and cuts page weight on your own servers, off any CDN — lighter markup is faster for people and easier for machines to parse.</p>' +
          '<a class="ar-cta-primary" href="/download/#install" data-umami-event="airead-cta-optimize">Download &amp; run — optimize your HTML on your own servers →</a>' +
          '<p class="ar-v">Free to install and run, in development and in production.</p>' +
          '<div class="ar-cta-row">' +
          '<a class="ar-cta-link" href="/pricing/" data-umami-event="airead-cta-buy">Support pricing →</a>' +
          '<a class="ar-cta-link" href="/contact/?topic=agent-optimize" data-umami-event="airead-cta-agentoptimize">Questions about how AI agents read your site? Tell us →</a>' +
          '<a class="ar-cta-link" href="/blog/can-ai-read-your-website/" data-umami-event="airead-cta-blog">See how the top 1,000 sites scored &rarr;</a>' +
          '<a class="ar-cta-link" href="/ai-crawler-cost/" data-umami-event="airead-cta-crawler-cost">Estimate what AI crawlers cost your server and how many visits AI assistants send back. Drop an access log; nothing from it leaves your browser. &rarr;</a>' +
          '</div>';
        // Wedge CONTEXT — copy only, restates the earned reason above the single form.
        // When ≥2 wedges fire (the worst case for card height), the per-wedge reason
        // sentences collapse into ONE paragraph instead of stacking full ar-wedge-ctx
        // blocks (D.9). Each fired wedge contributes one factual sentence.
        const reasons = [];
        if (firedWedges.indexOf('tollbooth') !== -1) {
          reasons.push(
            'About ' +
              av.detail.exposurePct +
              '% of your content is already in the raw HTML ' +
              av.detail.aiCrawlersAllowed.length +
              ' AI crawler(s) can read — but your origin can’t tell a real signed agent from an impostor.',
          );
        }
        if (firedWedges.indexOf('agentpass') !== -1) {
          reasons.push(
            sa.classification === 'verifying'
              ? 'Your origin responded differently to our validly-signed probe than to a corrupted signature — behaviour consistent with cryptographic verification.'
              : 'Your origin already treats signed-agent requests differently from unsigned ones.',
          );
        }
        if (firedWedges.indexOf('compliancefix') !== -1) {
          reasons.push(
            (ax.detail.fixableInline === 1
              ? '1 of these issues looks'
              : ax.detail.fixableInline + ' of these issues look') +
              ' like the kind a self-hosted optimizer can address server-side, on your own servers, with no app changes.',
          );
        }
        let ctx = '';
        if (bothWedges) {
          ctx =
            '<p class="ar-wedge-ctx">' +
            reasons.join(' ') +
            ' These are things we’re building and can’t sell yet; tell us which one you need.</p>';
        } else if (primaryWedge === 'tollbooth') {
          ctx =
            '<p class="ar-wedge-ctx">' +
            reasons[0] +
            ' We’re building origin-side controls and want operator input.</p>';
        } else if (primaryWedge === 'agentpass') {
          ctx =
            '<p class="ar-wedge-ctx">' +
            reasons[0] +
            ' Verifying signed AI agents at the origin is something we’re building — we want operator input.</p>';
        } else if (primaryWedge === 'compliancefix') {
          ctx =
            '<p class="ar-wedge-ctx">' +
            reasons[0] +
            ' Inline remediation isn’t something you can buy yet — we’re building it.</p>';
        }
        const wedgeActive = primaryWedge !== '';
        // Topic chooser only when ≥2 wedges fire. Default = the first fired wedge
        // (priority order: tollbooth > agentpass > compliancefix).
        const WEDGE_LABELS = {
          tollbooth: 'Origin controls (who reads / verifies)',
          agentpass: 'Signed-agent verification (prove which agent is which)',
          compliancefix: 'Accessibility remediation',
        };
        const chooser = bothWedges
          ? '<fieldset class="ar-radiogroup" role="radiogroup" aria-label="What’s most relevant?">' +
            '<legend>What’s most relevant?</legend>' +
            firedWedges
              .map(function (w, i) {
                return (
                  '<label><input type="radio" name="ar-topic" value="' +
                  w +
                  '"' +
                  (i === 0 ? ' checked' : '') +
                  ' /> ' +
                  WEDGE_LABELS[w] +
                  '</label>'
                );
              })
              .join('') +
            '</fieldset>'
          : '';
        // Optional note is collapsed by default (saves vertical space in the worst case);
        // wireNext() reveals it on first email focus. The [hidden] attribute keeps it out
        // of the layout AND the a11y tree until the visitor engages the form.
        const noteField = wedgeActive
          ? '<label id="ar-next-note-field" class="ar-field" hidden><span class="ar-field-label">Anything we should know? (crawl volume, EAA deadline, page count) — optional</span>' +
            '<input id="ar-next-note" type="text" autocomplete="off" /></label>'
          : '';
        // The form exists only when a wedge fires (wedge lead → /contact). With no
        // wedge there is nothing to submit: the old no-wedge form WAS the /notify
        // email path, replaced by the share section's copy-link control.
        const form = wedgeActive
          ? '<form id="ar-next-form" class="ar-next-form" data-wedge="' +
            (bothWedges ? '' : primaryWedge) +
            '">' +
            chooser +
            '<label class="ar-field"><span class="ar-field-label">Your email</span>' +
            '<input id="ar-next-email" type="email" autocomplete="email" required /></label>' +
            noteField +
            '<button type="submit" data-umami-event="airead-next-' +
            primaryWedge +
            '">Talk to us</button>' +
            '</form>' +
            // #ar-next-msg keeps its OWN explicit aria-live="polite": it is nested inside #ar-out
            // (which render() flips to aria-live="off" so the whole card isn't announced at once),
            // and per the ARIA live-region algorithm the nearest explicit setting governs — so the
            // confirmation still announces. The tabindex=-1 + .focus() in wireNext is belt-and-braces.
            '<div id="ar-next-msg" class="ar-next-msg" role="status" aria-live="polite" tabindex="-1"></div>'
          : '';
        // Per-request consent disclosure (Legal H5): applies only to the wedge lead
        // form, which posts to /contact. There is no form (and no disclosure) when
        // no wedge fires.
        const disclosure = wedgeActive
          ? '<p class="ar-disclosure">Submitting this sends us your email and a summary of this scan’s findings. ' +
            'We use them only for this request; see our <a href="https://we-amp.com/privacy/">privacy policy</a>.</p>'
          : '';
        return (
          '<h3 id="ar-h-next" class="ar-h3">What mod_pagespeed can do about it</h3>' +
          product +
          ctx +
          form +
          disclosure
        );
      }

      // Consent-enforcement card: renders only when the pre-consent lens observed tracker
      // requests before any interaction (consentEnforcementCtaApplies). Its own section
      // beside the consolidated next-step form; the lead posts wedge 'consent-enforcement'
      // with the lens signal (buildLeadPayload) to /contact, like the other wedge leads.
      function consentCard(r) {
        if (!consentEnforcementCtaApplies(r.preConsentLeak)) return '';
        return (
          '<section class="ar-sec" aria-labelledby="ar-h-consent">' +
          '<h3 id="ar-h-consent" class="ar-h3">Tags fire before consent</h3>' +
          '<p class="ar-v">With consent enforcement at the origin, third-party tags stay inert at the server until the consent cookie grants them.</p>' +
          '<div class="ar-cta-row">' +
          '<a class="ar-cta-link" href="/platform/consent/" data-umami-event="airead-cta-consent">Consent enforcement at the origin →</a>' +
          '</div>' +
          '<form id="ar-consent-form" class="ar-next-form" data-wedge="consent-enforcement">' +
          '<label class="ar-field"><span class="ar-field-label">Your email</span>' +
          '<input id="ar-consent-email" type="email" autocomplete="email" required /></label>' +
          '<button type="submit" data-umami-event="airead-next-consent-enforcement">Talk to us</button>' +
          '</form>' +
          // Same per-request disclosure as the next-step wedge form (it posts to /contact).
          '<p class="ar-disclosure">Submitting this sends us your email and a summary of this scan’s findings. ' +
          'We use them only for this request; see our <a href="https://we-amp.com/privacy/">privacy policy</a>.</p>' +
          // Own explicit aria-live for the same reason as #ar-next-msg (see nextStep).
          '<div id="ar-consent-msg" class="ar-next-msg" role="status" aria-live="polite" tabindex="-1"></div>' +
          '</section>'
        );
      }

      // Script-control card: renders when either script-inventory gate applies
      // (pageIntegrityCtaApplies / thirdPartyFreezeCtaApplies); each gate contributes its own
      // sentence and its own submit button. One form, one email; the button pressed picks
      // the wedge, and the lead carries the lens signal (buildLeadPayload) to /contact.
      // Copy mirrors the scanner's index.html verbatim — KEEP IN SYNC.
      function scriptCard(r) {
        const si = r.scriptInventory;
        const pi = pageIntegrityCtaApplies(si);
        const tf = thirdPartyFreezeCtaApplies(si);
        if (!pi && !tf) return '';
        const unpinned = tf ? si.totals.thirdPartyExternal - si.totals.thirdPartyWithIntegrity : 0;
        return (
          '<section class="ar-sec" aria-labelledby="ar-h-scripts">' +
          '<h3 id="ar-h-scripts" class="ar-h3">Scripts you do not control</h3>' +
          (pi
            ? '<p class="ar-v">PCI DSS 4.0 (requirement 6.4.3) asks payment pages to keep an inventory of the scripts they load and to authorise each one; requirement 11.6.1 asks for detection of unauthorised changes to those pages. If this is a payment page, those requirements may apply to you.</p>' +
              '<p class="ar-v">We are building a server module that keeps a list of approved scripts at your origin.</p>'
            : '') +
          (tf
            ? '<p class="ar-v">' +
              unpinned +
              ' third-party script(s) on this page load without an integrity hash, so their content can change upstream without notice. We are building a way to serve each one at a version you approved until you accept the update.</p>'
            : '') +
          '<div class="ar-cta-row">' +
          '<a class="ar-cta-link" href="/platform/" data-umami-event="airead-cta-page-integrity">Origin modules we are building →</a>' +
          '</div>' +
          '<p class="ar-v">Tell us what you run.</p>' +
          '<form id="ar-scripts-form" class="ar-next-form">' +
          '<label class="ar-field"><span class="ar-field-label">Your email</span>' +
          '<input id="ar-scripts-email" type="email" autocomplete="email" required /></label>' +
          (pi
            ? '<button type="submit" data-wedge="page-integrity" data-umami-event="airead-next-page-integrity">Talk to us about script control</button>'
            : '') +
          (tf
            ? '<button type="submit" data-wedge="third-party-freeze" data-umami-event="airead-next-third-party-freeze">Talk to us about pinning scripts</button>'
            : '') +
          '</form>' +
          // Same per-request disclosure as the other wedge forms (it posts to /contact).
          '<p class="ar-disclosure">Submitting this sends us your email and a summary of this scan’s findings. ' +
          'We use them only for this request; see our <a href="https://we-amp.com/privacy/">privacy policy</a>.</p>' +
          '<div id="ar-scripts-msg" class="ar-next-msg" role="status" aria-live="polite" tabindex="-1"></div>' +
          '</section>'
        );
      }

      // Edge-SEO card: renders when the SEO-defects lens found a defect a rule on the served
      // HTML could resolve (edgeSeoCtaApplies). One email, an optional site count that rides in
      // the note as "sites: <n>; ", and a lead with wedge 'edge-seo' plus the lens signal.
      // Copy mirrors the scanner's index.html verbatim — KEEP IN SYNC.
      function seoCard(r) {
        const sd = r.seoDefects;
        if (!edgeSeoCtaApplies(sd)) return '';
        const groups = sdFiredGroups(sd)
          .map((g) => g[1])
          .join(', ');
        return (
          '<section class="ar-sec" aria-labelledby="ar-h-seo">' +
          '<h3 id="ar-h-seo" class="ar-h3">SEO fixes without a CMS release</h3>' +
          '<p class="ar-v">This page has ' +
          esc(String(sd.counts.total)) +
          ' technical SEO issue(s) (' +
          esc(groups) +
          '). Issues like these are the kind a rule on the server could correct in the HTML it serves, without a CMS release.</p>' +
          '<p class="ar-v">We are building that rule set.</p>' +
          '<p class="ar-v">' +
          esc(sdServedBy(sd)) +
          '</p>' +
          '<div class="ar-cta-row">' +
          '<a class="ar-cta-link" href="/platform/edge-seo/" data-umami-event="airead-cta-edge-seo">Edge SEO at the origin →</a>' +
          '</div>' +
          '<p class="ar-v">If your CMS changes take weeks, tell us how many sites you manage.</p>' +
          '<form id="ar-seo-form" class="ar-next-form" data-wedge="edge-seo">' +
          '<label class="ar-field"><span class="ar-field-label">Your email</span>' +
          '<input id="ar-seo-email" type="email" autocomplete="email" required /></label>' +
          '<label class="ar-field"><span class="ar-field-label">Sites you manage (optional)</span>' +
          '<input id="ar-seo-sites" type="number" min="1" max="1000000" step="1" inputmode="numeric" /></label>' +
          '<label class="ar-field"><span class="ar-field-label">Anything we should know? CMS, hosting, who ships changes (optional)</span>' +
          '<textarea id="ar-seo-note" rows="3" maxlength="1500"></textarea></label>' +
          '<button type="submit" data-umami-event="airead-next-edge-seo">Talk to us about edge SEO</button>' +
          '</form>' +
          // Same per-request disclosure as the other wedge forms (it posts to /contact).
          '<p class="ar-disclosure">Submitting this sends us your email and a summary of this scan’s findings. ' +
          'We use them only for this request; see our <a href="https://we-amp.com/privacy/">privacy policy</a>.</p>' +
          '<div id="ar-seo-msg" class="ar-next-msg" role="status" aria-live="polite" tabindex="-1"></div>' +
          '</section>'
        );
      }

      // Capture cards that ship with every result, independent of which wedge
      // fired: an interest signup for AI-readability updates (topic
      // ai-readability-updates, explicit consent checkbox) and the
      // agentic-interest line (topic agents, the select's value rides as the
      // wedge). Copy promises no automation and no follow-up email.
      function captureBlocks() {
        const watch =
          '<h3 id="ar-h-watch" class="ar-h3">Follow AI-readability work</h3>' +
          '<p class="ar-v">Leave your email if you want to hear when we publish new checks or research on AI crawlers. We send nothing else.</p>' +
          '<form id="ar-watch-form" class="ar-next-form">' +
          '<label class="ar-field"><span class="ar-field-label">Your email</span>' +
          '<input id="ar-watch-email" type="email" autocomplete="email" required /></label>' +
          '<label class="ar-consent"><input id="ar-watch-consent" type="checkbox" required />' +
          '<span>Email me about new checks and research. I can ask to be removed at any time; see the <a href="https://we-amp.com/privacy/">privacy policy</a>.</span></label>' +
          '<button type="submit" data-umami-event="airead-watch">Keep me posted</button>' +
          '</form>' +
          // Own explicit aria-live for the same reason as #ar-next-msg (see nextStep).
          '<div id="ar-watch-msg" class="ar-next-msg" role="status" aria-live="polite" tabindex="-1"></div>';
        const agents =
          '<h3 id="ar-h-agents" class="ar-h3">Working on agent access at the origin</h3>' +
          '<form id="ar-agents-form" class="ar-next-form">' +
          '<label class="ar-field"><span class="ar-field-label">What do you need?</span>' +
          '<select id="ar-agents-need" required>' +
          '<option value="" selected disabled>Choose one</option>' +
          '<option value="agent-verification">Signed-agent verification</option>' +
          '<option value="ai-crawler-content">Content for AI crawlers</option>' +
          '<option value="provenance">Provenance of served content</option>' +
          '<option value="other">Something else</option>' +
          '</select></label>' +
          '<label class="ar-field"><span class="ar-field-label">Your email</span>' +
          '<input id="ar-agents-email" type="email" autocomplete="email" required /></label>' +
          '<label class="ar-field"><span class="ar-field-label">Paste your AI-crawler request counts (optional)</span>' +
          '<textarea id="ar-agents-log" rows="3" maxlength="1500"></textarea></label>' +
          '<button type="submit" data-umami-event="airead-agents">Tell us</button>' +
          '</form>' +
          '<p class="ar-disclosure">Submitting this sends us your email, your answer and this scan’s URL. ' +
          'We use them only for this request; see our <a href="https://we-amp.com/privacy/">privacy policy</a>.</p>' +
          '<div id="ar-agents-msg" class="ar-next-msg" role="status" aria-live="polite" tabindex="-1"></div>';
        return (
          '<section class="ar-sec" aria-labelledby="ar-h-watch">' +
          watch +
          '</section>' +
          '<section class="ar-sec" aria-labelledby="ar-h-agents">' +
          agents +
          '</section>'
        );
      }

      function render(data) {
        // Silence the giant single-shot announcement of the full result; the loading/
        // error branches re-set aria-live to polite (A11y).
        out.setAttribute('aria-live', 'off');
        const r = data.report;
        // Track which sites get analyzed (domain + grade) in Umami — privacy-first,
        // no PII (the scanned URL is a public site the user chose).
        try {
          if (window.umami) {
            let domain = r.url;
            try {
              domain = new URL(r.url).hostname;
            } catch (_) {}
            window.umami.track('ai-scan', {
              domain: domain,
              grade: r.grade,
              score: r.score,
              csr_gap: (r.categories['Content fidelity'] || {}).flag === 'csr-gap',
            });
          }
        } catch (_) {}
        const av = r.agentVerifiability;
        const ax = r.accessibility;
        // Which wedges fire, in priority order (tollbooth = highest commercial intent).
        // The first fired wedge leads (single-fire path); ≥2 fired → the chooser path.
        const firedWedges = [];
        if (tollboothCtaApplies(av)) firedWedges.push('tollbooth');
        if (agentPassCtaApplies(r.signedAgentVerification)) firedWedges.push('agentpass');
        if (complianceFixCtaApplies(ax)) firedWedges.push('compliancefix');
        const primaryWedge = firedWedges[0] || '';
        const multiWedge = firedWedges.length >= 2;

        // SECTION 1 — verdict: grade badge + 5 category bars (grading byte-identical; F3).
        const grade =
          '<div class="ar-grade"><div class="ar-badge ar-' +
          r.grade +
          '" role="img" aria-label="Grade ' +
          r.grade +
          ', ' +
          r.score +
          ' out of 100">' +
          r.grade +
          '</div>' +
          '<div><div class="ar-score">' +
          r.score +
          '/100</div><div class="ar-u">' +
          esc(r.url) +
          '</div><div class="ar-u">Grade ' +
          r.grade +
          ' — ' +
          ({ A: 'strong', B: 'strong', C: 'mixed', D: 'weak', F: 'poor' }[r.grade] || '') +
          '</div></div></div>';
        const cats = Object.entries(r.categories)
          .map(function (entry) {
            const name = entry[0],
              c = entry[1];
            const pct = Math.round((c.score / c.max) * 100);
            const flag =
              c.flag === 'csr-gap'
                ? '<span class="ar-flag">invisible without JS</span>'
                : c.flag === 'thin'
                  ? '<span class="ar-flag">no content found</span>'
                  : '';
            return (
              '<div class="ar-cat"><div class="ar-top"><span>' +
              esc(name) +
              flag +
              '</span><span>' +
              c.score +
              '/' +
              c.max +
              '</span></div>' +
              '<div class="ar-bar"><i style="width:' +
              pct +
              '%"></i></div><div class="ar-v">' +
              esc(c.verdict) +
              '</div></div>'
            );
          })
          .join('');

        // SECTION 2 — what an AI agent sees: the two diff panels FIRST, caption below.
        const d = r.diff;
        const panel = (t, tok, md) =>
          '<div class="ar-panel"><h4>' +
          t +
          '</h4><div class="ar-tok"><b>~' +
          tok.toLocaleString() +
          '</b> tokens an agent can read</div>' +
          (md && md.trim()
            ? '<pre>' + esc(md) + '</pre>'
            : '<p class="ar-empty">— almost nothing —</p>') +
          '</div>';
        const explain =
          '<p class="ar-explain">Left: the readable words in your raw HTML — what most AI crawlers get. ' +
          'Right: after a browser runs your JavaScript. A big shortfall on the left means your content ' +
          'barely exists until your scripts run.</p>';

        // SECTION 3 — beyond the grade: one explainer, then the explained lenses.
        const beyondExplain =
          '<p class="ar-explain">These don’t change the grade above. They’re extra signals on how ' +
          'machines read, verify, and parse your page.</p>';
        const avBlock = avDetail(av);
        const axBlock = axDetail(ax);
        const aaBlock = aaLine(r);
        // Five free non-scored lenses + the hidden-layer lens.
        // Each renders only when present in the report; all neutral.
        const avpBlk = avpBlock(r.agentVerificationPosture);
        const saBlk = signedAgentBlock(r.signedAgentVerification);
        const psBlk = psBlock(r.provenanceSurvival);
        const seBlk = seBlock(r.sovereigntyExposure);
        const pclBlk = pclBlock(r.preConsentLeak);
        const siBlk = siBlock(r.scriptInventory);
        const sdBlk = sdBlock(r.seoDefects);
        const ghostBlk = ghostBlock(r.ghostLayer);

        // SECTION 5 — share: the permalink the scanner mints for every scan, plus a
        // copy-link control. The page promises nothing it does not do by itself.
        const share = data.permalink
          ? '<div class="ar-share">Shareable link: <a href="' +
            esc(data.permalink) +
            '">' +
            esc(data.permalink) +
            '</a></div>' +
            '<button type="button" id="ar-copy-link">Copy link to this result</button>' +
            '<span id="ar-copy-msg" class="ar-copy-msg" role="status" aria-live="polite"></span>' +
            '<p class="ar-share-note">The link works for up to 24 hours.</p>'
          : '';

        out.innerHTML =
          '<div class="ar-card" role="region" aria-labelledby="ar-card-title" tabindex="-1">' +
          '<h2 id="ar-card-title" class="ar-h2">Readability result</h2>' +
          '<section aria-labelledby="ar-h-verdict">' +
          '<h3 id="ar-h-verdict" class="ar-sr-only">Grade</h3>' +
          grade +
          cats +
          '</section>' +
          '<section class="ar-sec" aria-labelledby="ar-h-diff">' +
          '<h3 id="ar-h-diff" class="ar-h3">What an AI agent actually sees</h3>' +
          '<div class="ar-diff">' +
          panel('Raw HTML — most AI crawlers', d.staticCleanTokens, d.staticMarkdown) +
          panel('After rendering JavaScript', d.renderedCleanTokens, d.renderedMarkdown) +
          '</div>' +
          explain +
          '</section>' +
          '<section class="ar-sec" aria-labelledby="ar-h-found">' +
          '<h3 id="ar-h-found" class="ar-h3">Beyond the grade</h3>' +
          beyondExplain +
          avBlock +
          avpBlk +
          saBlk +
          axBlock +
          psBlk +
          seBlk +
          pclBlk +
          siBlk +
          sdBlk +
          aaBlock +
          ghostBlk +
          '</section>' +
          '<section class="ar-sec" aria-labelledby="ar-h-next">' +
          nextStep(r, primaryWedge, firedWedges) +
          '</section>' +
          consentCard(r) +
          scriptCard(r) +
          seoCard(r) +
          captureBlocks() +
          (share ? '<section class="ar-sec" aria-label="Share">' + share + '</section>' : '') +
          '</div>';
        wireNext(r, primaryWedge, multiWedge);
        wireConsentCard(r);
        wireScriptCard(r);
        wireSeoCard(r);
        wireLeadCards(r);
        wireCopyLink(data.permalink);
        // Position the hidden-layer overlay boxes over the screenshot (no-op if not detected).
        wireGhostOverlay(r.ghostLayer);
        // Scroll the freshly rendered result into view and move keyboard/SR focus to the
        // region card. On mobile the verdict otherwise lands off-screen below the intro.
        const card = out.querySelector('.ar-card');
        if (card) {
          const rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          card.scrollIntoView({ behavior: rm ? 'auto' : 'smooth', block: 'start' });
          card.focus({ preventScroll: true });
        }
      }

      // lead_submit — one event per successful form submit, alongside each form's own
      // event. Same property contract as the rest of the site: channel (scan on this
      // page), topic (the topic posted to the capture endpoint), wedge (empty when
      // none) and source_path (the page path, never the query string).
      function leadSubmit(topic, wedge) {
        try {
          if (window.umami) {
            window.umami.track('lead_submit', {
              channel: 'scan',
              topic: topic,
              wedge: wedge || '',
              source_path: window.location.pathname,
            });
          }
        } catch (_) {}
      }

      // Copy-link control (replaces the old "email me this result" path): the page
      // keeps the result by itself. Copies the scanner-minted permalink via
      // navigator.clipboard; when that is unavailable, selects the visible
      // permalink text so Ctrl/Cmd+C finishes the job.
      function wireCopyLink(permalink) {
        const btn = $('#ar-copy-link');
        if (!btn || !permalink) return;
        const msg = $('#ar-copy-msg');
        btn.addEventListener('click', async () => {
          let copied = false;
          try {
            await navigator.clipboard.writeText(permalink);
            copied = true;
          } catch (_) {
            const link = out.querySelector('.ar-share a');
            if (link) {
              const range = document.createRange();
              range.selectNodeContents(link);
              const sel = window.getSelection();
              sel.removeAllRanges();
              sel.addRange(range);
            }
          }
          if (msg) {
            // Clear first so a repeat copy is announced again.
            msg.textContent = '';
            const text = copied ? 'Link copied' : 'Link selected — press Ctrl/Cmd+C to copy it';
            setTimeout(() => {
              msg.textContent = text;
            }, 50);
          }
          if (copied) {
            try {
              if (window.umami) window.umami.track('airead-copy-link');
            } catch (_) {}
          }
        });
      }

      // Wire the ONE consolidated next-step form (replaces wireCapture + wireWedges).
      // Wedge submissions build buildLeadPayload(wedge,…) → POST /contact. The form
      // renders only when a wedge fires; the old /notify email path is gone. NO
      // secret in client JS (F1/F2).
      function wireNext(r, primaryWedge, bothWedges) {
        const form = $('#ar-next-form');
        if (!form) return;
        const msg = $('#ar-next-msg');
        const emailEl = $('#ar-next-email');
        // Reveal the collapsed optional note once the visitor engages the email field.
        const noteFieldEl = $('#ar-next-note-field');
        if (noteFieldEl && emailEl) {
          emailEl.addEventListener(
            'focus',
            function () {
              noteFieldEl.removeAttribute('hidden');
            },
            { once: true },
          );
        }
        // When ≥2 wedges fire, the chooser drives data-wedge for analytics parity.
        // Seed it from the default-checked radio so the attribute matches the active
        // default (the highest-priority fired wedge) before any interaction, then
        // keep it in sync on change.
        if (bothWedges) {
          const checkedDefault = form.querySelector('input[name="ar-topic"]:checked');
          form.setAttribute('data-wedge', checkedDefault ? checkedDefault.value : '');
          form.querySelectorAll('input[name="ar-topic"]').forEach(function (radio) {
            radio.addEventListener('change', function () {
              form.setAttribute('data-wedge', radio.value);
            });
          });
        }
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const email = ((emailEl && emailEl.value) || '').trim();
          if (!email) {
            if (emailEl) emailEl.focus();
            return;
          }
          const noteEl = $('#ar-next-note');
          const note = ((noteEl && noteEl.value) || '').trim();
          const btn = form.querySelector('button[type="submit"]');
          // Resolve the topic: chooser radio (≥2 fire) → fixed wedge (one fires).
          let topic = primaryWedge;
          if (bothWedges) {
            const checked = form.querySelector('input[name="ar-topic"]:checked');
            topic = checked ? checked.value : primaryWedge;
          }
          if (btn) btn.disabled = true;
          if (topic === 'tollbooth' || topic === 'agentpass' || topic === 'compliancefix') {
            try {
              const payload = buildLeadPayload({
                wedge: topic,
                email: email,
                name: '',
                note: note,
                report: r,
              });
              const res = await fetch(API + '/contact', {
                method: 'POST',
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify(Object.assign({}, payload, { t: loadedAt })),
              });
              const j = await res.json().catch(() => ({}));
              if (res.ok) {
                leadSubmit(topic, topic);
                if (msg) {
                  msg.textContent = 'Thanks — your answer is in.';
                  msg.focus && msg.focus();
                }
                form.remove();
              } else {
                if (msg) msg.textContent = j && j.error ? j.error : 'Something went wrong.';
                if (btn) btn.disabled = false;
              }
            } catch (err) {
              if (msg) msg.textContent = 'Could not reach us. ' + esc(String(err));
              if (btn) btn.disabled = false;
            }
          }
        });
      }

      // POST one lead to /contact. Returns true on a 2xx, false on any failure; the
      // caller owns the status message and button state.
      async function postLead(payload) {
        try {
          const res = await fetch(API + '/contact', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(Object.assign({}, payload, { t: loadedAt })),
          });
          return res.ok;
        } catch (_) {
          return false;
        }
      }

      // Wire the consent-enforcement card (see consentCard): one email, one submit,
      // buildLeadPayload('consent-enforcement', …) → POST /contact.
      function wireConsentCard(r) {
        const form = $('#ar-consent-form');
        if (!form) return;
        const msg = $('#ar-consent-msg');
        const emailEl = $('#ar-consent-email');
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const email = ((emailEl && emailEl.value) || '').trim();
          if (!email || !form.checkValidity()) {
            form.reportValidity();
            return;
          }
          const btn = form.querySelector('button[type="submit"]');
          if (btn) btn.disabled = true;
          const ok = await postLead(
            buildLeadPayload({
              wedge: 'consent-enforcement',
              email: email,
              name: '',
              note: '',
              report: r,
            }),
          );
          if (ok) {
            leadSubmit('consent-enforcement', 'consent-enforcement');
            if (msg) {
              msg.textContent = 'Thanks — your answer is in.';
              msg.focus && msg.focus();
            }
            form.remove();
          } else {
            if (msg) msg.textContent = 'Something went wrong. Please try again in a moment.';
            if (btn) btn.disabled = false;
          }
        });
      }

      // Wire the script-control card (see scriptCard): the submit button pressed names the
      // wedge (page-integrity or third-party-freeze); falls back to the first button's wedge.
      function wireScriptCard(r) {
        const form = $('#ar-scripts-form');
        if (!form) return;
        const msg = $('#ar-scripts-msg');
        const emailEl = $('#ar-scripts-email');
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const email = ((emailEl && emailEl.value) || '').trim();
          if (!email || !form.checkValidity()) {
            form.reportValidity();
            return;
          }
          const first = form.querySelector('button[type="submit"]');
          const sub =
            e.submitter && e.submitter.dataset && e.submitter.dataset.wedge ? e.submitter : first;
          const wedge = (sub && sub.dataset && sub.dataset.wedge) || 'page-integrity';
          form.querySelectorAll('button[type="submit"]').forEach((b) => (b.disabled = true));
          const ok = await postLead(
            buildLeadPayload({ wedge: wedge, email: email, name: '', note: '', report: r }),
          );
          if (ok) {
            leadSubmit(wedge, wedge);
            if (msg) {
              msg.textContent = 'Thanks. We will be in touch by email.';
              msg.focus && msg.focus();
            }
            form.remove();
          } else {
            if (msg) msg.textContent = 'Something went wrong. Please try again in a moment.';
            form.querySelectorAll('button[type="submit"]').forEach((b) => (b.disabled = false));
          }
        });
      }

      // Wire the edge-SEO card (see seoCard): buildLeadPayload('edge-seo', …) → POST /contact.
      // The optional site count is prefixed into the note as "sites: <n>; ".
      function wireSeoCard(r) {
        const form = $('#ar-seo-form');
        if (!form) return;
        const msg = $('#ar-seo-msg');
        const emailEl = $('#ar-seo-email');
        const sitesEl = $('#ar-seo-sites');
        const noteEl = $('#ar-seo-note');
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const email = ((emailEl && emailEl.value) || '').trim();
          if (!email || !form.checkValidity()) {
            form.reportValidity();
            return;
          }
          const sites = sitesEl ? parseInt(sitesEl.value, 10) : NaN;
          const text = ((noteEl && noteEl.value) || '').trim().slice(0, 1500);
          const note = [Number.isInteger(sites) && sites > 0 ? 'sites: ' + sites : '', text]
            .filter(Boolean)
            .join('; ');
          const btn = form.querySelector('button[type="submit"]');
          if (btn) btn.disabled = true;
          const ok = await postLead(
            buildLeadPayload({ wedge: 'edge-seo', email: email, name: '', note: note, report: r }),
          );
          if (ok) {
            leadSubmit('edge-seo', 'edge-seo');
            if (msg) {
              msg.textContent = 'Thanks. We will be in touch by email.';
              msg.focus && msg.focus();
            }
            form.remove();
          } else {
            if (msg) msg.textContent = 'Something went wrong. Please try again in a moment.';
            if (btn) btn.disabled = false;
          }
        });
      }

      // Wire the two capture cards that ship with every result (see captureBlocks).
      function wireLeadCards(r) {
        const watchForm = $('#ar-watch-form');
        if (watchForm) {
          const msg = $('#ar-watch-msg');
          const emailEl = $('#ar-watch-email');
          watchForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const email = ((emailEl && emailEl.value) || '').trim();
            if (!email || !watchForm.checkValidity()) {
              watchForm.reportValidity();
              return;
            }
            const btn = watchForm.querySelector('button[type="submit"]');
            if (btn) btn.disabled = true;
            const message = [
              '[ai-readability-updates] updates signup from RenderPeek result',
              'Scanned: ' + (r.url || ''),
              'Grade: ' + (r.grade || '') + ' (' + (r.score ?? '') + '/100)',
            ].join('\n');
            const ok = await postLead({
              topic: 'ai-readability-updates',
              email: email,
              name: '',
              url: r.url || '',
              wedge: '',
              message: message,
            });
            if (ok) {
              leadSubmit('ai-readability-updates', '');
              if (msg) {
                msg.textContent = 'Thanks — you’re on the list.';
                msg.focus && msg.focus();
              }
              watchForm.remove();
            } else {
              if (msg) msg.textContent = 'Something went wrong. Please try again in a moment.';
              if (btn) btn.disabled = false;
            }
          });
        }
        const agentsForm = $('#ar-agents-form');
        if (agentsForm) {
          const msg = $('#ar-agents-msg');
          const emailEl = $('#ar-agents-email');
          const needEl = $('#ar-agents-need');
          const logEl = $('#ar-agents-log');
          agentsForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const email = ((emailEl && emailEl.value) || '').trim();
            if (!email || !agentsForm.checkValidity()) {
              agentsForm.reportValidity();
              return;
            }
            const need = needEl ? needEl.value : '';
            const needLabel =
              needEl && needEl.selectedOptions && needEl.selectedOptions[0]
                ? needEl.selectedOptions[0].textContent.trim()
                : need;
            // The operator log is free-form paste; cap it at the textarea's own
            // maxlength (1500) so a scripted submit can't push an unbounded message.
            const log = ((logEl && logEl.value) || '').trim().slice(0, 1500);
            const btn = agentsForm.querySelector('button[type="submit"]');
            if (btn) btn.disabled = true;
            const message = [
              '[agents] agent-access interest from RenderPeek result',
              'Scanned: ' + (r.url || ''),
              'Need: ' + needLabel,
              log ? 'AI-crawler request counts:\n' + log : null,
            ]
              .filter(Boolean)
              .join('\n');
            const ok = await postLead({
              topic: 'agents',
              email: email,
              name: '',
              url: r.url || '',
              wedge: need,
              message: message,
            });
            if (ok) {
              leadSubmit('agents', need);
              if (msg) {
                msg.textContent = 'Thanks — your answer is in.';
                msg.focus && msg.focus();
              }
              agentsForm.remove();
            } else {
              if (msg) msg.textContent = 'Something went wrong. Please try again in a moment.';
              if (btn) btn.disabled = false;
            }
          });
        }
      }
    })();
  </script>
</BaseLayout>
