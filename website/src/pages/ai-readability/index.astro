  </style>

  <script is:inline>
    (function () {
      // The shared scan interface (?ui=v2) drives this page instead.
      if (document.documentElement.dataset.scanUi === 'v2') return;
      // A different base is honoured only when the page itself is served from localhost.
      const API =
        (['localhost', '127.0.0.1', '[::1]'].indexOf(location.hostname) >= 0 &&
          new URLSearchParams(location.search).get('api')) ||
        '/ai-readability/api';
      const loadedAt = Date.now();
      const $ = (s) => document.querySelector(s);
      const out = $('#ar-out');
      const esc = (s) =>
        (s || '').replace(
          /[&<>"]/g,
          (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c],
        );

      // Inlined (not imported) because in production this is the Astro-built
      // modpagespeed.com/ai-readability/ page and only /ai-readability/api/* is proxied to the
      // render service — there is no /src/ route to import from.
      // VERBATIM inline copy of the scanner repo's src/demand.mjs (the canonical, unit-tested
      // source). KEEP IN SYNC with agent-readability-scanner:src/demand.mjs.
      function tollboothCtaApplies(agentVerifiability) {
        const d = agentVerifiability && agentVerifiability.detail;
        if (!d) return false;
        return (
          d.verifiable === false &&
          d.renderOk === true &&
          Array.isArray(d.aiCrawlersAllowed) &&
          d.aiCrawlersAllowed.length > 0 &&
          d.exposurePct >= 30
        );
      }
      function agentPassCtaApplies(signedAgentVerification) {
        const s = signedAgentVerification;
        return !!(
          s &&
          s.status === 'ok' &&
          (s.classification === 'verifying' || s.classification === 'signature-aware')
        );
      }
      function complianceFixCtaApplies(accessibility) {
        const a = accessibility;
        return !!(a && a.available && a.detail && a.detail.fixableInline > 0);
      }
      function consentEnforcementCtaApplies(preConsentLeak) {
        const p = preConsentLeak;
        return !!(p && p.status === 'ok' && p.verdict === 'leaks' && p.trackerCount > 0);
      }
      function pageIntegrityCtaApplies(scriptInventory) {
        const si = scriptInventory;
        return !!(si && si.status === 'ok' && si.verdict === 'attention');
      }
      function thirdPartyFreezeCtaApplies(scriptInventory) {
        const si = scriptInventory;
        return !!(
          si &&
          si.status === 'ok' &&
          si.verdict !== 'unknown' &&
          si.totals &&
          si.totals.thirdPartyExternal > si.totals.thirdPartyWithIntegrity
        );
      }
      function edgeSeoCtaApplies(sd) {
        return !!(
          sd &&
          sd.status === 'ok' &&
          sd.verdict === 'attention' &&
          Array.isArray(sd.defects) &&
          sd.defects.length > 0
        );
      }
      function buildLeadPayload(opts) {
        const wedge = opts.wedge,
          email = opts.email,
          name = opts.name,
          note = opts.note,
          report = opts.report;
        const url = (report && report.url) || '';
        let lensSignal;
        if (wedge === 'tollbooth') {
          const d = report.agentVerifiability.detail;
          lensSignal = {
            verifiable: d.verifiable,
            exposurePct: d.exposurePct,
            aiCrawlersAllowed: d.aiCrawlersAllowed,
            aiCrawlersBlocked: d.aiCrawlersBlocked,
            botAuthHeaders: d.botAuthHeaders,
            renderOk: d.renderOk,
          };
        } else if (wedge === 'agentpass') {
          const s = report.signedAgentVerification;
          lensSignal = {
            classification: s.classification,
            evidence: s.evidence,
            probes: s.probes,
          };
        } else if (wedge === 'compliancefix') {
          const d = report.accessibility.detail;
          lensSignal = {
            total: d.total,
            fixableInline: d.fixableInline,
            byImpact: d.byImpact,
            topRules: d.topRules,
          };
        } else if (wedge === 'consent-enforcement') {
          const p = report.preConsentLeak;
          lensSignal = {
            verdict: p.verdict,
            trackerCount: p.trackerCount,
            thirdPartyCount: p.thirdPartyCount,
            topHosts: (p.thirdPartyHosts || [])
              .slice(0, 3)
              .map((h) => ({ host: h.host, requests: h.requests, category: h.category })),
            cmpDetected: p.cmpDetected,
          };
        } else if (wedge === 'page-integrity' || wedge === 'third-party-freeze') {
          const s = report.scriptInventory;
          lensSignal = {
            verdict: s.verdict,
            reasons: s.reasons,
            totals: {
              scripts: s.totals.scripts,
              inline: s.totals.inline,
              thirdPartyExternal: s.totals.thirdPartyExternal,
              thirdPartyHosts: s.totals.thirdPartyHosts,
              thirdPartyWithIntegrity: s.totals.thirdPartyWithIntegrity,
            },
            topHosts: (s.scriptHosts || [])
              .filter((h) => h.party === 'third')
              .slice(0, 3)
              .map((h) => ({ host: h.host, scripts: h.scripts, category: h.category })),
            duplicates: (s.duplicates || []).slice(0, 3),
            csp: s.csp,
          };
        } else if (wedge === 'edge-seo') {
          // Ids, counts, booleans and two fixed tokens: no URLs, titles, descriptions or JSON-LD types.
          const s = report.seoDefects;
          lensSignal = {
            verdict: s.verdict,
            defects: s.defects,
            counts: s.counts,
            staticCompared: s.staticCompared,
            notMeasured: s.notMeasured,
            robotsMismatch: !!(s.robots && s.robots.mismatch),
            jsonLdPresent: !!(s.jsonLd && s.jsonLd.static.blocks + s.jsonLd.rendered.blocks > 0),
            delivery: {
              cdn: s.delivery ? s.delivery.cdn : null,
              server: s.delivery ? s.delivery.server : null,
            },
          };
        } else {
          lensSignal = null; // a wedge with no scanner lens behind it
        }
        const message = [
          '[' + wedge + '] lead from RenderPeek result',
          'Scanned: ' + url,
          note ? 'Operator note / crawl volume: ' + note : null,
          lensSignal ? 'Signal: ' + JSON.stringify(lensSignal) : null,
        ]
          .filter(Boolean)
          .join('\n');
        return {
          topic: wedge,
          email: email,
          name: name || '',
          url: url,
          wedge: wedge,
          lensSignal: lensSignal,
          message: message,
        };
      }

      // Normalize + validate the URL the same way /analyze does: accept a bare
      // host (prepend https://), then require a parseable http/https URL with a
      // real public hostname. Returns the canonical URL string, or null on error
      // (with the message shown in the result slot).
      function normalizeUrl(raw) {
        let trimmed = (raw || '').trim();
        if (!trimmed) return null;
        if (!/^[a-z][a-z0-9+.-]*:\/\//i.test(trimmed)) trimmed = 'https://' + trimmed;
        let parsed;
        try {
          parsed = new URL(trimmed);
        } catch (_) {
          out.innerHTML =
            '<div class="ar-card ar-err">That does not look like a valid URL (try https://example.com).</div>';
          return null;
        }
        if (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') {
          out.innerHTML =
            '<div class="ar-card ar-err">Only http:// and https:// URLs are supported.</div>';
          return null;
        }
        if (!parsed.hostname || parsed.hostname === 'localhost') {
          out.innerHTML =
            '<div class="ar-card ar-err">RenderPeek needs a publicly reachable hostname. Localhost won’t work.</div>';
          return null;
        }
        return parsed.toString();
      }
      // The Scan button stays focusable while a scan is in flight
      // (aria-disabled, not disabled): a disabled button drops keyboard focus
      // to <body>. This flag is the double-submit guard, for clicks and Enter.
      let scanning = false;
      $('#ar-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        if (scanning) return;
        // A previous run's error hold must not outlive its scan: a new run
        // re-reserves below via aria-busy, and the validation errors render
        // without the busy state (their collapse follows this click).
        delete out.dataset.hold;
        const url = normalizeUrl($('#ar-url').value);
        if (!url) return;
        scanning = true;
        $('#ar-go').setAttribute('aria-disabled', 'true');
        $('#ar-go').textContent = 'Scanning…';
        out.setAttribute('aria-busy', 'true');
        // Re-arm polite announcements for the loading/error strings (render() sets it to
        // 'off' so the full result card isn't announced as one giant live update).
        out.setAttribute('aria-live', 'polite');
        // Keep the reserved area down to the fold only, and never taller than
        // it is now (the visitor may have scrolled into it during the scan).
        const holdToFold = () => {
          const r = out.getBoundingClientRect();
          const h = Math.min(r.height, Math.max(0, innerHeight - r.top));
          out.style.setProperty('--ar-hold', Math.round(h) + 'px');
          out.dataset.hold = '1';
        };
        out.innerHTML =
          '<div class="ar-card ar-loading">Rendering and grading your page in a headless browser — about 5–10 seconds.</div>';
        try {
          const res = await fetch(API + '/scan?url=' + encodeURIComponent(url));
          const data = await res.json();
          if (data.error) {
            holdToFold();
            out.innerHTML =
              '<div class="ar-card ar-err" role="alert"><strong>Couldn’t scan that.</strong> ' +
              esc(data.error) +
              '</div>';
            return;
          }
          render(data);
        } catch (err) {
          holdToFold();
          out.innerHTML =
            '<div class="ar-card ar-err" role="alert"><strong>Couldn’t scan that.</strong> Could not reach the scanner service. Check the URL and try again.</div>';
        } finally {
          scanning = false;
          $('#ar-go').removeAttribute('aria-disabled');
          $('#ar-go').textContent = 'Scan';
          out.setAttribute('aria-busy', 'false');
        }
      });
      // Editing the URL releases an error's hold (see the #ar-out rule): the
      // reserved area collapses on a keystroke, so any shift is input-excluded.
