# Lint environment for mod_pagespeed 1.1
# Extends the dev image with clang-tidy-20 and clang-format-20.
# Build: docker build -t pagespeed1.1-lint:latest -f docker/Dockerfile.lint docker/
# CI build: docker build --build-arg BASE=pagespeed1.1-dev:{arch}-{hash} ...
# Note: requires the base dev image to already be present locally.
ARG BASE=pagespeed1.1-dev:latest
FROM ${BASE}

RUN apt-get update && apt-get install -y --no-install-recommends \
    clang-format-20 \
    clang-tidy-20 \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/clang-format-20 /opt/llvm/bin/clang-format \
    && ln -sf /usr/bin/clang-tidy-20 /opt/llvm/bin/clang-tidy \
    && ln -sf /usr/bin/run-clang-tidy-20 /opt/llvm/bin/run-clang-tidy
