# The distribution's nginx with the published module and optimizer packages.
# Pinned by digest (Scorecard). Refresh: docker buildx imagetools inspect ubuntu:24.04 --format '{{json .Manifest.Digest}}'
FROM ubuntu:24.04@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852
# The optimizer release the tree pins, and the module package of that pair
# (whose library run.sh may replace with a fresh build).
ARG PAIR_VERSION=2.5.0
# published: install both packages from the public package repository.
# local: install the packages in pkgs/ (run.sh stages them), and nothing from
# the repository.
ARG PACKAGES=published
ENV DEBIAN_FRONTEND=noninteractive
COPY pkgs/ /pkgs/
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl gnupg nginx imagemagick procps && \
    if [ "$PACKAGES" = local ]; then \
      apt-get install -y /pkgs/*.deb; \
    else \
      curl -fsSL https://packages.modpagespeed.com/install.sh | sh && \
      apt-get update && \
      apt-get install -y "nginx-module-pagespeed=${PAIR_VERSION}-*" "pagespeed-optimizer=${PAIR_VERSION}"; \
    fi
