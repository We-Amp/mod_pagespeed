# Apache with the published module and optimizer packages.
FROM ubuntu:24.04
ARG MODULE_VERSION=2.5.0-r1
ARG OPTIMIZER_VERSION=2.5.0
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl gnupg apache2 imagemagick procps && \
    curl -fsSL https://packages.modpagespeed.com/install.sh | sh && \
    apt-get update && \
    apt-get install -y mod-pagespeed=${MODULE_VERSION} pagespeed-optimizer=${OPTIMIZER_VERSION}
