# Secondary-port test servers for test/system/run_nginx_tests.sh: the nginx form
# of the name-based VirtualHosts in test/system/setup_apache_test.sh (lane
# fixtures secondary_vhosts and experiment_framework), same names and options.
# @@PORT@@, @@DOC_ROOT@@, @@CACHE@@ and @@COMMON@@ are filled in by the runner;
# @@COMMON@@ holds the settings an Apache vhost inherits. Left out: .htaccess
# overrides and ProxyAuth, which nginx does not have, and
# selfsigned.modpagespeed.com, which needs the external_origin fixture.

pagespeed CreateSharedMemoryMetadataCache "@@CACHE@@_with_shm" 8192;

server {
    listen @@PORT@@;
    server_name secondary.example.com;
    include @@COMMON@@;
    add_header X-Test-Vhost "secondary.example.com" always;
    root @@DOC_ROOT@@;
    pagespeed on;
    pagespeed FileCachePath "@@CACHE@@_secondary";
    pagespeed CompressMetadataCache false;
    pagespeed MapProxyDomain secondary.example.com/gstatic_images http://www.gstatic.com/psa/static;

    pagespeed CacheFlushFilename cache.flush;
    # If you uncomment this, the test will fail, proving we can disable
    # cache-flush polling.
    # ModPagespeedCacheFlushPollIntervalSec 0

    # Helps testing that the deprecated ReportUnloadTime option still parses
    # and stays a no-op (the beacon always sends on page-hide).
    pagespeed ReportUnloadTime on;

    # Make a non-empty subdirectory config to make sure that
    # cache.flush updates get transmitted to nested configurations.
    location /cache_flush/ {
        pagespeed RewriteLevel PassThrough;
        pagespeed EnableFilters inline_css;
        pagespeed DisableFilters add_instrumentation;
    }
}

# Sets up a virtual host where we can specify forbidden filters without
# affecting any other hosts.
server {
    listen @@PORT@@;
    server_name forbidden.example.com;
    include @@COMMON@@;
    add_header X-Test-Vhost "forbidden.example.com" always;
    root @@DOC_ROOT@@;
    pagespeed BlockingRewriteKey psatest;
    pagespeed FileCachePath "@@CACHE@@";
    # Start with all core filters enabled ...
    pagespeed RewriteLevel CoreFilters;
    # ... then forbid these filters ...
    pagespeed ForbidFilters remove_quotes,remove_comments,collapse_whitespace;
    pagespeed ForbidFilters rewrite_css,resize_images;
    # ... and disable but not forbid this one (to ensure we retain its URL).
    pagespeed DisableFilters inline_css;
}

server {
    listen @@PORT@@;
    server_name unauthorizedresources.example.com;
    include @@COMMON@@;
    add_header X-Test-Vhost "unauthorizedresources.example.com" always;
    root @@DOC_ROOT@@;
    pagespeed FileCachePath "@@CACHE@@";
    pagespeed RewriteLevel PassThrough;
    pagespeed InlineResourcesWithoutExplicitAuthorization Script,Stylesheet;
    pagespeed CssInlineMaxBytes 1000000;
}

server {
    listen @@PORT@@;
    server_name pagespeed-off.example.com;
    include @@COMMON@@;
    add_header X-Test-Vhost "pagespeed-off.example.com" always;
    root @@DOC_ROOT@@;
    pagespeed FileCachePath "@@CACHE@@";
    pagespeed off;
    pagespeed EnableFilters collapse_whitespace;
}

server {
    listen @@PORT@@;
    server_name pagespeed-on.example.com;
    include @@COMMON@@;
    add_header X-Test-Vhost "pagespeed-on.example.com" always;
    root @@DOC_ROOT@@;
    pagespeed FileCachePath "@@CACHE@@";
    pagespeed on;
    pagespeed EnableFilters collapse_whitespace;
}

server {
    listen @@PORT@@;
    server_name pagespeed-unplugged.example.com;
    include @@COMMON@@;
    add_header X-Test-Vhost "pagespeed-unplugged.example.com" always;
    root @@DOC_ROOT@@;
    pagespeed FileCachePath "@@CACHE@@";
    pagespeed unplugged;
    pagespeed EnableFilters collapse_whitespace;
}

server {
    listen @@PORT@@;
    server_name pagespeed-standby.example.com;
    include @@COMMON@@;
    add_header X-Test-Vhost "pagespeed-standby.example.com" always;
    root @@DOC_ROOT@@;
    pagespeed FileCachePath "@@CACHE@@";
    pagespeed standby;
    pagespeed EnableFilters collapse_whitespace;
}

server {
    listen @@PORT@@;
    server_name url-attribute.example.com;
    include @@COMMON@@;
    add_header X-Test-Vhost "url-attribute.example.com" always;

    root @@DOC_ROOT@@;
    pagespeed FileCachePath "@@CACHE@@";

    # Don't actually try to rewrite any resources; the ones in
    # rewrite_domains.html don't actually exist.
    pagespeed RewriteLevel PassThrough;

    # This is used for testing dynamically defined url-valued
    # attributes
    pagespeed UrlValuedAttribute span src Hyperlink;
    pagespeed UrlValuedAttribute hr imgsrc Image;
    pagespeed DomainRewriteHyperlinks on;
    pagespeed MapRewriteDomain http://dst.example.com http://src.example.com;
    pagespeed EnableFilters rewrite_domains;
    pagespeed UrlValuedAttribute custom a Image;
    pagespeed UrlValuedAttribute custom b otherResource;
    pagespeed UrlValuedAttribute custom c hyperlink;
    pagespeed UrlValuedAttribute img alt-src Image;
    pagespeed UrlValuedAttribute video alt-a Image;
    pagespeed UrlValuedAttribute video alt-b Image;
    pagespeed UrlValuedAttribute video alt-b Image;

    pagespeed UrlValuedAttribute link data-stylesheet Stylesheet;
    pagespeed UrlValuedAttribute span data-stylesheet-a Stylesheet;
    pagespeed UrlValuedAttribute span data-stylesheet-b Stylesheet;
    pagespeed UrlValuedAttribute span data-stylesheet-c Stylesheet;

    # Also test that we can redefine spec-defined attributes.
    pagespeed UrlValuedAttribute blockquote cite Image;
}

# The CDN in our example which simply forwards requests to the proxy.
server {
    listen @@PORT@@;
    server_name cdn.pm.example.com;
    include @@COMMON@@;
    add_header X-Test-Vhost "cdn.pm.example.com" always;

    # Point the docroot somewhere useless so that we know we're not fetching
    # from the CDN's filesystem. Note that in particular we are not attempting to
    # run CGI scripts.
    root @@DOC_ROOT@@/mod_pagespeed_example/cgi;

    # Tell mod_proxy that we need to use a proxy to reach our VirtualHost servers.

    # Unplugged so that it passes the .pagespeed. requests through to the proxy.
    pagespeed unplugged;
    location ^~ /external/ {
        proxy_pass http://127.0.0.1:@@PORT@@/external/;
        proxy_set_header Host proxy.pm.example.com;
    }
}

# The proxy that runs MPS and can proxy data from origin. When the CDN
# requests proxied data from the proxy the proxy knows to fetch it from the
# origin server.
server {
    listen @@PORT@@;
    server_name proxy.pm.example.com;
    include @@COMMON@@;
    add_header X-Test-Vhost "proxy.pm.example.com" always;
    root @@DOC_ROOT@@/mod_pagespeed_test;
    # The usual cache location so that it gets cleared for on_cache_flush tests.
    pagespeed FileCachePath "@@CACHE@@";

    # We have to fetch through our localhost proxy to get to our other vhosts.
    pagespeed FetchProxy "localhost:@@PORT@@";

    # Origin resources should be optimized and hosted on proxy/external but
    # rewritten to cdn/external.
    pagespeed Domain proxy.pm.example.com;
    pagespeed MapProxyDomain proxy.pm.example.com/external origin.pm.example.com cdn.pm.example.com/external;
    pagespeed RewriteLevel CoreFilters;
    pagespeed RewriteDeadlinePerFlushMs -1;
}

# The origin that serves the images to be proxied (Puzzle.jpg)
server {
    listen @@PORT@@;
    server_name origin.pm.example.com;
    include @@COMMON@@;
    add_header X-Test-Vhost "origin.pm.example.com" always;
    root @@DOC_ROOT@@/mod_pagespeed_example/images;
    pagespeed unplugged;
}

