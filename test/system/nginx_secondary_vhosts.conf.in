    include @@COMMON@@;
    add_header X-Test-Vhost "unsigned-urls-transition.example.com" always;
    root @@DOC_ROOT@@;
    pagespeed FileCachePath "@@CACHE@@";
    # This server will not sign URLs, but AcceptInvalidSignatures is on.
