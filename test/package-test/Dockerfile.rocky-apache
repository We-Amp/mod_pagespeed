FROM rockylinux:9@sha256:d7be1c094cc5845ee815d4632fe377514ee6ebcf8efaed6892889657e5ddaaa6 # 9

ENV DISTRO_FAMILY=rhel

# Install httpd and test dependencies
RUN dnf install -y --allowerasing \
    httpd \
    curl \
    python3 \
    python3-pip \
    at \
    && dnf clean all

# Install pytest
RUN pip3 install --no-cache-dir pytest==8.3.5 pytest-timeout==2.3.1

# Install the .rpm package
COPY packages/*.rpm /tmp/
RUN dnf install -y /tmp/*.rpm && dnf clean all

COPY run-apache-tests.sh /usr/local/bin/run-tests.sh
RUN chmod +x /usr/local/bin/run-tests.sh

ENTRYPOINT ["/usr/local/bin/run-tests.sh"]
