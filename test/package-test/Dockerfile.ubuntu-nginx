# 24.04
FROM ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55 AS nginx-build

ENV DEBIAN_FRONTEND=noninteractive

# Build stage: the compiler toolchain lives here only, so it (and its OS
# package findings) never reaches the smoke image.
# Build nginx 1.30.5 from source (must match the version the module was built
# against — nginx ABI-pins modules to the exact version, so this MUST track the
# dev nginx in docker/Dockerfile; CVE-2026-90439: 1.30.4 -> 1.30.5).
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libpcre3-dev \
    zlib1g-dev \
    libssl-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL "https://nginx.org/download/nginx-1.30.5.tar.gz" -o /tmp/nginx.tar.gz \
    && echo "6c20565aa2325cb82216ae804f4a4ff1875179014759a381c42ddc8e11c4906d  /tmp/nginx.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/nginx.tar.gz -C /usr/local/src \
    && rm /tmp/nginx.tar.gz \
    && cd /usr/local/src/nginx-1.30.5 \
    && ./configure \
        --prefix=/usr/local/nginx \
        --with-http_v2_module \
        --with-http_ssl_module \
        --with-threads \
        --with-compat \
    && make -j$(nproc) \
    && make install

# 24.04
FROM ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55

ENV DEBIAN_FRONTEND=noninteractive

# Smoke image: runtime libraries and test dependencies only.
# apt-get upgrade patches the base-image packages baked into ubuntu:24.04 (which
# `apt install` alone leaves untouched) — clears the fixable OS CVEs the
# dependency scan flags. This is a test rig, not a shipped artifact; it sits on
# noble (the module ships noble packages) rather than the older jammy base.
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    curl \
    libpcre3 \
    zlib1g \
    libssl3t64 \
    python3 \
    python3-pip \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install pytest (noble's system Python is externally managed, PEP 668; this is
# a throwaway test image, so install into the system site-packages), then drop
# the pip package itself: nothing needs it at test time.
RUN pip3 install --no-cache-dir --break-system-packages pytest==9.0.3 pytest-timeout==2.3.1 \
    && apt-get purge -y python3-pip && apt-get autoremove -y --purge \
    && rm -rf /var/lib/apt/lists/*

COPY --from=nginx-build /usr/local/nginx /usr/local/nginx

# Extract the module from the tarball
COPY packages/ngx_pagespeed*.tar.gz /tmp/
RUN mkdir -p /usr/local/nginx/modules \
    && cd /tmp \
    && set -e \
    && n=$(ls -1 ngx_pagespeed*.tar.gz | wc -l) \
    && { [ "$n" = 1 ] || { echo "ERROR: expected exactly 1 ngx_pagespeed tarball in build context, found $n:"; ls -1 ngx_pagespeed*.tar.gz; exit 1; }; } \
    && tar xzf ngx_pagespeed*.tar.gz \
    && cp /tmp/ngx_pagespeed-*/ngx_pagespeed_module.so /usr/local/nginx/modules/ \
    && rm -rf /tmp/ngx_pagespeed*

ENV NGINX_BINARY=/usr/local/nginx/sbin/nginx
ENV MODULE_PATH=/usr/local/nginx/modules/ngx_pagespeed_module.so

COPY run-nginx-tests.sh /usr/local/bin/run-tests.sh
RUN chmod +x /usr/local/bin/run-tests.sh

ENTRYPOINT ["/usr/local/bin/run-tests.sh"]
