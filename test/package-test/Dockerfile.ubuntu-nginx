FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies for nginx and test dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libpcre3-dev \
    zlib1g-dev \
    libssl-dev \
    python3 \
    python3-pip \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install pytest
RUN pip3 install --no-cache-dir pytest pytest-timeout

# Build nginx 1.30.2 from source (must match the version the module was built
# against — nginx ABI-pins modules to the exact version, so this MUST track the
# dev nginx in docker/Dockerfile; CVE-2026-9256: 1.30.1 -> 1.30.2).
RUN curl -fsSL "https://nginx.org/download/nginx-1.30.2.tar.gz" -o /tmp/nginx.tar.gz \
    && echo "7df3090907fca3cc0e456d6dc00ceb230da74ea88026ceff0affc29dbbd9ac4c  /tmp/nginx.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/nginx.tar.gz -C /usr/local/src \
    && rm /tmp/nginx.tar.gz \
    && cd /usr/local/src/nginx-1.30.2 \
    && ./configure \
        --prefix=/usr/local/nginx \
        --with-http_v2_module \
        --with-http_ssl_module \
        --with-threads \
        --with-compat \
    && make -j$(nproc) \
    && make install

# Extract the module from the tarball
COPY packages/ngx_pagespeed*.tar.gz /tmp/
RUN mkdir -p /usr/local/nginx/modules \
    && cd /tmp \
    && set -e \
    && n=$(ls -1 ngx_pagespeed*.tar.gz | wc -l) \
    && { [ "$n" = 1 ] || { echo "ERROR: expected exactly 1 ngx_pagespeed tarball in build context, found $n:"; ls -1 ngx_pagespeed*.tar.gz; exit 1; }; } \
    && tar xzf ngx_pagespeed*.tar.gz \
    && cp /tmp/ngx_pagespeed-*/ngx_pagespeed_module.so /usr/local/nginx/modules/ \
    && rm -rf /tmp/ngx_pagespeed*

ENV NGINX_BINARY=/usr/local/nginx/sbin/nginx
ENV MODULE_PATH=/usr/local/nginx/modules/ngx_pagespeed_module.so

COPY run-nginx-tests.sh /usr/local/bin/run-tests.sh
RUN chmod +x /usr/local/bin/run-tests.sh

ENTRYPOINT ["/usr/local/bin/run-tests.sh"]
