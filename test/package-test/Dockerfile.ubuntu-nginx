FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies for nginx and test dependencies.
# apt-get upgrade patches the base-image packages baked into ubuntu:22.04 (which
# `apt install` alone leaves untouched) — clears the fixable OS CVEs the
# dependency scan flags. Remaining medium+ are jammy `fix: none` (no upstream patch).
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libpcre3-dev \
    zlib1g-dev \
    libssl-dev \
    python3 \
    python3-pip \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install pytest
RUN pip3 install --no-cache-dir pytest pytest-timeout

# Build nginx 1.30.4 from source (must match the version the module was built
# against — nginx ABI-pins modules to the exact version, so this MUST track the
# dev nginx in docker/Dockerfile; CVE-2026-42533: 1.30.3 -> 1.30.4).
RUN curl -fsSL "https://nginx.org/download/nginx-1.30.4.tar.gz" -o /tmp/nginx.tar.gz \
    && echo "4261dc90e9e47c1c4041276e9aaa3d48ebe2e664f728e14fa95ae6c67d57a08b  /tmp/nginx.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/nginx.tar.gz -C /usr/local/src \
    && rm /tmp/nginx.tar.gz \
    && cd /usr/local/src/nginx-1.30.4 \
    && ./configure \
        --prefix=/usr/local/nginx \
        --with-http_v2_module \
        --with-http_ssl_module \
        --with-threads \
        --with-compat \
    && make -j$(nproc) \
    && make install

# Extract the module from the tarball
COPY packages/ngx_pagespeed*.tar.gz /tmp/
RUN mkdir -p /usr/local/nginx/modules \
    && cd /tmp \
    && set -e \
    && n=$(ls -1 ngx_pagespeed*.tar.gz | wc -l) \
    && { [ "$n" = 1 ] || { echo "ERROR: expected exactly 1 ngx_pagespeed tarball in build context, found $n:"; ls -1 ngx_pagespeed*.tar.gz; exit 1; }; } \
    && tar xzf ngx_pagespeed*.tar.gz \
    && cp /tmp/ngx_pagespeed-*/ngx_pagespeed_module.so /usr/local/nginx/modules/ \
    && rm -rf /tmp/ngx_pagespeed*

ENV NGINX_BINARY=/usr/local/nginx/sbin/nginx
ENV MODULE_PATH=/usr/local/nginx/modules/ngx_pagespeed_module.so

COPY run-nginx-tests.sh /usr/local/bin/run-tests.sh
RUN chmod +x /usr/local/bin/run-tests.sh

ENTRYPOINT ["/usr/local/bin/run-tests.sh"]
