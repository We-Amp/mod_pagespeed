FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV DISTRO_FAMILY=debian

# Install Apache and test dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    apache2 \
    ca-certificates \
    curl \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install pytest
RUN pip3 install --no-cache-dir pytest pytest-timeout

# Install the .deb package (pulls in any missing deps)
COPY packages/*.deb /tmp/
RUN apt-get update && apt-get install -y /tmp/*.deb && rm -rf /var/lib/apt/lists/*

COPY run-apache-tests.sh /usr/local/bin/run-tests.sh
RUN chmod +x /usr/local/bin/run-tests.sh

ENTRYPOINT ["/usr/local/bin/run-tests.sh"]
