# 22.04
FROM ubuntu:22.04@sha256:0a9887931b0e38af2e3487ed39e29436b0535c4f3f52e57745baaf79d1898956

ENV DEBIAN_FRONTEND=noninteractive
ENV DISTRO_FAMILY=debian

# Install Apache and test dependencies.
# apt-get upgrade patches the base-image packages baked into ubuntu:22.04 (which
# `apt install` alone leaves untouched) — clears the fixable OS CVEs the
# dependency scan flags. Remaining medium+ are jammy `fix: none` (no upstream patch).
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    apache2 \
    ca-certificates \
    curl \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install pytest
RUN pip3 install --no-cache-dir pytest==8.3.5 pytest-timeout==2.3.1

# Install the .deb package (pulls in any missing deps)
COPY packages/*.deb /tmp/
RUN apt-get update && apt-get install -y /tmp/*.deb && rm -rf /var/lib/apt/lists/*

COPY run-apache-tests.sh /usr/local/bin/run-tests.sh
RUN chmod +x /usr/local/bin/run-tests.sh

ENTRYPOINT ["/usr/local/bin/run-tests.sh"]
