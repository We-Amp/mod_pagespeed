def nginx_dependencies():
    """Register NGINX as an external dependency.

    Call this function from WORKSPACE after mod_pagespeed_dependencies().

    This sets up NGINX using the nginx_repository rule which:
    1. Checks NGINX_PATH environment variable
    2. Falls back to third_party/nginx submodule
    3. Falls back to /usr/local/src/nginx

    If nginx has not been configured (./configure), stub headers are generated
    that allow compilation but require a configured nginx for runtime.
    """
    nginx_repository(
        name = "nginx",
    )
