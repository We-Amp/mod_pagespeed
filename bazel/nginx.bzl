# Repository rules for NGINX external dependency
#
# This file provides flexible configuration for NGINX source location:
#
# Option 1: new_local_repository (for local source checkout)
#   Use when you have NGINX source already checked out and configured.
#
# Option 2: http_archive (for downloading a specific version)
#   Downloads NGINX source, but requires manual ./configure step
#   or auto-generated config headers.
#
# Option 3: nginx_repository rule (auto-detects location)
#   Checks NGINX_PATH env var, then common locations.

load("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Current stable NGINX version (as of 2026)
NGINX_VERSION = "1.26.3"
NGINX_SHA256 = ""  # Set this after downloading

def _nginx_repository_impl(repository_ctx):
    """Repository rule for NGINX that handles flexible source location.

    NGINX source is located in order of preference:
    1. NGINX_PATH environment variable
    2. Git submodule at third_party/nginx (relative to workspace)
    3. Platform-specific default: /usr/local/src/nginx (Linux/macOS)
    """
    # Check environment variable first
    nginx_path = repository_ctx.os.environ.get("NGINX_PATH", "")

    if not nginx_path:
        # Check for git submodule (relative to workspace root)
        workspace_root = str(repository_ctx.workspace_root)
        submodule_path = workspace_root + "/third_party/nginx"

        # Test if submodule path exists and has src directory
        result = repository_ctx.execute(["test", "-d", submodule_path + "/src"])
        if result.return_code == 0:
            nginx_path = submodule_path
        else:
            # Fall back to common location
            nginx_path = "/usr/local/src/nginx"

    # Symlink the source directories from nginx
    repository_ctx.symlink(nginx_path + "/src", "src")

    # Symlink objs directory if it exists (contains auto-generated headers)
    # This requires nginx to have been configured with ./configure
    objs_result = repository_ctx.execute(["test", "-d", nginx_path + "/objs"])
    if objs_result.return_code == 0:
        repository_ctx.symlink(nginx_path + "/objs", "objs")
    else:
        # Create a minimal objs directory with stub config headers
        # This allows compilation to proceed, but the module won't work
        # without a proper nginx configuration
        repository_ctx.file("objs/ngx_auto_config.h", _NGX_AUTO_CONFIG_STUB)
        repository_ctx.file("objs/ngx_auto_headers.h", _NGX_AUTO_HEADERS_STUB)

    # Write the BUILD file
    repository_ctx.file("BUILD.bazel", repository_ctx.read(
        repository_ctx.path(repository_ctx.attr.build_file)
    ))

nginx_repository = repository_rule(
    implementation = _nginx_repository_impl,
    attrs = {
        "build_file": attr.label(
            default = "@mod_pagespeed//bazel:nginx.BUILD",
            allow_single_file = True,
        ),
    },
    environ = ["NGINX_PATH"],
    local = True,
)

