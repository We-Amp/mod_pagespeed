# With bzlmod on, Bazel reads this file instead of WORKSPACE and does not
# append its built-in WORKSPACE suffix. Every repository now comes from
# MODULE.bazel (BCR modules and the non_bcr_deps extension in
# bazel/extensions.bzl). This file and WORKSPACE are deleted when WORKSPACE
# support is turned off.

workspace(name = "mod_pagespeed")
