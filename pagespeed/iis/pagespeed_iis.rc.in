// Generated from pagespeed_iis.rc.in by Bazel version_header() -- DO NOT EDIT.
//
// VS_VERSION_INFO resource for pagespeed_iis.dll. Embeds proper FILEVERSION
// + ProductVersion strings so Windows Installer's component-version logic
// orders releases correctly (beta.N has FILEVERSION 1,1,0,N -- strictly
// increasing across betas) and tools like Get-FileVersionInfo /
// File Properties dialog show useful version metadata.
//
// Before this resource was added, the DLL shipped with NO version info,
// which manifested as: MSI's REINSTALLMODE=omus default "overwrite-if-newer"
// silently skipping file replacement when both versions were empty/equal.
//
// We use literal hex values rather than #include <winver.h> to avoid
// needing the Windows SDK INCLUDE path on rc.exe's command line at
// Bazel-genrule execution time. The macro values are part of the
// stable Win32 ABI:
//   VS_FFI_FILEFLAGSMASK = 0x3FL
//   VS_FF_PRERELEASE     = 0x2L
//   VOS_NT_WINDOWS32     = 0x40004L
//   VFT_DLL              = 0x2L
//   VFT2_UNKNOWN         = 0x0L

1 VERSIONINFO
FILEVERSION    @MAJOR@,@MINOR@,@BUILD@,@FILEVERSION_BUILD@
PRODUCTVERSION @MAJOR@,@MINOR@,@BUILD@,@FILEVERSION_BUILD@
FILEFLAGSMASK  0x3FL
FILEFLAGS      @FILEVERSION_FLAGS@
FILEOS         0x40004L
FILETYPE       0x2L
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "@COMPANY_FULLNAME@ B.V."
            VALUE "FileDescription",  "PageSpeed for IIS Native Module"
            VALUE "FileVersion",      "@MAJOR@.@MINOR@.@BUILD@@PRERELEASE_SUFFIX@"
            VALUE "InternalName",     "pagespeed_iis"
            VALUE "LegalCopyright",   "@COPYRIGHT@"
            VALUE "OriginalFilename", "pagespeed_iis.dll"
            VALUE "ProductName",      "@PRODUCT_FULLNAME@ for IIS"
            VALUE "ProductVersion",   "@MAJOR@.@MINOR@.@BUILD@@PRERELEASE_SUFFIX@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        // 0x0409 = U.S. English, 0x04B0 (1200) = Unicode UTF-16
        VALUE "Translation", 0x409, 1200
    END
END
