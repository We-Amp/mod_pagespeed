    ],
    visibility = ["//visibility:public"],
    deps = [
        ":gtest_prod",
        ":pagespeed_base_core",
        ":scoped_memory_pool",
        ":std_timer",
        "@jsoncpp",
        "@com_google_protobuf//:protobuf",
    ] + select({
        # On Windows: no boringssl, no posix_timer
        "@platforms//os:windows": [],
        # On other platforms: use boringssl for crypto and posix_timer
        "//conditions:default": [
            ":posix_timer",
            "@boringssl//:ssl",
        ],
    }),
)
