        "source_map.cc",
        "split_statistics.cc",
        "split_writer.cc",
        "thread.cc",
        "waveform.cc",
        "wildcard.cc",
        "wildcard_group.cc",
    ] + select({
        # On Windows, use BCrypt-based MD5 implementation (no boringssl dependency)
        "@platforms//os:windows": ["md5_hasher_win.cc"],
        # On other platforms, use boringssl-based MD5 implementation
        "//conditions:default": ["md5_hasher.cc"],
    }),
    hdrs = [
        "arena.h",
        "atomic_bool.h",
        "atomic_int32.h",
        "atomicops.h",
        "base64_util.h",
        "cache_interface.h",
