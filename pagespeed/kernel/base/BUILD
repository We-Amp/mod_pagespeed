# Cross-platform timer using C++ standard library (std::chrono).
# Use this for Envoy filter builds and Windows support.
cc_library(
    name = "std_timer",
    srcs = ["std_timer.cc"],
    hdrs = ["std_timer.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":pagespeed_base_core",
    ],
)

# POSIX-specific timer using gettimeofday().
# Not available on Windows; use std_timer instead.
cc_library(
    name = "posix_timer",
    srcs = ["posix_timer.cc"],
    hdrs = ["posix_timer.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":pagespeed_base_core",
    ],
)

# Cross-platform memory pool abstraction.
# Provides similar functionality to APR pools using standard C++.
cc_library(
    name = "scoped_memory_pool",
    srcs = ["scoped_memory_pool.cc"],
    hdrs = ["scoped_memory_pool.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":pagespeed_base_core",
    ],
)

cc_library(
    name = "pagespeed_base",
    srcs = [
        "cache_interface.cc",
        "charset_util.cc",
        "checking_thread_system.cc",
        "chunking_writer.cc",
        "circular_buffer.cc",
        "condvar.cc",
        "countdown_timer.cc",
        "escaping.cc",
        "fast_wildcard_group.cc",
        "file_writer.cc",
        "function.cc",
        "hasher.cc",
        "hostname_util.cc",
        "json_writer.cc",
        "mapped_shared_string.cc",
        "named_lock_manager.cc",
        "request_trace.cc",
        "rolling_hash.cc",
        "sha1_signature.cc",
        "shared_string.cc",
