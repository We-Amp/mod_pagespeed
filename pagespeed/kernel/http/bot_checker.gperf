// bot_checker.cc is automatically generated from bot_checker.gperf.

#include "pagespeed/kernel/http/bot_checker.h"

#include <string.h>

#include "pagespeed/kernel/base/string_util.h"

namespace net_instaweb {
%}
%compare-strncmp
%define class-name RobotDetect
%define lookup-function-name Lookup
%global-table
%language=C++
%readonly-tables

%%
### These names are either application names or domain names of BOTs.
### This is not a complete list of BOTs names -- just the ones we want
### to scan for now.
about.ask.com
A6-Indexer
Apache-HttpClient
Arachni
AsyncHttpClient
BackRub
BingPreview
expo9
facebookexternalhit
facebookplatform
Feedfetcher-Google
Genieo
Google-StructuredDataTestingTool
HttpClient
Lycos
Mediapartners-Google
PHP
proximic
Python
Python-urllib
RPT-HTTPClient
Ruby
WordPress
Yahoo!
### Agent-era additions.
###
### Matching here is EXACT and CASE-SENSITIVE (%compare-strncmp), against the
### whole user agent and against each " /,;+()"-delimited token of it, so entries
### are listed in their wire casing and without version suffixes. Do NOT extend
### the case-insensitive bot/crawl/spider substring rule in Lookup() below to
### cover new clients: that rule already matches "bot" anywhere in the string
### (Abbott, Talkbot, robot, any product name spelling it out) and is the one
### unbounded false-positive source in this file.
###
### Clients whose token already contains bot, crawl or spider -- GPTBot,
### ClaudeBot, OAI-SearchBot, PerplexityBot, CCBot, Applebot(-Extended),
### Amazonbot, Bytespider, FirecrawlAgent and the rest of that cohort -- are
### deliberately NOT listed: the substring rule catches them, and a duplicate
### entry here would be dead weight that reads as coverage.
###
### User-triggered agent fetchers and agent infrastructure. These carry no
### bot/crawl/spider substring, which is exactly why they need entries.
ChatGPT-User
Claude-User
Claude-Web
Perplexity-User
### No Meta entry: both documented Meta agent user agents end in the crawler
### documentation URL ".../webmasters/crawler)", so the crawl substring already
### matches them -- the same reason Applebot-Extended is absent.
anthropic-ai
cohere-ai
GoogleOther
### Modern generic HTTP clients: the post-2015 analogues of Apache-HttpClient,
### Python-urllib, Ruby and PHP above. None of them render, so none of them
### should be trusted to report a critical-image or critical-CSS set.
Go-http-client
node-fetch
python-requests
axios
okhttp
undici
Scrapy
aiohttp
libwww-perl
HeadlessChrome
curl
Wget
%%

bool BotChecker::Lookup(const StringPiece& user_agent) {
  // Check if the user agent is empty, or contains bot / crawl / spider.
  if (user_agent.empty() ||
      FindIgnoreCase(user_agent, "bot") != StringPiece::npos ||
      FindIgnoreCase(user_agent, "crawl") != StringPiece::npos ||
      FindIgnoreCase(user_agent, "spider") != StringPiece::npos) {
    return true;
  }
  // check whether the whole string is in database
  if (RobotDetect::Lookup(user_agent.data(), user_agent.size()) != NULL) {
    return true;
  }
  // get the application_name/domain_name/email
  //
  // '(' and ')' are separators here because the overwhelmingly common shape for
  // an agent token is a parenthesised comment -- "Mozilla/5.0 (compatible;
  // GoogleOther)". Without them the final token is "GoogleOther)" and no exact
  // entry can ever match it. This separator set is local to BotChecker on
  // purpose; SplitStringPieceToVector's other callers are untouched.
  const char separator[] = " /,;+()";
  StringPieceVector names;
  SplitStringPieceToVector(user_agent, separator, &names, true);
  for (int i = 0, n = names.size(); i < n; ++i) {
    if (RobotDetect::Lookup(names[i].data(),
                            names[i].size()) != NULL) {
      return true;
    }
  }
  return false;
}

}  // namespace net_instaweb
