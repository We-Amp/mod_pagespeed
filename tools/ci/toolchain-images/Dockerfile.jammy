#
# Toolchain image for Ubuntu 22.04 (jammy): the pinned base image plus the compilers
# the nginx build recipe installs for this suite today (g++-13 from the Ubuntu
# toolchain PPA, clang 18 from apt.llvm.org). See bake-toolchain.sh.
#
# Build from the repository root:
#   docker build -f tools/ci/toolchain-images/Dockerfile.jammy .
#
# The jammy build leg builds in this image, by the digest in
# install/nginx/toolchain-images.lock (tools/ci/toolchain_image.sh).

# The base is pinned by digest (the index digest, so it is multi-arch).
FROM ubuntu:22.04@sha256:9abcaffc92a5279fff3a6a41635c0800ea33e528425fb389658806476e7defde

COPY install/nginx/build_module_in_container.sh /tmp/toolchain-recipe/build_module_in_container.sh
COPY tools/ci/toolchain-images/bake-toolchain.sh /tmp/toolchain-recipe/bake-toolchain.sh

RUN /tmp/toolchain-recipe/bake-toolchain.sh /tmp/toolchain-recipe/build_module_in_container.sh \
    && rm -rf /tmp/toolchain-recipe
