# Stands in for the BCR "zlib" module (see local_path_override in the root
# MODULE.bazel): every target that asks for @zlib gets zlib-ng, built in
# ZLIB_COMPAT mode, so only one deflate is linked.
module(
    name = "zlib",
    version = "1.3.2.bcr.2",
    compatibility_level = 1,
)

bazel_dep(name = "zlib-ng", version = "2.3.3.bcr.2")
