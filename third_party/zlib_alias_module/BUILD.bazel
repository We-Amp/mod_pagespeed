# The targets BCR zlib exports, aliased onto zlib-ng.
package(default_visibility = ["//visibility:public"])

alias(
    name = "zlib",
    actual = "@zlib-ng//:zlib-ng",
)

alias(
    name = "z",
    actual = "@zlib-ng//:zlib-ng",
)
