# The following .bazelrc content is forked from the main Envoy repository.                  # unique
# This is necessary since this needs to be available before we can access                   # unique
# the Envoy repository contents via Bazel.                                                  # unique
                                                                                            # unique
build:clang-asan --test_timeout=900                                                         # unique
build:clang-tsan --test_timeout=900,900,1800,3600                                           # unique
# See https://github.com/envoyproxy/nighthawk/issues/405                                    # unique
build:macos --copt -UDEBUG                                                                  # unique
                                                                                            # unique
# Envoy specific Bazel build/test options.

# Bazel doesn't need more than 200MB of memory for local build based on memory profiling:
# https://docs.bazel.build/versions/master/skylark/performance.html#memory-profiling
# The default JVM max heapsize is 1/4 of physical memory up to 32GB which could be large
# enough to consume all memory constrained by cgroup in large host.
# Limiting JVM heapsize here to let it do GC more when approaching the limit to
# leave room for compiler/linker.
# The number 3G is chosen heuristically to both support large VM and small VM with RBE.
# Startup options cannot be selected via config.
startup --host_jvm_args=-Xmx3g

# Bzlmod only (the Bazel 8 default; stated for clarity). Every dependency comes
# from MODULE.bazel: BCR modules plus the non_bcr_deps extension in
# bazel/extensions.bzl. WORKSPACE support is off.
common --enable_bzlmod
# Module registries, searched in this order. The BCR comes first and is named
# explicitly because a --registry flag replaces the default. Envoy's own
# registry follows it: Envoy 1.40 depends on modules that only exist there
# (the *.envoy versions, e.g. protobuf 35.1.bcr.envoy and googleurl). It is
# pinned to the commit Envoy's own .bazelrc names (the same in v1.40.0 and
# v1.40.1), so the module files it serves cannot change under us; move it
# together with the Envoy pin.
common --registry=https://bcr.bazel.build
common --registry=https://raw.githubusercontent.com/envoyproxy/bazel-registry/8ef390e133ec41491e397681c91c30e9cda1395a
# protoc comes from proto toolchain resolution: protobuf registers a prebuilt
# protoc (its release binary, sha256-pinned in protobuf's own tool_integrity
# table) and prefers it, as Envoy does. protoc is then never compiled. That is
# faster everywhere, and on Windows it is required: protobuf 35.1's protoc
# sources (compiler/java/full) fail clang-cl's include check there. The
# prebuilt protoc hashes come from the patch Envoy's registry applies to
# protobuf (35.1.bcr.envoy), not from upstream protobuf; they were checked
# against the published archives for Windows x64, Linux x64, Linux arm64 and
# macOS arm64. Plain BCR protobuf would need its own integrity data.
common --incompatible_enable_proto_toolchain_resolution
# CI (Linux) asserts MODULE.bazel.lock is current. Extension results are
# per-platform in the lock, so Windows/macOS stay in the default update mode.
common:ci_lock --lockfile_mode=error
common --noenable_workspace
# Bazel 8 flipped --incompatible_disallow_empty_glob to true. Keep the Bazel 7
# behavior so glob()s in our BUILD files and generated third-party build files
# that match nothing on some platforms don't become errors.
# TODO: remove once the third-party BUILD files generated in bazel/*.bzl no
# longer have empty globs.
common --noincompatible_disallow_empty_glob

run --color=yes

build --color=yes
build --workspace_status_command="bash bazel/get_workspace_status"
build --incompatible_strict_action_env
build --java_runtime_version=remotejdk_11
build --tool_java_runtime_version=remotejdk_11
# build --platform_mappings=""                                                               # unique
# silence absl logspam.
build --copt=-DABSL_MIN_LOG_LEVEL=4
build --define envoy_mobile_listener=enabled
build --experimental_repository_downloader_retries=2

# Pass PATH, CC, CXX and LLVM_CONFIG variables from the environment.
build --action_env=CC --host_action_env=CC
build --action_env=CXX --host_action_env=CXX
build --action_env=LLVM_CONFIG --host_action_env=LLVM_CONFIG
build --action_env=PATH --host_action_env=PATH

# Allow stamped caches to bust when local filesystem changes.
# Requires setting `BAZEL_VOLATILE_DIRTY` in the env.
build --action_env=BAZEL_VOLATILE_DIRTY --host_action_env=BAZEL_VOLATILE_DIRTY

# Prevent stamped caches from busting (eg in PRs)
# Requires setting `BAZEL_FAKE_SCM_REVISION` in the env.
build --action_env=BAZEL_FAKE_SCM_REVISION --host_action_env=BAZEL_FAKE_SCM_REVISION

build --enable_platform_specific_config
build --test_summary=terse

# TODO(keith): Remove once these 2 are the default
build --incompatible_config_setting_private_default_visibility
build --incompatible_enforce_config_setting_visibility

test --test_verbose_timeout_warnings

# Allow tags to influence execution requirements
common --experimental_allow_tags_propagation

# rules_foreign_cc's make and m4 toolchains default to building the BCR make
# and m4 modules for the exec configuration. Built with the image's default
# gcc (the lint compdb build), m4's gnulib sources fail to compile and make
# leaves SIGCHLD blocked in its children, which hangs cmake's link step.
# Linux hosts and build images ship both tools, so use the preinstalled ones.
build:linux --extra_toolchains=@rules_foreign_cc//toolchains:preinstalled_make_toolchain
build:linux --extra_toolchains=@rules_foreign_cc//toolchains:preinstalled_m4_toolchain
# Same for macOS: the BCR m4's generated gnulib spawn.h redeclares
# posix_spawn_file_actions_addchdir, which the macOS SDK also declares,
# so it fails to compile there. macOS ships m4, so use the preinstalled one.
build:macos --extra_toolchains=@rules_foreign_cc//toolchains:preinstalled_m4_toolchain

# Enable position independent code (this is the default on macOS and Windows)
# (Workaround for https://github.com/bazelbuild/rules_foreign_cc/issues/421)
build:linux --copt=-fPIC
build:linux --copt=-Wno-deprecated-declarations
# -Wdangling-reference is a GCC C++/ObjC++-only warning, so this suppression
# MUST be a --cxxopt, never a --copt. As a --copt it also lands on every C
# compile, where GCC answers with
#   cc1: warning: command-line option '-Wno-dangling-reference' is valid for
#        C++/ObjC++ but not for C
# That is harmless for our own C code, but rules_foreign_cc bakes the C copts
# into CMAKE_C_FLAGS for every cmake() dependency, and CMake's
# check_c_compiler_flag() treats that GNU "valid for ... but not for" line as a
# FAIL_REGEX hit. Every probe then reports the flag as unsupported, so libaom's
# require_c_flag(-std=c99) hard-fails configure on any leg that builds with
# plain host GCC. Clang legs never saw it because --config=clang
# adds -Wno-unknown-warning-option, which silences clang's equivalent complaint.
# Guarded by tools/assert-bazelrc-lang-flags.sh.
build:linux --cxxopt=-Wno-dangling-reference
build:linux --cxxopt=-std=c++20 --host_cxxopt=-std=c++20
build:linux --conlyopt=-fexceptions
build:linux --fission=dbg,opt
build:linux --features=per_object_debug_info
build:linux --action_env=BAZEL_LINKLIBS=-l%:libstdc++.a
build:linux --action_env=BAZEL_LINKOPTS=-lm

# --- Binary hardening -----------------------------------------------------
# Opt-in config applied to RELEASE/shipped builds (NOT sanitizer builds — see
# the FORTIFY=0 override on :sanitizer). The shipped artifacts are SHARED
# OBJECTS (libmod_pagespeed.so, ngx_pagespeed_module.so): already -fPIC
# (build:linux) and ET_DYN, so -pie/-fPIE do NOT apply to them. We add:
#   - _FORTIFY_SOURCE=2  : fortified libc calls (needs optimization; pair w/ -c opt)
#   - stack-protector-strong : stack canaries on at-risk frames
#   - full RELRO + BIND_NOW  : GOT/PLT read-only, resolve at load (no lazy clobber)
# Verified to land on the linked .so (readelf): GNU_RELRO segment, FLAGS_1 NOW,
# __stack_chk_fail, and _FORTIFY_SOURCE _chk symbols. These four are what
# tools/assert-binary-hardening.sh asserts on each shipped .so at release time.
build:hardening --copt=-D_FORTIFY_SOURCE=2
build:hardening --copt=-fstack-protector-strong
build:hardening --linkopt=-Wl,-z,relro
build:hardening --linkopt=-Wl,-z,now
# Branch-protection is arch-specific and BEST-EFFORT: the compiler instruments
# OUR code (x86-64 endbr / arm64 BTI landing pads + PAC), but the binary-level
# CET/BTI *enforcement* GNU-property note is only set when EVERY statically
# linked object (libstdc++.a, vendored C) is also branch-protection-compiled —
# which they are not — so readelf will not show the note. arm64 PAC still
# enforces intrinsically. Kept for the per-object hardening + forward-compat; the
# release-time assertion does NOT hard-fail on the absent note. Compose per arch:
#   x86-64 : --config=hardening --config=hardening-cet
#   arm64  : --config=hardening --config=hardening-bti
build:hardening-cet --copt=-fcf-protection=full
build:hardening-bti --copt=-mbranch-protection=standard

# We already have absl in the build, define absl=1 to tell googletest to use absl for backtrace.
build --define absl=1

# CRT for the AVIF codec stack. The AV1 codecs are built by cmake via
# rules_foreign_cc, which does not see Bazel's --features, so the CRT choice has
# to be mirrored into a --define that //bazel:windows_static_crt can select on.
# `static` matches the static_link_msvcrt feature --config=windows enables;
# --config=win-asan flips it to `dynamic` below, in step with the
# --features=-static_link_msvcrt it already sets. Declared as a plain `build`
# line so it lands before any --config expansion and stays order-independent.
build --define=avif_crt=static

# Disable ICU linking for googleurl.
build --@com_googlesource_googleurl//build_config:system_icu=0

# Common flags for sanitizers
build:sanitizer --define tcmalloc=disabled
build:sanitizer --linkopt -ldl
build:sanitizer --build_tag_filters=-no_san
build:sanitizer --test_tag_filters=-no_san
# _FORTIFY_SOURCE requires optimization and conflicts with ASan/MSan interceptors
# (false positives / build warnings). Force it OFF under every sanitizer so the
# :hardening config (FORTIFY=2) can never compose badly with a sanitizer build.
# This is the ONLY place FORTIFY is disabled; shipped builds get FORTIFY=2.
build:sanitizer --copt=-D_FORTIFY_SOURCE=0
# rules_foreign_cc passes the toolchain's compile flags, -no-canonical-prefixes
# included, to its CMake builds, and CMake repeats them on its link lines. With
# that flag a symlinked clang (the dev image's /opt/llvm/bin/clang) looks for
# its sanitizer runtimes next to the symlink instead of in its real resource
# directory, so the CMake compiler checks fail to link. A later
# -canonical-prefixes on the link line wins. Bazel's own links do not pass
# -no-canonical-prefixes, so it changes nothing for them.
build:sanitizer --linkopt=-canonical-prefixes

# Common flags for Clang
build:clang --action_env=BAZEL_COMPILER=clang
build:clang --action_env=CC=clang --action_env=CXX=clang++
build:clang --linkopt=-fuse-ld=lld
# Don't error on GCC-specific warning flags like -Wno-dangling-reference
build:clang --copt=-Wno-unknown-warning-option

# Flags for Clang + PCH
build:clang-pch --spawn_strategy=local
build:clang-pch --define=ENVOY_CLANG_PCH=1

# Use gold linker for gcc compiler.
build:gcc --linkopt=-fuse-ld=gold
# GCC 13 has full C++23 support including std::expected
build:gcc --action_env=CC=gcc-13 --action_env=CXX=g++-13

# Basic ASAN/UBSAN that works for gcc
build:asan --action_env=ENVOY_ASAN=1
build:asan --config=sanitizer
# ASAN install its signal handler, disable ours so the stacktrace will be printed by ASAN
build:asan --define signal_trace=disabled
build:asan --define ENVOY_CONFIG_ASAN=1
# -fsanitize=undefined was dropped from these two lines to allow CI/ASAN to    # unique
# pass, then re-added (UBSAN_OPTIONS below halts on any finding).               # unique
build:asan --copt -fsanitize=address --copt -fsanitize=undefined                            # unique
build:asan --linkopt -fsanitize=address --linkopt -fsanitize=undefined                      # unique
# vptr and function sanitizer are enabled in clang-asan if it is set up via bazel/setup_clang.sh.
build:asan --copt -fno-sanitize=vptr,function
build:asan --linkopt -fno-sanitize=vptr,function
build:asan --copt -DADDRESS_SANITIZER=1
build:asan --copt -DUNDEFINED_SANITIZER=1
build:asan --copt -D__SANITIZE_ADDRESS__
build:asan --test_env=ASAN_OPTIONS=handle_abort=1:allow_addr2line=true:check_initialization_order=true:strict_init_order=true:detect_odr_violation=1
build:asan --test_env=UBSAN_OPTIONS=halt_on_error=true:print_stacktrace=1
build:asan --test_env=ASAN_SYMBOLIZER_PATH
# ASAN needs -O1 to get reasonable performance.
build:asan --copt -O1
build:asan --copt -fno-optimize-sibling-calls

# Clang ASAN/UBSAN
build:clang-asan --config=clang-libstdcxx13
build:clang-asan --config=asan
build:clang-asan --linkopt -fuse-ld=lld

# macOS
build:macos --cxxopt=-std=c++20 --host_cxxopt=-std=c++20
# Apple clang's libc++ warns "The selected platform is no longer supported
# by libc++" in every TU that touches it when the deployment target is below
# its supported floor (the cc_configure default was 10.11; 171 such warnings
# in one full local build). 11.0 is the arm64 floor. macOS is a dev-only
# platform for this repo (shipped artifacts are Linux/Windows), so no
# shipped-artifact compatibility is affected.
build:macos --macos_minimum_os=11.0
build:macos --host_macos_minimum_os=11.0
build:macos --action_env=PATH=/opt/homebrew/bin:/opt/local/bin:/usr/local/bin:/usr/bin:/bin
build:macos --host_action_env=PATH=/opt/homebrew/bin:/opt/local/bin:/usr/local/bin:/usr/bin:/bin
build:macos --define tcmalloc=disabled
# Enable aligned allocation (required by absl). C++-only (clang rejects it for
# C), so --cxxopt, not --copt — see the -Wno-dangling-reference note above.
build:macos --cxxopt=-faligned-allocation --host_cxxopt=-faligned-allocation
# Suppress 'register' keyword errors from gperf-generated code (deprecated in
# C++17). -Wregister is C++/ObjC++-only, hence --cxxopt.
build:macos --cxxopt=-Wno-register --host_cxxopt=-Wno-register

# macOS ASAN/UBSAN
build:macos-asan --config=asan
# Workaround, see https://github.com/bazelbuild/bazel/issues/6932
build:macos-asan --copt -Wno-macro-redefined
build:macos-asan --copt -D_FORTIFY_SOURCE=0
# Dynamic link cause issues like: `dyld: malformed mach-o: load commands size (59272) > 32768`
build:macos-asan --dynamic_mode=off

# Clang TSAN
build:clang-tsan --config=clang-libstdcxx13
build:clang-tsan --action_env=ENVOY_TSAN=1
build:clang-tsan --config=sanitizer
build:clang-tsan --define ENVOY_CONFIG_TSAN=1
build:clang-tsan --copt -fsanitize=thread
build:clang-tsan --linkopt -fsanitize=thread
build:clang-tsan --linkopt -fuse-ld=lld
build:clang-tsan --copt -DTHREAD_SANITIZER=1
build:clang-tsan --build_tag_filters=-no_san,-no_tsan
build:clang-tsan --test_tag_filters=-no_san,-no_tsan
# Needed due to https://github.com/libevent/libevent/issues/777
build:clang-tsan --copt -DEVENT__DISABLE_DEBUG_MODE
# https://github.com/abseil/abseil-cpp/issues/760
# https://github.com/google/sanitizers/issues/953
build:clang-tsan --test_env="TSAN_OPTIONS=report_atomic_races=0:detect_deadlocks=0:suppressions=/src/tools/tsan_suppressions.txt"
# Symbolize TSan reports. The sanitizer runtime cannot find llvm-symbolizer
# under the hermetic PATH bazel hands to test actions, so forward an explicit
# path (TSAN_SYMBOLIZER_PATH, set in the environment like the ASAN/MSAN
# equivalents). Line tables keep file:line info in the reports without the
# full -g debug-info build cost.
build:clang-tsan --test_env=TSAN_SYMBOLIZER_PATH
build:clang-tsan --copt -gline-tables-only
# Bazel's default --strip=sometimes drops debug info in fastbuild, which
# would discard the line tables again at link time.
build:clang-tsan --strip=never

# Clang MSAN - to run this config without our build image, follow
# https://github.com/google/sanitizers/wiki/MemorySanitizerLibcxxHowTo
# with libc++ instruction and provide corresponding `--copt` and `--linkopt` as well.
build:clang-msan --action_env=ENVOY_MSAN=1
build:clang-msan --config=sanitizer
build:clang-msan --define ENVOY_CONFIG_MSAN=1
build:clang-msan --copt -fsanitize=memory
build:clang-msan --linkopt -fsanitize=memory
build:clang-msan --linkopt -fuse-ld=lld
build:clang-msan --copt -fsanitize-memory-track-origins=2
build:clang-msan --copt -DMEMORY_SANITIZER=1
build:clang-msan --test_env=MSAN_SYMBOLIZER_PATH
# MSAN needs -O1 to get reasonable performance.
build:clang-msan --copt -O1
build:clang-msan --copt -fno-optimize-sibling-calls

# Clang with libc++
build:libc++ --config=clang
build:libc++ --action_env=CXXFLAGS=-stdlib=libc++
build:libc++ --action_env=LDFLAGS=-stdlib=libc++
build:libc++ --action_env=BAZEL_CXXOPTS=-stdlib=libc++
build:libc++ --action_env=BAZEL_LINKLIBS=-l%:libc++.a:-l%:libc++abi.a
build:libc++ --action_env=BAZEL_LINKOPTS=-lm:-pthread
build:libc++ --define force_libcpp=enabled

# Optimize build for binary size reduction.
build:sizeopt -c opt --copt -Os

# Test options
build --test_env=HEAPCHECK=normal --test_env=PPROF_PATH

# Coverage options
coverage --config=coverage
coverage --build_tests_only
build:coverage --action_env=BAZEL_USE_LLVM_NATIVE_COVERAGE=1
build:coverage --action_env=GCOV=llvm-profdata
build:coverage --copt=-DNDEBUG
# 1.5x original timeout + 300s for trace merger in all categories
build:coverage --test_timeout=390,750,1500,5700
build:coverage --define=dynamic_link_tests=true
build:coverage --define=ENVOY_CONFIG_COVERAGE=1
build:coverage --cxxopt="-DENVOY_CONFIG_COVERAGE=1"
build:coverage --test_env=HEAPCHECK=
build:coverage --combined_report=lcov
build:coverage --strategy=TestRunner=sandboxed,local
build:coverage --strategy=CoverageReport=sandboxed,local
build:coverage --experimental_use_llvm_covmap
build:coverage --collect_code_coverage
build:coverage --test_tag_filters=-nocoverage
build:coverage --instrumentation_filter="//source(?!/common/quic/platform)[/:],//envoy[/:],//contrib(?!/.*/test)[/:]"
build:test-coverage --test_arg="-l trace"
build:test-coverage --test_arg="--log-path /dev/null"
build:fuzz-coverage --config=plain-fuzzer
build:fuzz-coverage --run_under=@envoy//bazel/coverage:fuzz_coverage_wrapper.sh

# CI configurations
# Note this config is used by mobile CI also.
build:ci --noshow_progress
build:ci --noshow_loading_progress

# Full-tier Linux job configs (pipeline-full.yml); tools/ci/bisect-job.sh runs
# the same configs. External services and the remote-cache choice stay on the
# command line.
build:ci-build --action_env=CC=clang --action_env=CXX=clang++

build:ci-asan --config=clang-asan
build:ci-asan --action_env=CC=clang --action_env=CXX=clang++
build:ci-asan --keep_going
# test: lines expand after the build: ones, so these win over build:asan's
# ASAN_OPTIONS and UBSAN_OPTIONS.
test:ci-asan --test_env=ASAN_OPTIONS=check_initialization_order=1:detect_leaks=1
test:ci-asan --test_env=LSAN_OPTIONS=suppressions=/workspace/tools/lsan_suppressions.txt
test:ci-asan --test_env=UBSAN_OPTIONS=halt_on_error=true:print_stacktrace=1:suppressions=/workspace/tools/ubsan_suppressions.txt

build:ci-tsan --config=clang-tsan
build:ci-tsan --action_env=CC=clang --action_env=CXX=clang++
build:ci-tsan --keep_going
# Wins over build:clang-tsan's TSAN_OPTIONS (see test:ci-asan above).
test:ci-tsan --test_env=TSAN_OPTIONS=report_atomic_races=0:detect_deadlocks=0:suppressions=/workspace/tools/tsan_suppressions.txt:external_symbolizer_path=/opt/llvm/bin/llvm-symbolizer

# Fuzz builds

# Shared fuzzing configuration.
build:fuzzing --define=ENVOY_CONFIG_ASAN=1
build:fuzzing --copt=-DFUZZING_BUILD_MODE_UNSAFE_FOR_PRODUCTION
build:fuzzing --config=libc++

# Fuzzing without ASAN. This is useful for profiling fuzzers without any ASAN artifacts.
build:plain-fuzzer --config=fuzzing
build:plain-fuzzer --define=FUZZING_ENGINE=libfuzzer
# The fuzzing rules provide their own instrumentation, but it is currently
# disabled due to bazelbuild/bazel#12888. Instead, we provide instrumentation at
# the top level through these options.
build:plain-fuzzer --copt=-fsanitize=fuzzer-no-link
build:plain-fuzzer --linkopt=-fsanitize=fuzzer-no-link

build:asan-fuzzer --config=plain-fuzzer
build:asan-fuzzer --config=clang-asan
build:asan-fuzzer --copt=-fno-omit-frame-pointer
# Remove UBSAN halt_on_error to avoid crashing on protobuf errors.
build:asan-fuzzer --test_env=UBSAN_OPTIONS=print_stacktrace=1

# OSS-Fuzz (.oss-fuzz/build.sh). The compiler, sanitizer and engine flags
# of an OSS-Fuzz build come from its environment and go in on the command
# line; this config carries what the tree needs on top of them there: the
# builder's own libc++ behind its clang, linked statically because the runner
# image has no libc++.so; the tree's own libraries linked in, not as shared
# objects; no debug-info splitting (a .dwo never reaches the output); and no
# _FORTIFY_SOURCE, which -c opt would turn on and which conflicts with the
# sanitizer interceptors. It does not use --config=clang, which pins CC/CXX
# to plain clang, while the AFL++ and honggfuzz builds set them to their
# compiler wrappers.
build:oss-fuzz --action_env=BAZEL_COMPILER=clang
build:oss-fuzz --action_env=BAZEL_CXXOPTS=-stdlib=libc++
build:oss-fuzz --action_env=BAZEL_LINKLIBS=-l%:libc++.a:-l%:libc++abi.a
build:oss-fuzz --action_env=BAZEL_LINKOPTS=-lm:-pthread
build:oss-fuzz --copt=-Wno-unknown-warning-option
build:oss-fuzz --copt=-U_FORTIFY_SOURCE
build:oss-fuzz --linkopt=-fuse-ld=lld
build:oss-fuzz --dynamic_mode=off
build:oss-fuzz --fission=no
build:oss-fuzz --strip=never

# Compile database generation config
build:compdb --build_tag_filters=-nocompdb

# Windows build quirks
build:windows --action_env=TMPDIR
build:windows --action_env=PROGRAMFILES=C:/progra~1
build:windows --define signal_trace=disabled
build:windows --define hot_restart=disabled
build:windows --define tcmalloc=disabled
build:windows --define wasm=disabled
build:windows --define manual_stamp=manual_stamp
build:windows --cxxopt="/std:c++20"
build:windows --host_cxxopt="/std:c++20"
build:windows --output_groups=+pdb_file
# Windows PageSpeed: Exclude Apache module (POSIX-only), use cross-platform Std* implementations
build:windows --define=apache_module=false

# TODO(wrowe,sunjayBhatia): Resolve bugs upstream in curl and rules_foreign_cc
# See issue https://github.com/bazelbuild/rules_foreign_cc/issues/301
build:windows --copt="-DCARES_STATICLIB"
build:windows --copt="-DNGHTTP2_STATICLIB"
build:windows --copt="-DCURL_STATICLIB"

# Override any clang preference if building msvc-cl
# Drop the determinism feature (-DDATE etc are a no-op in msvc-cl)
build:msvc-cl --action_env=USE_CLANG_CL=""
build:msvc-cl --define clang_cl=0
build:msvc-cl --features=-determinism

# Windows build behaviors when using clang-cl
build:clang-cl --action_env=USE_CLANG_CL=1
build:clang-cl --define clang_cl=1

# Required to work around Windows clang-cl build defects
# Ignore conflicting definitions of _WIN32_WINNT
# Override determinism flags (DATE etc) is valid on clang-cl compiler
build:clang-cl --copt="-Wno-macro-redefined"
build:clang-cl --copt="-Wno-builtin-macro-redefined"
# Workaround problematic missing override declarations of mocks
# TODO: resolve this class of problematic mocks, e.g.
# ./test/mocks/http/stream.h(16,21): error: 'addCallbacks'
#     overrides a member function but is not marked 'override'
#   MOCK_METHOD(void, addCallbacks, (StreamCallbacks & callbacks));
# -Winconsistent-missing-override is a C++-only clang warning, hence --cxxopt.
build:clang-cl --cxxopt="-Wno-inconsistent-missing-override"

# Defaults to 'auto' - Off for windows, so override to linux behavior
build:windows --enable_runfiles=yes

# This should become adopted by bazel as the default
build:windows --features=compiler_param_file

# These options attempt to force a monolithic binary including the CRT
build:windows --features=fully_static_link
build:windows --features=static_link_msvcrt
build:windows --dynamic_mode=off

# Windows AddressSanitizer via clang-cl (runtime half of the Windows
# memory-safety hardening; the compile-time half is --config=win-analyze below)
# Detects heap/stack buffer overflows, use-after-free, use-after-return.
# Uses clang-cl (not MSVC cl.exe) because the codebase and its dependencies
# (abseil, libpsl) rely on GCC/Clang extensions (__inline__, sanitizer headers)
# that MSVC does not support. Use alongside --config=clang-cl.
# Scope ASan instrumentation to project sources only — not external deps.
# rules_foreign_cc (curl cmake) fails if ASan flags leak into CMake's
# configure test binaries (__asan_init undefined). Using per_file_copt
# restricts -fsanitize=address to project and third_party sources.
build:win-asan --per_file_copt=//pagespeed/.*,//net/.*,//third_party/.*,//test/.*@-fsanitize=address
build:win-asan --per_file_copt=//pagespeed/.*,//net/.*,//third_party/.*,//test/.*@-fno-sanitize=vptr
build:win-asan --per_file_copt=//pagespeed/.*,//net/.*,//third_party/.*,//test/.*@-fno-sanitize=function
build:win-asan --per_file_copt=//pagespeed/.*,//net/.*,//third_party/.*,//test/.*@-fno-sanitize-blacklist
# Link clang's ASan runtime explicitly. Bazel invokes lld-link directly (not
# via clang-cl driver), so -fsanitize=address as a linkopt is meaningless.
# We must pass the .lib files and their search path directly.
# Use 8.3 short path to avoid spaces in LIBPATH (bazelrc can't quote linkopt values)
build:win-asan --linkopt=/LIBPATH:C:/PROGRA~1/LLVM/lib/clang/19/lib/windows
build:win-asan --linkopt=clang_rt.asan_dynamic-x86_64.lib
build:win-asan --linkopt=clang_rt.asan_dynamic_runtime_thunk-x86_64.lib
# Suppress MSVC's stl_asan.lib (x64 version not installed, not needed with clang runtime)
build:win-asan --linkopt=/NODEFAULTLIB:stl_asan.lib
build:win-asan --linkopt=/INCREMENTAL:NO
build:win-asan --linkopt=/DEBUG
build:win-asan --strip=never
build:win-asan --build_tag_filters=-no_san
build:win-asan --test_tag_filters=-no_san
build:win-asan --copt=-DADDRESS_SANITIZER=1
build:win-asan --copt=-D__SANITIZE_ADDRESS__
# Test binaries need the ASan runtime DLL on PATH at runtime.
build:win-asan --test_env=PATH=C:\\PROGRA~1\\LLVM\\lib\\clang\\19\\lib\\windows;C:\\PROGRA~1\\LLVM\\bin;C:\\Windows\\System32
# ASan needs -O1 for reasonable performance (default /Od is very slow)
build:win-asan --copt=-O1
# ASan needs the dynamic CRT (static CRT is incompatible with ASan DLL model)
build:win-asan --features=-fully_static_link
build:win-asan --features=-static_link_msvcrt
# ...and the same for the cmake-built AV1 codecs, which cannot see --features.
# Without this they keep the static CRT: lld-link downgrades the mix to the
# LNK4098 *warning*, so the leg stays green while ASan's interceptors -- which
# hook the dynamic CRT -- stop covering allocations inside the codec.
build:win-asan --define=avif_crt=dynamic
build:win-asan --dynamic_mode=off

# Windows MSVC /analyze static analysis (compile-time half of the Windows
# memory-safety hardening; the runtime half is --config=win-asan above)
# Zero-cost compile-time detection of null derefs, buffer overruns, UB patterns.
# Can be added to regular Windows builds (no separate pass needed).
build:win-analyze --copt=/analyze
build:win-analyze --copt=/analyze:external-

# Zig cross-compilation from Linux to Windows (MinGW ABI).
# Requires hermetic_cc_toolchain as a bazel_dep; see bazel/zig_toolchain.bzl.
# Usage: bazel build --config=zig-windows //pagespeed/windows:pagespeed_c_api
#
# NOTE: Does NOT inherit from build:windows because that uses MSVC-style flags
# (e.g., /std:c++20) which Zig doesn't understand. Zig uses GCC-style flags.
build:zig-windows --incompatible_enable_cc_toolchain_resolution
build:zig-windows --platforms=@zig_sdk//platform:windows_amd64
build:zig-windows --extra_toolchains=@zig_sdk//toolchain:windows_amd64
# Host toolchain uses Linux GCC-13 for tools (default gcc is too old for C++20)
# Must set action_env for both host and target; Bazel's toolchain detection uses these
build:zig-windows --action_env=CC=gcc-13
build:zig-windows --action_env=CXX=g++-13
build:zig-windows --host_action_env=CC=gcc-13
build:zig-windows --host_action_env=CXX=g++-13
build:zig-windows --host_cxxopt=-std=c++20
# C++ standard for cross-compiled code (Zig uses GCC-style flags, not MSVC)
build:zig-windows --cxxopt=-std=c++20
# Windows-specific defines (copied from build:windows but without MSVC flags)
build:zig-windows --define signal_trace=disabled
build:zig-windows --define hot_restart=disabled
build:zig-windows --define tcmalloc=disabled
build:zig-windows --define wasm=disabled
build:zig-windows --define=apache_module=false
build:zig-windows --copt=-DCARES_STATICLIB
build:zig-windows --copt=-DNGHTTP2_STATICLIB
build:zig-windows --copt=-DCURL_STATICLIB
build:zig-windows --enable_runfiles=yes
build:zig-windows --dynamic_mode=off
# Windows API level (Windows 7+) and common defines
build:zig-windows --copt=-D_WIN32_WINNT=0x0601
build:zig-windows --copt=-DNOMINMAX
build:zig-windows --copt=-DWIN32_LEAN_AND_MEAN
# Define WIN32 for code that checks it (Zig/MinGW only defines _WIN32)
build:zig-windows --copt=-DWIN32
# Note: Boringssl is NOT used on Windows - we use Windows BCrypt API instead.
# This avoids pthread issues with Zig's MinGW target.
# No POSIX shared memory on Windows
build:zig-windows --copt=-DPAGESPEED_SUPPORT_POSIX_SHARED_MEM=0
# Disable POSIX-only memcached backend
build:zig-windows --define=enable_memcached=false

# Envoy filter builds (//pagespeed/envoy/..., //test/pagespeed/envoy/...)
# against Envoy 1.40 from MODULE.bazel.
build:envoy-filter --config=clang-libstdcxx13
# Envoy's io_uring support (liburing) needs Linux 5.6+ UAPI headers
# (linux/openat2.h) that the dev image's Ubuntu 20.04 lacks; the filter does
# not use io_uring.
build:envoy-filter --@envoy//bazel:enable_liburing=false

try-import %workspace%/clang.bazelrc
try-import %workspace%/local_tsan.bazelrc

###### modifications for pagespeed
import %workspace%/pagespeed.bazelrc

# User overrides (imported last so they can override pagespeed.bazelrc settings)
try-import %workspace%/user.bazelrc
