{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PageSpeed": {
    "Enabled": true,
    "RewriteLevel": "CoreFilters",
    "Sidecar": {
      "Mode": "Process",
      "BinaryPath": "/opt/ps/nginx",
      "ModulePath": "/opt/ps/ngx_pagespeed_module.so",
      "ConfigDirectory": "/opt/ps/run",
      "ListenPort": 8080,
      "OriginPort": 0,
      "AutoRestart": false,
      "HealthCheckIntervalMs": 5000,
      "StartupTimeoutMs": 30000
    },
    "Cache": {
      "FileCachePath": "/opt/ps/run/cache",
      "LogDirectory": "/opt/ps/run/logs",
      "LruCacheSizeKb": 512000,
      "FileCacheSizeKb": 10240000
    },
    "Domains": {
      "AuthorizedDomains": [
        "localhost",
        "127.0.0.1"
      ]
    },
    "AdminAuth": {
      "Enabled": true,
      "RateLimitRpm": 60
    },
    "ExcludePaths": [
      "^/api/"
    ]
  }
}
