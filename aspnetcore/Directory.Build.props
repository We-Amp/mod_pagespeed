<Project>

  <!--
    Shared build + NuGet packaging properties for the ASP.NET Core nginx sidecar.
    Mirrors pagespeed-optimizer/samples/aspnetcore/Directory.Build.props with two
    deliberate sidecar divergences:
      * LICENSE/NOTICE/THIRD-PARTY-NOTICES/icon/README are referenced SAME-DIR via
        $(MSBuildThisFileDirectory)<file> — NOT 2.0's `../../<file>`. 2.0's props
        lives two dirs above its repo-root LICENSE; this props lives at aspnetcore/,
        so `../../` would resolve OUTSIDE the repo. Same-dir is robust regardless of
        each packable project's depth.
      * The LICENSE/NOTICE/THIRD-PARTY-NOTICES live next to THIS file.
    Package metadata applies only to packable projects (IsPackable != false); the
    test + sample projects opt out via <IsPackable>false</IsPackable>.
  -->

  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <!-- NM-3: the content-only NativeAssets package opts OUT of the shared consumer
         README (it documents the AddPageSpeed()/UsePageSpeed() managed API that package
         does not expose). The decision is made HERE, keyed on the project name, rather
         than in the child csproj: this props is imported BEFORE the child's PropertyGroup,
         so a child-set PackThinReadme would not be visible to the PackageReadmeFile
         *property* condition below (property-evaluation phase) even though it would be
         visible to the *item* condition — leaving PackageReadmeFile pointing at a README
         that isn't packed (NU5039). MSBuildProjectName is stable across both phases. -->
    <PackThinReadme Condition="'$(PackThinReadme)' == '' and '$(MSBuildProjectName)' == 'WeAmp.PageSpeed.Sidecar.NativeAssets.Linux'">false</PackThinReadme>
    <!-- The package version is the mod_pagespeed product version: the version of the module
         release whose native pair the package carries. The release lane passes it explicitly;
         this default is only the version of the tree (net/instaweb/public/VERSION) for local
         builds. It is not a releasable version: module release 2.5.0 carries no native pair,
         so the first package on the product version is 2.6.0, packed from module 2.6.0. No
         fourth digit (the 1.15.0.x packaging revisions have ended) and no +rN. -->
    <Version>2.5.0</Version>
    <Authors>We-Amp</Authors>
    <Company>We-Amp B.V.</Company>
    <Copyright>Copyright (c) 2024-2026 We-Amp B.V.</Copyright>
    <!-- Apache-2.0 is on NuGet's SPDX allow-list, so the license ships as an SPDX
         expression; the LICENSE and NOTICE files are still packed (see below). -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://modpagespeed.com/</PackageProjectUrl>
    <!-- Both the PackageReadmeFile designation and the packed file (below) are gated on
         PackThinReadme (set above) so pack stays consistent — a designated-but-unpacked
         README is NU5039. PackThinReadme=false ⇒ no readme (NM-3). -->
    <PackageReadmeFile Condition="'$(PackThinReadme)' != 'false'">README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>2.7.0 (engine 2.7.0, bundled nginx 1.30.6): the package follows the mod_pagespeed 2.7.0 release and carries the native pair of that release. Security: the native engine carries the module security fixes of mod_pagespeed 2.7.0; update recommended. Behaviour: the X-Page-Speed response header now reports on instead of the product version by default, and detection by the presence of the header is unchanged. The bundled nginx sizes its optimization threads from the machine, so on a machine with several CPU cores it runs more of them and uses more CPU while its cache warms. The native nginx module is built with full RELRO. Full notes: https://modpagespeed.com/docs/release-notes/

2.6.0 (engine 2.6.0, bundled nginx 1.30.6): the package moves to the mod_pagespeed product version, so it now carries the version of the module release it is built from, and the fourth-digit packaging revisions end; NuGet orders it after 1.17.0, and a reference pinned to 1.* does not pick it up. The native pair (nginx, the module built against it and the launch shim) is built and tested by the module release, live nginx tests included. Security: the sidecar information endpoint (MapPageSpeedInfo) requires authorization by default (an app without authentication passes requireAuthorization: false); the generated configuration directory and file are created owner-only and replaced atomically; loopback-only checks use the connection's own address; and the native engine carries the module security fixes of mod_pagespeed 2.3.0, 2.4.0 and 2.5.0, and the two nginx-module security fixes of 2.6.0. The bundled nginx moves from 1.30.4 to 1.30.6 (two memory-safety fixes of 1.30.6, and CVE-2026-90439 of 1.30.5 in the HTTP/3 module, which the bundled nginx does not build). Update recommended. Action required: check your ExcludePaths entries: every entry is now a path prefix (/api/) or a glob (/admin/*, *.json); regular-expression entries such as ^/api/ fail at startup with a message naming the accepted syntax, and a regular expression built only from allowed characters is read as a glob (a startup warning flags entries containing .* or .+), so /api/.* must become /api/; with UseForwardedHeaders() before UsePageSpeed(), raw-origin requests are rejected with 421; call UsePageSpeed() first; HealthCheckIntervalMs, HealthCheckTimeoutMs and ShutdownTimeoutMs must be positive and at most ten minutes, or the app fails at startup; on slow hosts raise StartupTimeoutMs, since a restart that misses its startup deadline now ends in the failed state instead of bypassing optimization. The disk cache moves to a new format and starts empty once. Fixes: optimized requests keep the client's scheme behind a TLS terminator (Inverse mode), which ends the redirect loop with UseHttpsRedirection(); the middleware and the generated nginx configuration exclude exactly the same paths; a stuck nginx -t validation is killed and reported, with the new option PageSpeed:Sidecar:ConfigValidationTimeoutMs (default 60 seconds); a restart that misses its startup deadline is stopped and retried. Supported hosts: Debian 11 and 12 and Ubuntu 20.04 to 24.04 (glibc 2.31 or newer, and libpcre3, which the bundled nginx links as libpcre.so.3); Debian 13, Ubuntu 26.04, Enterprise Linux and Amazon Linux, the last two named in earlier notes, lack libpcre.so.3 and are not supported. Full notes: https://modpagespeed.com/docs/release-notes/

1.17.0 (engine v1.17.0, bundled nginx 1.30.4): the package follows the mod_pagespeed 1.17.0 release and is licensed under the Apache License 2.0; LICENSE and NOTICE ship in the package. Licensing is removed from the package and from the bundled module: the retired licensing settings are accepted and ignored, so existing appsettings configuration keeps working (setting them in code now raises an obsolete-member warning). Security: the bundled nginx moves from 1.30.3 to 1.30.4 (CVE-2026-42533), and the native engine carries the 1.17.0 security fixes, among them a denial-of-service fix in the nginx module, cache-integrity and information-disclosure fixes for in-place optimization, request-forgery hardening of the admin console, and the bundled HTTPS fetch library updated to curl 8.22.0; update recommended. Reliability: a worker process that starts at an unlucky moment no longer hangs, and a process that dies while holding a shared-memory lock no longer hangs the others. After updating, if you set Cache.FileCachePath or Sidecar.ConfigDirectory (so the disk cache persists across restarts): the disk cache moves to a new format and starts empty once; also flush it once (touch cache.flush in the cache directory) so entries recorded by earlier releases are dropped. With the default per-process cache location there is nothing to do. Full notes: https://modpagespeed.com/docs/release-notes/#v1-17-0

1.15.0.7 (packaging revision; engine v1.15.0+r18, bundled nginx 1.30.3): native-engine refresh from r17 to r18. Serving performance: cached resources are served with substantially less copying, including an experimental zero-copy serve mode for memory-mapped cache hits, and HTTP/2 and HTTP/3 cached serves stream through a bounded copy ring. Caching: metadata and page-property entries move to a dedicated small-object tier so they stay warm across restarts independent of payload traffic (on file caches of ~256 MB or larger the first restart after upgrading rebuilds the payload cache once; set FileCacheSmallTierPercent 0 to disable), and the default file cache size is raised to 1 GB. Correctness: stricter configuration validation (out-of-range option values now fail configuration load, and an invalid ?PageSpeedFilters= name consistently rejects the query), critical-CSS and Content-Security-Policy fixes (script-injecting filters back off under a restrictive policy when HonorCsp is enabled), a native loading="lazy" mode for lazyload_images, and the legacy JavaScript minifier now passes template literals through unmodified. Security hardening across input validation and output escaping, an updated bundled HTTPS fetch library (curl 8.21.0), and cache-library fixes including a concurrent-startup initialization race; update recommended. The embedded admin console also gets a reliability and usability pass. No change to the bundled nginx (still 1.30.3) and no managed-code changes; 1.15.0 installs keep working.

1.15.0.6 (packaging revision; engine v1.15.0+r17, bundled nginx 1.30.3): security fix in the bundled nginx module — a malformed request could crash an nginx worker process (remotely triggerable denial of service, no authentication required); update strongly recommended. Optimization and page-property caches now persist across restarts, so the server comes back warm after a restart or deploy instead of re-optimizing from scratch. Also includes the engine's experimental, default-off Web Bot Auth updates (real-world signer interop and the opt-in AI-crawl counter). No change to the bundled nginx (still 1.30.3) and no managed-code changes; 1.15.0 installs keep working.

1.15.0.5 (packaging revision; engine v1.15.0+r16, bundled nginx 1.30.3): security-maintenance update to the bundled reverse proxy. The bundled nginx moves from 1.30.2 to 1.30.3 on the 1.30 stable branch, picking up upstream fixes for a buffer-overflow issue in nginx's upstream proxy/gRPC handling (CVE-2026-42055) and a lower-severity charset buffer-overread (CVE-2026-48142); update recommended. No change to optimization behavior and no managed-code changes — the native engine is unchanged (v1.15.0+r16). 1.15.0 installs keep working.

1.15.0.4 (packaging revision; engine v1.15.0+r16, bundled nginx 1.30.2): native-engine refresh from r15 to r16, with no change to optimization behavior or bundled nginx (still 1.30.2). This build picks up minor engine correctness and shutdown-path hardening from r16. No managed-code changes; 1.15.0 installs keep working.

1.15.0.3 (packaging revision; engine v1.15.0+r15, bundled nginx 1.30.2): native-engine refresh from r10 to r15 — a security-maintenance update to the bundled module, with no change to optimization behavior or bundled nginx (still 1.30.2). The shipped .so is now built with binary hardening (full RELRO/BIND_NOW, -fstack-protector-strong, _FORTIFY_SOURCE=2, and CET/BTI), asserted on every release artifact. The rewrite path picks up memory-safety and resource-exhaustion fixes, along with explicit bounds on header count and HTML nesting depth; update recommended. The module's attack surface is further reduced by removing unused third-party components and updating the remaining vendored dependencies to maintained versions. No managed-code changes; 1.15.0 installs keep working.

1.15.0.2 (packaging revision; engine v1.15.0+r10, bundled nginx 1.30.2): NuGet packaging refresh on the same native engine as 1.15.0.1.

1.15.0.1 (packaging revision; engine v1.15.0+r10, bundled nginx 1.30.2): refreshed embedded admin console. The native engine also picks up the runtime ABI guard (inert for the bundled matched pair; relevant only in External mode against a drifted host nginx). No managed-code changes; 1.15.0 installs keep working.

1.15.0 (GA): the Inverse topology is the default. Add services.AddPageSpeed(config) + app.UsePageSpeed() to your ASP.NET Core app and your Kestrel server stays the public front door — it owns the listening socket, TLS, auth and routing exactly as before. The bundled nginx + ngx_pagespeed runs loopback-only behind your app as an optimize-proxy: the middleware streams optimizable responses over loopback (YARP) to nginx, which optimizes and proxy_pass-es back to a private raw-origin Kestrel endpoint where the middleware bypasses itself. Non-optimizable requests, and any request while the sidecar isn't running, pass straight through un-optimized (always-functional). By default (Sidecar.OwnPublicPort = true) the package binds the public port (Sidecar.ListenPort, 8080) as a code endpoint; set OwnPublicPort = false to bind it yourself via Kestrel:Endpoints (e.g. for in-process TLS). For edge TLS, front the public port with a terminator or load balancer; the loopback hop to nginx is plain HTTP with a single validated X-Forwarded-Proto so optimized asset URLs root at the public scheme.

Zero-config host handling (forward-all): optimization works for any host your app serves with no domain configuration, because the module implicitly authorizes each request's own same-origin resources. Domains.AuthorizedDomains is not a setup step; localhost is always optimized. Defense-in-depth: set Sidecar.RestrictToAuthorizedHosts = true to optimize only hosts you list. The /pagespeed_* admin endpoints return 404 from the public front door by default; set Sidecar.AllowPublicAdmin = true (requires AdminAuth.Enabled) to expose them behind the bearer token.

Modes: Inverse (default), Process (the classic front-proxy where nginx is the public front door — still supported), and External (operator-managed nginx). Docker is reserved and fails validation.

The bundled nginx is on the 1.30 stable branch (1.30.3). A native pagespeed-nginx-launch shim, on by default (Sidecar.UseLaunchShim), arms PR_SET_PDEATHSIG so the bundled nginx can't be orphaned (and hold its loopback port) if the host process is hard-killed (SIGKILL/OOM/container hard-stop) once launch has settled; the bundled runtime identifier (RID) is derived at runtime so the matched nginx resolves on linux-arm64 as well as linux-x64; and a per-RID build-info.json provenance manifest is emitted. The native engine targets a glibc 2.31 floor with statically-linked libstdc++ and no OpenSSL host dependency, so it loads on Debian 11/12, Ubuntu 20.04+, RHEL/Alma 9 and Amazon Linux 2023. A single dotnet add package auto-pulls the native engine; binaries are stripped (debug archived separately). This package is mod_pagespeed 1.15 (jpeg/png/webp recompression, CSS/JS minification, critical-CSS inlining, Core-Web-Vitals HTML rewriting), and the bundled nginx module transcodes AVIF through opt-in filters.</PackageReleaseNotes>
    <!-- No repository metadata in the package (the optimizer's packages carry none either) —
         strip ALL git-detected repository metadata.
         Belt-and-braces: kill SourceLink auto-detection, then null the fields in a
         late-binding target before GenerateNuspec emits them (mirrors 2.0). -->
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- The authoritative kill-switch: stop the SDK's _InitializeSourceControlInformation
         from populating SourceRevisionId/RepositoryCommit at the SOURCE. Without this,
         that target runs AFTER the BeforeTargets="GenerateNuspec" blanking below and
         re-injects the private-repo HEAD SHA into <repository commit> (observed in
         1.15.0-preview.1). Also suppress the nuspec <repository> element entirely. -->
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <IncludeRepositoryUrlInNuspec>false</IncludeRepositoryUrlInNuspec>
    <EnableSourceLink>false</EnableSourceLink>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <DeterministicSourcePaths>false</DeterministicSourcePaths>
    <SourceRevisionId></SourceRevisionId>
    <RepositoryUrl></RepositoryUrl>
    <RepositoryType></RepositoryType>
    <RepositoryCommit></RepositoryCommit>
    <RepositoryBranch></RepositoryBranch>
  </PropertyGroup>

  <Target Name="ClearPrivateRepositoryMetadata"
          BeforeTargets="GenerateNuspec;_GetPackageFiles"
          Condition="'$(IsPackable)' != 'false'">
    <PropertyGroup>
      <RepositoryUrl></RepositoryUrl>
      <RepositoryType></RepositoryType>
      <RepositoryCommit></RepositoryCommit>
      <RepositoryBranch></RepositoryBranch>
      <SourceRevisionId></SourceRevisionId>
      <PrivateRepositoryUrl></PrivateRepositoryUrl>
    </PropertyGroup>
  </Target>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="" />
    <None Include="$(MSBuildThisFileDirectory)NOTICE" Pack="true" PackagePath="" />
    <None Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES" Pack="true" PackagePath="" />
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="README.md"
          Condition="'$(PackThinReadme)' != 'false'" />
  </ItemGroup>

</Project>
