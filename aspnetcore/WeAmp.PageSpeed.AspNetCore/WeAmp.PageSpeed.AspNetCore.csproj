<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Ship net8.0;net10.0 (mirrors 2.0 — both LTS, deliberately skipping the net9
         STS). Defaults to net8.0 so the in-tree build stays green on net9-only
         dev/CI boxes; the release pipeline
         flips on the second TFM with -p:IncludeNet10=true on a box that has the .NET
         10 SDK (see the sidecar NuGet CI lane). The TargetFrameworks values
         are LITERAL (not a passed list) so MSBuild's multi-target outer/inner split
         works and we avoid command-line ';' escaping. -->
    <TargetFrameworks>net8.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(IncludeNet10)' == 'true'">net8.0;net10.0</TargetFrameworks>
    <!-- Locked restore: CI restores with -p:RestoreLockedMode=true, so a package
         version or content hash that differs from the lock file fails the build. The
         two framework sets have a lock file each. After changing a package
         reference, regenerate both: `dotnet restore` and
         `dotnet restore -p:IncludeNet10=true` (with a .NET 10 SDK). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(IncludeNet10)' == 'true'">packages.net10.lock.json</NuGetLockFilePath>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>WeAmp.PageSpeed.AspNetCore</RootNamespace>

    <!-- Customer-facing NuGet id: DISTINCT from the shipped 2.0
         `WeAmp.PageSpeed.AspNetCore` (collision = publish bug). A distinct AssemblyName
         keeps the shipped DLL distinct too; the namespace stays WeAmp.PageSpeed.AspNetCore
         (the .NET API surface AddPageSpeed()/UsePageSpeed() is intentionally consistent). -->
    <PackageId>WeAmp.PageSpeed.Sidecar</PackageId>
    <AssemblyName>WeAmp.PageSpeed.Sidecar</AssemblyName>
    <Title>WeAmp.PageSpeed.Sidecar for ASP.NET Core — mod_pagespeed with a bundled nginx optimize-proxy</Title>
    <Description>mod_pagespeed for ASP.NET Core. The default Inverse topology makes your Kestrel app the public front door (you own the socket/TLS/auth) with a bundled, matched nginx + ngx_pagespeed running loopback-only behind it as an optimize-proxy — the middleware streams optimizable responses to it (image recompression, CSS/JS minification, critical CSS, Core-Web-Vitals-oriented HTML rewriting). The classic front-proxy topology (Process — nginx fronts your app) and connecting to an operator-managed nginx (External) remain available. Wire it in with AddPageSpeed() and UsePageSpeed(); the package generates its own nginx config, manages the process lifecycle, and exposes health checks. Linux-only (linux-x64, linux-arm64); on Windows use the IIS module, on macOS or containers without nginx use WeAmp.PageSpeed.AspNetCore (mod_pagespeed).</Description>
    <PackageTags>pagespeed mod-pagespeed mod_pagespeed nginx ngx-pagespeed aspnetcore sidecar reverse-proxy web-performance core-web-vitals image-optimization critical-css weamp</PackageTags>

    <!-- Build settings -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Inverse topology: YARP supplies IHttpForwarder for the streaming loopback
         forward from the public Kestrel front door to the bundled nginx
         optimize-proxy. 2.3.0 targets net8.0 (forward-compatible with the
         conditional net10.0 TFM via roll-forward). Track it in the SBOM/CVE map
         alongside the bundled nginx — both are third-party code we redistribute. -->
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <!-- Auto-pull the native engine, mirroring 2.0's AspNetCore->PageSpeed->
       NativeAssets dependency chain. A ProjectReference becomes a NuGet <dependency>
       at pack time (same version), so `dotnet add package WeAmp.PageSpeed.Sidecar`
       brings the matched nginx + module automatically — a thin-only install no longer
       builds green then dies at runtime (NM-2). ReferenceOutputAssembly stays unset:
       with it false the SDK also drops the reference from the nuspec dependencies
       (verified against the 8.0 SDK pack), which would break that auto-pull. The
       compile-time reference that remains is inert: the native project's only managed
       output is an empty assembly, kept out of its package by
       IncludeBuildOutput=false, and its binaries stay in their own package, not
       duplicated into this one. -->
  <ItemGroup>
    <ProjectReference Include="../WeAmp.PageSpeed.Sidecar.NativeAssets.Linux/WeAmp.PageSpeed.Sidecar.NativeAssets.Linux.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WeAmp.PageSpeed.AspNetCore.Tests" />
  </ItemGroup>

</Project>
