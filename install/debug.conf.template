# In case the system has not added webp as an installed mimetype, this
# is needed to allow test/system/automatic/test_resource_content_type.py
# to work.
AddType image/webp .webp

# As above, for avif: the system has not usually added it as an installed
# mimetype, so a .avif served off disk by the default handler would fall back
# to the default type. (A .pagespeed.ic. resource gets its Content-Type from
# the module, not from this map, so the AVIF system tests do not depend on
# this line -- it is here for parity with the webp entry above.)
AddType image/avif .avif

# As above, for verifying JSON content-type in test/system/system/test_json_content_type.py
AddType application/json .json

# Override CentOS which uses ancient default of text/javascript.
AddType application/javascript .js
