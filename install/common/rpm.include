@@include@@variables.include

# We-Amp B.V. repository signing key (rsa4096, F50D6054F10712A0,
# packages@we-amp.com). Mirrors https://packages.modpagespeed.com/pubkey.gpg,
# the key that signs the .deb/.rpm repositories.
install_rpm_key() {
  # Skip if our signing key (id F50D6054F10712A0) is already imported.
  if rpm -q gpg-pubkey --qf '%{version}\n' 2>/dev/null | grep -qi '^f10712a0$'; then
    return 0
  fi

  # RPM on Mandriva 2009 is dumb and does not understand "rpm --import -"
  TMPKEY=$(mktemp /tmp/weamp.sig.XXXXXX)
  if [ -n "$TMPKEY" ]; then
    cat > "$TMPKEY" <<KEYDATA
-----BEGIN PGP PUBLIC KEY BLOCK-----

mQINBGoAQG4BEAC2qUQ7gQXT2AWTVRUYWSsru52OScSNuI10BHzFrHUnig23Swxd
pE5AxKp/md22SAbOKZWL1dB3qXEizc8/r1QSiM3N77xZWgry0jF/ymQXOJkJBqPg
hIFIXloIS1AkqOi02KHb+/FxB+ElPgJ2cT7xotuvCxhGvmocRTLmmF8q6SGTdIMt
