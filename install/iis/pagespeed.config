# PageSpeed for IIS — default configuration.
#
# Config resolution order — ONE documented chain, last existing
# file wins (the effective winner):
#   1. %ProgramData%\We-Amp\PageSpeed\pagespeed.config     machine-global base default (this file)
#   2. %ProgramData%\We-Amp\IISWebSpeed\pagespeed.config   legacy IISpeed fallback (upgrade only)
#   3. <site physical path>\pagespeed.config               per-site override, AUTHORITATIVE when present
# Within each location pagespeed.config is preferred over iiswebspeed.config
# (legacy upgrade-from-IISpeed inner fallback). Locations 1/2 form the base
# layer; the per-site file (3) is layered last, so any directive it sets wins
# for that site. Edit the file that actually applies to what you want to change
# — for a single default site that is the per-site copy in the site's web root.
#
# This file is read by pagespeed_iis.dll on worker-process startup and
# re-checked periodically (timestamp-based reload).
#
# To disable rewriting without uninstalling: change "pagespeed on" to
# "pagespeed off" in the file that applies (see the resolution order above).
#
# Full directive reference: https://modpagespeed.com

pagespeed on
pagespeed RewriteLevel CoreFilters

# On-disk cache and logs. The MSI creates these directories and ensures
# the IIS worker identity (IIS_IUSRS) has the required access.
pagespeed FileCachePath "C:\ProgramData\We-Amp\PageSpeed\cache"
pagespeed LogDir        "C:\ProgramData\We-Amp\PageSpeed\logs"

# Statistics + admin console.
#
# Admin endpoints are restricted to localhost by default; widen explicitly
# for ops access (set "InfoUrlsLocalOnly off" and gate the URLs with IIS
# IP/Domain Restrictions or an authenticated reverse proxy).
# URL-path-string ACLs in WAFs/edges are bypassable (`//pagespeed_admin`,
# `/./pagespeed_admin`, `%2e` tricks); enforcement is in the PageSpeed
# handler itself (IsLocalRequest check) -- the right layer.
# Docs: https://www.modpagespeed.com/1.1/docs/admin-console/#url-path-acls-are-brittle
pagespeed InfoUrlsLocalOnly on
pagespeed Statistics on
pagespeed StatisticsLogging on
pagespeed EnableCachePurge on
pagespeed AdminPath /pagespeed_admin
pagespeed GlobalAdminPath /pagespeed_global_admin
pagespeed StatisticsPath /pagespeed_statistics
pagespeed MessagesPath /pagespeed_message
pagespeed ConsolePath /pagespeed_console
