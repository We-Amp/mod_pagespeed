<!--
  WiX v5 MSI installer for We-Amp PageSpeed IIS module.

  Build:
    wix build install\iis\Product.wxs ^
        -d ProductVersion=1.15.0 -d DisplayVersion=1.15.0-beta.1 ^
        -d UpgradeCode=77EA515C-A077-4D56-B92A-58E65D713423 ^
        -d BinDir=bazel-bin\pagespeed\iis -d SrcDir=. ^
        -arch x64 -o pagespeed-iis-1.15.0-beta.1-win-x64.msi

  Architecture notes:
    - W3SVC stop/start uses <ServiceControl> (MSI-native, no CA).
    - appcmd module register/unregister + icacls ACL grants use Type 34
      deferred exe CAs (Windows Installer's built-in exe launcher — does
      NOT depend on Wix4UtilCA_X64 / WixQuietExec64). This avoids the
      C/C++ runtime dependency that broke stock Windows Server 2016
      installs. We deliberately do NOT use util:PermissionEx for the
      cache + logs dir ACLs: upstream WiX v5.0.2 emits it as
      Wix4SchedSecureObjects + Wix4ExecSecureObjects references that
      pull Wix4UtilCA_X64.dll (CRT-dependent) into the Binary table,
      reintroducing the exact failure mode the Type-34 CAs were chosen
      to avoid. The deferred icacls CAs (GrantCacheAcl / GrantLogAcl)
      below are the sole ACL mechanism, by design.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="We-Amp PageSpeed for IIS $(var.DisplayVersion)"
           Manufacturer="We-Amp B.V."
           Version="$(var.ProductVersion)"
           UpgradeCode="$(var.UpgradeCode)"
           Language="1033"
           Codepage="1252"
           InstallerVersion="500"
           Scope="perMachine">

    <!-- Upgrade: default (afterInstallValidate) schedule. RemoveExistingProducts
         runs BEFORE the new product installs, so W3SVC stops once for the old
         uninstall and starts once after the new install - a single
         <ServiceControl> cycle instead of two.

         Trade-off vs. afterInstallExecute: a failed new install no longer
         leaves the old product intact; the user is left with neither installed.
         We accept this because the double-cycle caused IIS lockups on warm
         systems (beta.9 upgrade-over-running-IIS), which is far more common
         in practice than mid-upgrade failures. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <Media Id="1" Cabinet="pagespeed.cab" EmbedCab="yes" />

    <!-- Add/Remove Programs metadata -->
    <Property Id="ARPURLINFOABOUT" Value="https://modpagespeed.com" />
    <Property Id="ARPHELPLINK" Value="https://modpagespeed.com" />

    <!-- Force overwrite on every install/upgrade transaction.
         Default REINSTALLMODE is "omus" — "o" means "overwrite if the source
         is newer than the destination". With pagespeed_iis.dll embedding
         VS_VERSION_INFO (1.15.0.<beta-num>), the upgrade scenarios already
         compare correctly. But if a customer ever ends up with a file on
         disk that doesn't match its component-cache state (manual replace,
         antivirus quarantine, corrupted prior install), MSI would silently
         leave it in place. "amus" forces always-overwrite, eliminating that
         class of silent-no-op. The cost is a few extra disk writes on
         no-change reinstalls, which is negligible. -->
    <Property Id="REINSTALLMODE" Value="amus" />

    <!-- Detect IIS via registry -->
    <Property Id="IISMAJORVERSION">
      <RegistrySearch Id="IISVersionSearch" Root="HKLM"
                      Key="SOFTWARE\Microsoft\InetStp"
                      Name="MajorVersion" Type="raw" />
    </Property>
    <Launch Condition="Installed OR IISMAJORVERSION"
            Message="IIS is required. Please install IIS (Web Server role) before running this installer." />

    <!-- Resolve the default wwwroot physical path. IIS records it in the
         registry; on stock installs this is C:\inetpub\wwwroot, but admins
         who moved it will have the real path here. If the key is missing
         we fall back to the conventional location below. -->
    <Property Id="IISWWWROOT">
      <RegistrySearch Id="WwwRootSearch" Root="HKLM"
                      Key="SOFTWARE\Microsoft\InetStp"
                      Name="PathWWWRoot" Type="raw" />
    </Property>
    <SetProperty Id="IISWWWROOT" Value="C:\inetpub\wwwroot"
                 After="AppSearch" Sequence="both"
                 Condition="NOT IISWWWROOT" />
    <!-- WWWROOTDIR is a Directory table id; MSI resolves it during
         CostFinalize. The SetProperty must fire BEFORE CostFinalize so
         the directory resolves to [IISWWWROOT] rather than the default
         (TARGETDIR). -->
    <SetProperty Id="WWWROOTDIR" Value="[IISWWWROOT]"
                 Before="CostFinalize" Sequence="both" />

<?ifdef OptimizerDir ?>
    <!-- The optimizer service's start type as the operator left it, read
         in AppSearch, before an upgrade removes the old product and with
         it the service. Raw REG_DWORD: "#2" automatic, "#3" manual,
         "#4" disabled; empty on a first install. -->
    <Property Id="OPTIMIZERSTARTTYPE">
      <RegistrySearch Id="OptimizerStartTypeSearch" Root="HKLM"
                      Key="SYSTEM\CurrentControlSet\Services\WeAmpPageSpeedOptimizer"
                      Name="Start" Type="raw" />
    </Property>

    <!-- The optimizer's cache volume size in bytes: settable on the
         msiexec command line (OPTIMIZERCACHESIZE=...), remembered in the
         registry for later upgrades and repairs, 1 GiB when neither says
         otherwise. The worker takes the size on its command line only,
         so this is where it lives. A command-line value wins over the
         remembered one: AppSearch would overwrite it, so it is saved
         before and put back after. -->
    <Property Id="OPTIMIZERCACHESIZE" Secure="yes">
      <RegistrySearch Id="OptimizerCacheSizeSearch" Root="HKLM"
                      Key="SOFTWARE\We-Amp\PageSpeed"
                      Name="OptimizerCacheSize" Type="raw" />
    </Property>
    <SetProperty Id="OPTIMIZERCACHESIZECMDLINE" Value="[OPTIMIZERCACHESIZE]"
                 Before="AppSearch" Sequence="both"
                 Condition="OPTIMIZERCACHESIZE" />
    <SetProperty Id="OPTIMIZERCACHESIZE" Action="RestoreCmdlineOptimizerCacheSize"
                 Value="[OPTIMIZERCACHESIZECMDLINE]"
                 After="AppSearch" Sequence="both"
                 Condition="OPTIMIZERCACHESIZECMDLINE" />
    <SetProperty Id="OPTIMIZERCACHESIZE" Action="DefaultOptimizerCacheSize"
                 Value="1073741824"
                 After="RestoreCmdlineOptimizerCacheSize" Sequence="both"
                 Condition="NOT OPTIMIZERCACHESIZE" />
<?endif ?>

    <!-- ================================================================ -->
    <!--  Directory layout                                                -->
    <!-- ================================================================ -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="WEAMPDIR" Name="We-Amp">
        <Directory Id="INSTALLDIR" Name="PageSpeed" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="WEAMPDATADIR" Name="We-Amp">
        <Directory Id="PAGESPEEDDATA" Name="PageSpeed">
          <Directory Id="CACHEDIR" Name="cache" />
          <Directory Id="LOGDIR" Name="logs" />
          <Directory Id="OPTIMIZERDIR" Name="optimizer" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- Default wwwroot — path resolved at install time via IISWWWROOT property. -->
    <StandardDirectory Id="TARGETDIR">
      <Directory Id="WWWROOTDIR" />
    </StandardDirectory>

    <!-- ================================================================ -->
    <!--  Components                                                      -->
    <!-- ================================================================ -->

    <!-- Main DLL -->
    <Component Id="MainDll" Directory="INSTALLDIR" Guid="*">
      <File Id="pagespeed_iis.dll"
            Source="$(var.BinDir)\pagespeed_iis.dll"
            KeyPath="yes" />
    </Component>

    <!-- Sample configuration -->
    <Component Id="SampleConfig" Directory="INSTALLDIR" Guid="*">
      <File Id="web.config.sample"
            Source="$(var.SrcDir)\install\iis\web.config.sample"
            KeyPath="yes" />
    </Component>

    <!-- License text and attribution notices, next to the module as the
         Apache-2.0 terms ask. Sourced verbatim from the repository root
         (the same files every other package ships). -->
    <Component Id="LicenseFile" Directory="INSTALLDIR" Guid="*">
      <File Id="LICENSE"
            Source="$(var.SrcDir)\LICENSE"
            KeyPath="yes" />
    </Component>
    <Component Id="NoticeFile" Directory="INSTALLDIR" Guid="*">
      <File Id="NOTICE"
            Source="$(var.SrcDir)\NOTICE"
            KeyPath="yes" />
    </Component>

    <!--
      IIS service control — cycles BOTH the Windows Process Activation
      Service (WAS) and the World Wide Web Publishing Service (W3SVC)
      during install/upgrade/uninstall so that pagespeed_iis.dll is
      released by every w3wp.exe worker before InstallFiles tries to
      replace it.

      Why stop WAS, not just W3SVC?
        w3wp.exe worker processes are children of WAS, not W3SVC
        (despite a common misreading of IIS architecture docs).
        W3SVC depends on WAS. Stopping W3SVC alone leaves WAS up and
        does NOT force-terminate live workers — they drain their
        application-pool shutdown timeout (default 90s, often longer
        on warm production sites with long-running requests), during
        which they continue to hold pagespeed_iis.dll mapped. MSI's
        InstallFiles then SILENTLY skips the in-use file (Windows
        Installer schedules a pending-reboot replace and returns
        success), so the customer ends up with a "successful upgrade"
        that still serves the old DLL after the post-install iisreset.
        This is the root cause of the beta.10-through-beta.14 stale
        X-Page-Speed header bug.

      Why also taskkill w3wp.exe (see ForceKillW3wp CustomAction)?
        WAS-stop is supposed to synchronously terminate workers, but
        a handful of community reports describe edge cases (crash-
        dump in flight, app-domain shutdown hang) where WAS returns
        before its workers are fully gone. A defensive `taskkill /F`
        scheduled AFTER WAS stop and BEFORE InstallFiles is cheap
        insurance. If no workers remain, taskkill returns 128 ("no
        matching processes") which we mask with Return="ignore".

      Both ServiceControl rows are MSI-native (no Wix4UtilCA CRT
      dependency, same reasoning as the appcmd Type-34 CAs below).
      Wait="yes" makes the InstallExecuteSequence block on the stop
      completing.
    -->
    <Component Id="IisServiceControl" Directory="INSTALLDIR"
               Guid="A1B2C3D4-1001-4000-8000-000000000003">
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\We-Amp\PageSpeed"
                     Name="ServiceControlKey"
                     Type="integer" Value="1" KeyPath="yes" />
      <!-- Stop WAS first; w3wp.exe workers are children of WAS, not W3SVC.
           No Start attribute - W3SVC depends on WAS, so starting W3SVC
           below transitively starts WAS. -->
      <ServiceControl Id="WAS"
                      Name="WAS"
                      Stop="both"
                      Wait="yes" />
      <ServiceControl Id="W3SVC"
                      Name="W3SVC"
                      Start="both"
                      Stop="both"
                      Wait="yes" />
    </Component>

    <!-- Cache directory — IIS_IUSRS + NETWORK SERVICE get Modify via the
         GrantCacheAcl deferred icacls CA (locale-safe via well-known SIDs,
         no Wix4UtilCA CRT dependency; see comment block on the CA below).
         The AppPool worker writes per-vhost subdirs under this path;
         icacls is invoked with (OI)(CI) so children inherit. Permanent="yes"
         preserves the directory AND its ACLs across uninstall, so a
         repeated icacls /grant on the same SID is a no-op (the OS de-dupes
         identical ACEs rather than appending). Without this grant the
         v1.1.0 IIS module fails to start with "FileCachePath not writable"
         on first request and serves the diagnostic page instead of
         running. -->
    <Component Id="CacheDirComp" Directory="CACHEDIR"
               Guid="A1B2C3D4-1001-4000-8000-000000000001"
               KeyPath="yes" Permanent="yes">
      <CreateFolder />
    </Component>

    <!-- Log directory — same deferred-icacls approach as cache, but the
         GrantLogAcl CA grants only (RX,W) (read/execute/write) rather than
         M (modify), so the worker can append to logs but not delete them;
         rotation is admin-driven. Permanent="yes" preserves the directory
         AND its ACLs across uninstall (identical SIDs are de-duped on
         repeat install, not appended). -->
    <Component Id="LogDirComp" Directory="LOGDIR"
               Guid="A1B2C3D4-1001-4000-8000-000000000002"
               KeyPath="yes" Permanent="yes">
      <CreateFolder />
    </Component>

    <!-- THE machine-global default pagespeed.config — tier 1 of the config
         resolution order documented at the top of pagespeed.config itself:
         the base layer of the documented single source of truth. This is the ONE
         seeded default; the wwwroot copy below is a per-site override SAMPLE,
         not a second competing default. NeverOverwrite preserves
         admin edits across upgrades; Permanent leaves the file on uninstall so
         a reinstall picks up existing customizations.

         Filed into PAGESPEEDDATA (C:\ProgramData\We-Amp\PageSpeed\)
         alongside the cache + logs subdirectories — one canonical product
         directory. The legacy C:\ProgramData\We-Amp\IISWebSpeed\ path
         (tier 2 of that same chain) is no longer created by fresh installs;
         iis_config_util.cpp keeps a runtime fallback on it for
         upgrade-from-IISpeed and upgrade-from-1.1-pre-this-change customers
         whose config survives via NeverOverwrite. -->
    <Component Id="PagespeedConfig" Directory="PAGESPEEDDATA"
               Guid="A1B2C3D4-1001-4000-8000-000000000004"
               NeverOverwrite="yes" Permanent="yes">
      <File Id="pagespeed.config"
            Source="$(var.SrcDir)\install\iis\pagespeed.config"
            KeyPath="yes" />
    </Component>

    <!-- Per-site override SAMPLE — tier 3 of that chain, authoritative when
         present. This is NOT a second copy of the machine-global default
         above: it is the drop-in per-site override surface (the IISpeed /
         IISWebSpeed backward-compat model), seeded into the Default Web Site's
         physical root so a bare install engages out of the box (the module's
         engage gate requires a per-site config under the application's physical
         path — a bare install would otherwise be a no-op module) and so
         operators have a per-site file to edit. Its content layers LAST over
         the machine-global base, so any directive here wins for this site.
         NeverOverwrite preserves existing IISpeed configs (and admin edits) on
         upgrade; Permanent keeps admin edits through uninstall/reinstall.
         Conditional on IISWWWROOT in case the registry lookup and the
         fallback both leave the property empty on exotic setups.
         Non-serving of this web-root config file is asserted by the
         requestFiltering deny in web.config.sample (do not rely on the IIS
         *.config default alone). -->
    <Component Id="SitePagespeedConfig" Directory="WWWROOTDIR"
               Guid="A1B2C3D4-1001-4000-8000-000000000005"
               NeverOverwrite="yes" Permanent="yes"
               Condition="IISWWWROOT">
      <File Id="site_pagespeed.config"
            Name="pagespeed.config"
            Source="$(var.SrcDir)\install\iis\pagespeed.config"
            KeyPath="yes" />
    </Component>

<?ifdef OptimizerDir ?>
    <!-- ================================================================ -->
    <!--  The optimizer worker (built when OptimizerDir is given: the     -->
    <!--  verified contents of the pinned optimizer release's win-x64     -->
    <!--  zip). Installed as a Windows service that is DISABLED: a fresh  -->
    <!--  install behaves exactly as one without it until an operator     -->
    <!--  enables the service and sets the two daemon directives.         -->
    <!-- ================================================================ -->

    <!-- The client library the module loads for the daemon path. The
         module resolves it next to pagespeed_iis.dll (absolute path only;
         the loader searches no directories). -->
    <Component Id="OptimizerClientDll" Directory="INSTALLDIR" Guid="*">
      <File Id="pagespeed.dll"
            Source="$(var.OptimizerDir)\pagespeed.dll"
            KeyPath="yes" />
    </Component>

    <!-- The worker and its service. Virtual account NT SERVICE\<name>:
         no password, its own SID for the volume grant below. Arguments:
         the pipe name and volume directory the installation guide tells
         the operator to set in DaemonSocketPath and DaemonVolumePath (the
         module has no defaults for them), a JSON log appended under the
         product's logs directory. "[OPTIMIZERDIR]." rather than
         "[OPTIMIZERDIR]": the property ends in a backslash, and a
         backslash before the closing quote would escape it. -->
    <Component Id="OptimizerService" Directory="INSTALLDIR" Guid="*">
      <File Id="factory_worker.exe"
            Source="$(var.OptimizerDir)\factory_worker.exe"
            KeyPath="yes" />
      <ServiceInstall Id="OptimizerServiceInstall"
                      Name="WeAmpPageSpeedOptimizer"
                      DisplayName="We-Amp PageSpeed Optimizer"
                      Description="Optimizes the resources PageSpeed for IIS records, into a cache volume the IIS module reads. Disabled until you enable it; see the IIS installation guide."
                      Type="ownProcess"
                      Start="disabled"
                      ErrorControl="normal"
                      Account="NT SERVICE\WeAmpPageSpeedOptimizer"
                      Arguments='--service --log-file "[LOGDIR]optimizer.log" --log-format json --socket pagespeed-optimizer --cache-dir "[OPTIMIZERDIR]." --cache-size [OPTIMIZERCACHESIZE]'
                      Vital="no" />
      <!-- Stopped before its files are replaced or removed; never started
           by the installer (the service is disabled). -->
      <ServiceControl Id="OptimizerServiceControl"
                      Name="WeAmpPageSpeedOptimizer"
                      Stop="both"
                      Remove="uninstall"
                      Wait="yes" />
    </Component>

    <!-- The remembered cache size. Permanent, like the volume directory:
         a reinstall after an uninstall starts a fresh volume (the kept one
         is moved aside, see below) at the size chosen before. -->
    <Component Id="OptimizerCacheSizeValue" Directory="INSTALLDIR"
               Guid="A1B2C3D4-1001-4000-8000-000000000007" Permanent="yes">
      <RegistryValue Root="HKLM" Key="SOFTWARE\We-Amp\PageSpeed"
                     Name="OptimizerCacheSize" Type="string"
                     Value="[OPTIMIZERCACHESIZE]" KeyPath="yes" />
    </Component>

    <!-- The optimizer's own licence and notice files, from its zip. -->
    <Component Id="OptimizerLicenseFile" Directory="INSTALLDIR" Guid="*">
      <File Id="optimizer_LICENSE" Name="optimizer-LICENSE.txt"
            Source="$(var.OptimizerDir)\LICENSE" KeyPath="yes" />
    </Component>
    <Component Id="OptimizerNoticeFile" Directory="INSTALLDIR" Guid="*">
      <File Id="optimizer_NOTICE" Name="optimizer-NOTICE.txt"
            Source="$(var.OptimizerDir)\NOTICE" KeyPath="yes" />
    </Component>

    <!-- The worker's cache volume directory. Permanent: an uninstall keeps
         the optimized cache, as it keeps the module's own cache. -->
    <Component Id="OptimizerVolumeDir" Directory="OPTIMIZERDIR"
               Guid="A1B2C3D4-1001-4000-8000-000000000006"
               KeyPath="yes" Permanent="yes">
      <CreateFolder />
    </Component>
<?endif ?>

    <!-- ================================================================ -->
    <!--  Feature                                                         -->
    <!-- ================================================================ -->
    <Feature Id="ProductFeature" Title="PageSpeed for IIS" Level="1">
      <ComponentRef Id="MainDll" />
      <ComponentRef Id="SampleConfig" />
      <ComponentRef Id="LicenseFile" />
      <ComponentRef Id="NoticeFile" />
      <ComponentRef Id="IisServiceControl" />
      <ComponentRef Id="CacheDirComp" />
      <ComponentRef Id="LogDirComp" />
      <ComponentRef Id="PagespeedConfig" />
      <ComponentRef Id="SitePagespeedConfig" />
<?ifdef OptimizerDir ?>
      <ComponentRef Id="OptimizerClientDll" />
      <ComponentRef Id="OptimizerService" />
      <ComponentRef Id="OptimizerVolumeDir" />
      <ComponentRef Id="OptimizerLicenseFile" />
      <ComponentRef Id="OptimizerNoticeFile" />
      <ComponentRef Id="OptimizerCacheSizeValue" />
<?endif ?>
    </Feature>

    <!-- ================================================================ -->
    <!--  appcmd module registration — Type 34 deferred exe CAs           -->
    <!--                                                                  -->
    <!--  Type 34 = Source is a Directory table id (resolved to literal   -->
    <!--  path at exec time); Target is the command line, where the       -->
    <!--  first token is the exe path relative to that directory. No      -->
    <!--  third-party CA DLL — Windows Installer launches the exe         -->
    <!--  directly. Sidesteps the Wix4UtilCA_X64 CRT dependency that      -->
    <!--  broke stock Windows Server 2016 installs.                       -->
    <!--                                                                  -->
    <!--  Deferred CAs receive formatted data via the CustomActionData    -->
    <!--  property, populated by a paired SetProperty (auto-generated by  -->
    <!--  WiX for attributes that contain [INSTALLDIR] tokens).           -->
    <!-- ================================================================ -->

    <!-- Defensive force-kill of any lingering w3wp.exe worker after
         StopServices but before InstallFiles. See the IisServiceControl
         comment block above for rationale. taskkill /F returns 128 when
         no matching processes exist; Return="ignore" masks that. -->
    <CustomAction Id="ForceKillW3wp"
                  Directory="SystemFolder"
                  ExeCommand='taskkill.exe /F /IM w3wp.exe /T'
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="CleanRegistration"
                  Directory="SystemFolder"
                  ExeCommand="inetsrv\appcmd.exe uninstall module PageSpeedModule"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="RegisterModule"
                  Directory="SystemFolder"
                  ExeCommand='inetsrv\appcmd.exe install module /name:PageSpeedModule /image:"[INSTALLDIR]pagespeed_iis.dll" /add:true'
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!-- Full uninstall: remove the module registration before files disappear.
         Skipped on MajorUpgrade (UPGRADINGPRODUCTCODE is set then) so the
         freshly-registered new version survives the old product's removal. -->
    <CustomAction Id="UnregisterModule"
                  Directory="SystemFolder"
                  ExeCommand="inetsrv\appcmd.exe uninstall module PageSpeedModule"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- ACL grants on cache + logs dirs, using well-known SIDs
         S-1-5-32-568 (IIS_IUSRS) + S-1-5-20 (NETWORK SERVICE) which are
         locale-independent (avoids the localized-account-name failure
         mode on de-DE / fr-FR / ja-JP Windows). icacls.exe lives in
         C:\Windows\System32 (= SystemFolder), so Directory="SystemFolder"
         + ExeCommand starting with "icacls.exe ..." resolves to a
         literal absolute path at exec time — matches the existing
         RegisterModule pattern above which uses "inetsrv\appcmd.exe"
         relative to the same SystemFolder. No cmd.exe /c wrapper:
         Type-34 launches the exe directly (no shell, no extra process
         layer), same as RegisterModule. The [CACHEDIR] / [LOGDIR]
         expansion ends in a backslash, and a backslash before the closing
         quote escapes the quote: icacls then received the path with a
         quote and the rest of the command line glued on, failed with
         ERROR_INVALID_NAME (123), and Return="ignore" hid it, so the
         grants were never applied. The trailing "." keeps the backslash
         away from the quote and names the same directory.
         NETWORK SERVICE is granted as secondary for legacy AppPool
         models that don't run under ApplicationPoolIdentity.

         Return="ignore": icacls failures are masked because the new
         X-Pagespeed-Init-Status: cache-path-not-writable diagnostic
         page surfaces this failure mode loudly to localhost admin on
         first request, providing a louder signal than a deferred-CA
         hard-fail mid-install (which would roll back the entire MSI
         and leave the customer with no module at all). -->
    <CustomAction Id="GrantCacheAcl"
                  Directory="SystemFolder"
                  ExeCommand='icacls.exe "[CACHEDIR]." /grant "*S-1-5-32-568:(OI)(CI)M" /grant "*S-1-5-20:(OI)(CI)M"'
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <CustomAction Id="GrantLogAcl"
                  Directory="SystemFolder"
                  ExeCommand='icacls.exe "[LOGDIR]." /grant "*S-1-5-32-568:(OI)(CI)(RX,W)" /grant "*S-1-5-20:(OI)(CI)(RX,W)"'
                  Execute="deferred" Impersonate="no" Return="ignore" />

<?ifdef OptimizerDir ?>
    <!-- The volume directory. Every application pool writes into it, so
         nothing here ever walks inside it: no recursive icacls, which would
         follow a link a pool had planted and act, as SYSTEM, on whatever
         it points at. Instead: on the first install that brings the
         optimizer (including a reinstall after an uninstall, which kept
         the directory: nothing proves it was left alone meanwhile), a
         directory that already exists is moved aside, under a new name
         each time, before CreateFolders makes a fresh one; the package then owns it (SYSTEM) and sets its
         DACL on the directory alone. Inheritance removed; SYSTEM and
         Administrators full control; the worker service's own SID modify;
         IIS_IUSRS modify on the files inside (the pools read, record and,
         on a refused start, remove a file they created) but on the
         directory itself only list, read and create files, so no pool can
         delete or replace the directory. The service SID exists only once
         the service does, so these run after InstallServices. "NT SERVICE"
         is not localized. -->
    <CustomAction Id="MoveAsidePreexistingOptimizerDir"
                  Directory="SystemFolder"
                  ExeCommand='cmd.exe /c if exist "[PAGESPEEDDATA]optimizer" move "[PAGESPEEDDATA]optimizer" "[PAGESPEEDDATA]optimizer.pre-install-%RANDOM%%RANDOM%%RANDOM%"'
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="SetOptimizerVolumeOwner"
                  Directory="SystemFolder"
                  ExeCommand='icacls.exe "[OPTIMIZERDIR]." /setowner "*S-1-5-18" /C'
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="GrantOptimizerVolumeAcl"
                  Directory="SystemFolder"
                  ExeCommand='icacls.exe "[OPTIMIZERDIR]." /inheritance:r /grant:r "*S-1-5-18:(OI)(CI)F" "*S-1-5-32-544:(OI)(CI)F" "NT SERVICE\WeAmpPageSpeedOptimizer:(OI)(CI)M" "*S-1-5-32-568:(OI)(CI)(IO)M"'
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="GrantOptimizerVolumeDirPools"
                  Directory="SystemFolder"
                  ExeCommand='icacls.exe "[OPTIMIZERDIR]." /grant "*S-1-5-32-568:(RX,WD)"'
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <!-- Recovery: a crash-looping worker must not hot-loop, so restart
         after one minute twice, then after five; the count resets after a
         day. Set with sc.exe rather than the MsiServiceConfigFailureActions
         table: Windows Installer opens the service without the start
         right a restart action needs, and the install then fails with
         access denied. -->
    <CustomAction Id="SetOptimizerRecovery"
                  Directory="SystemFolder"
                  ExeCommand="sc.exe failure WeAmpPageSpeedOptimizer reset= 86400 actions= restart/60000/restart/60000/restart/300000"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <!-- An upgrade or repair installs the service Disabled again, as a
         first install does. An operator who had enabled it gets back the
         start type they chose, and an automatic service is started again,
         so enabling the optimizer survives the next package. This runs
         before StartServices brings IIS back, and net.exe start waits
         until the worker reports RUNNING (it does so once initialized), so
         the application pools start with the optimizer already answering. -->
    <CustomAction Id="RestoreOptimizerAutoStart"
                  Directory="SystemFolder"
                  ExeCommand="sc.exe config WeAmpPageSpeedOptimizer start= auto"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="RestoreOptimizerManualStart"
                  Directory="SystemFolder"
                  ExeCommand="sc.exe config WeAmpPageSpeedOptimizer start= demand"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="RestartOptimizer"
                  Directory="SystemFolder"
                  ExeCommand="net.exe start WeAmpPageSpeedOptimizer"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <!-- The worker service appends its log in the product's logs
         directory: read, execute and write, as the module has. -->
    <CustomAction Id="GrantOptimizerLogAcl"
                  Directory="SystemFolder"
                  ExeCommand='icacls.exe "[LOGDIR]." /grant "NT SERVICE\WeAmpPageSpeedOptimizer:(OI)(CI)(RX,W)"'
                  Execute="deferred" Impersonate="no" Return="ignore" />
<?endif ?>

    <InstallExecuteSequence>
      <!-- Defensive w3wp kill: scheduled AFTER StopServices (which runs the
           WAS+W3SVC <ServiceControl> Stop rows from IisServiceControl) and
           BEFORE InstallFiles, so any worker that survived WAS-stop is gone
           before the DLL replace. -->
      <Custom Action="ForceKillW3wp" After="StopServices" />
      <!-- Install/repair: remove any stale registration, then register. -->
      <Custom Action="CleanRegistration" After="InstallFiles"
              Condition="NOT Installed OR REINSTALL" />
      <Custom Action="RegisterModule" After="CleanRegistration"
              Condition="NOT Installed OR REINSTALL" />
      <!-- ACL grants on cache + logs dirs via well-known SIDs (locale-
           independent). Sole ACL mechanism: util:PermissionEx was
           considered and rejected because WiX v5.0.2 emits it as
           Wix4SchedSecureObjects / Wix4ExecSecureObjects references
           that pull Wix4UtilCA_X64.dll (CRT-dependent) into the MSI
           Binary table — the exact failure mode the Type-34 deferred-
           exe CAs are designed to avoid. See the GrantCacheAcl
           CustomAction comment block above. -->
      <Custom Action="GrantCacheAcl" After="RegisterModule"
              Condition="NOT Installed OR REINSTALL" />
      <Custom Action="GrantLogAcl" After="GrantCacheAcl"
              Condition="NOT Installed OR REINSTALL" />
<?ifdef OptimizerDir ?>
      <Custom Action="MoveAsidePreexistingOptimizerDir" Before="CreateFolders"
              Condition="NOT Installed AND NOT OPTIMIZERSTARTTYPE" />
      <Custom Action="SetOptimizerVolumeOwner" After="InstallServices"
              Condition="NOT Installed OR REINSTALL" />
      <Custom Action="GrantOptimizerVolumeAcl" After="SetOptimizerVolumeOwner"
              Condition="NOT Installed OR REINSTALL" />
      <Custom Action="GrantOptimizerVolumeDirPools" After="GrantOptimizerVolumeAcl"
              Condition="NOT Installed OR REINSTALL" />
      <Custom Action="GrantOptimizerLogAcl" After="GrantOptimizerVolumeDirPools"
              Condition="NOT Installed OR REINSTALL" />
      <Custom Action="SetOptimizerRecovery" After="GrantOptimizerLogAcl"
              Condition="NOT Installed OR REINSTALL" />
      <Custom Action="RestoreOptimizerAutoStart" After="SetOptimizerRecovery"
              Condition="OPTIMIZERSTARTTYPE=&quot;#2&quot; AND NOT REMOVE=&quot;ALL&quot;" />
      <Custom Action="RestoreOptimizerManualStart" After="RestoreOptimizerAutoStart"
              Condition="OPTIMIZERSTARTTYPE=&quot;#3&quot; AND NOT REMOVE=&quot;ALL&quot;" />
      <Custom Action="RestartOptimizer" After="RestoreOptimizerManualStart"
              Condition="OPTIMIZERSTARTTYPE=&quot;#2&quot; AND NOT REMOVE=&quot;ALL&quot;" />
<?endif ?>
      <!-- Uninstall: remove IIS module registration before files go away. -->
      <Custom Action="UnregisterModule" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

  </Package>
</Wix>
