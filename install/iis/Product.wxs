<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v5 MSI installer for We-Amp PageSpeed IIS module.

  Build:
    wix build install\iis\Product.wxs -ext WixToolset.Util.wixext ^
        -d ProductVersion=1.1.0 -d DisplayVersion=1.1.0-beta.1 ^
        -d UpgradeCode=77EA515C-A077-4D56-B92A-58E65D713423 ^
        -d BinDir=bazel-bin\pagespeed\iis -d SrcDir=. ^
        -arch x64 -o pagespeed-iis-1.1.0-beta.1-win-x64.msi

  Architecture notes:
    - W3SVC stop/start uses <ServiceControl> (MSI-native, no CA).
    - appcmd module register/unregister uses Type 50 deferred exe CAs
      (Windows Installer's built-in exe launcher — does NOT depend on
      Wix4UtilCA_X64 / WixQuietExec64). This avoids the C/C++ runtime
      dependency that broke stock Windows Server 2016 installs.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="We-Amp PageSpeed for IIS $(var.DisplayVersion)"
           Manufacturer="We-Amp B.V."
           Version="$(var.ProductVersion)"
           UpgradeCode="$(var.UpgradeCode)"
           Language="1033"
           Codepage="1252"
           InstallerVersion="500"
           Scope="perMachine">

    <!-- Upgrade: default (afterInstallValidate) schedule. RemoveExistingProducts
         runs BEFORE the new product installs, so W3SVC stops once for the old
         uninstall and starts once after the new install - a single
         <ServiceControl> cycle instead of two.

         Trade-off vs. afterInstallExecute: a failed new install no longer
         leaves the old product intact; the user is left with neither installed.
         We accept this because the double-cycle caused IIS lockups on warm
         systems (beta.9 upgrade-over-running-IIS), which is far more common
         in practice than mid-upgrade failures. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <Media Id="1" Cabinet="pagespeed.cab" EmbedCab="yes" />

    <!-- Add/Remove Programs metadata -->
    <Property Id="ARPURLINFOABOUT" Value="https://modpagespeed.com" />
    <Property Id="ARPHELPLINK" Value="https://modpagespeed.com" />

    <!-- Detect IIS via registry -->
    <Property Id="IISMAJORVERSION">
      <RegistrySearch Id="IISVersionSearch" Root="HKLM"
                      Key="SOFTWARE\Microsoft\InetStp"
                      Name="MajorVersion" Type="raw" />
    </Property>
    <Launch Condition="Installed OR IISMAJORVERSION"
            Message="IIS is required. Please install IIS (Web Server role) before running this installer." />

    <!-- Resolve the default wwwroot physical path. IIS records it in the
         registry; on stock installs this is C:\inetpub\wwwroot, but admins
         who moved it will have the real path here. If the key is missing
         we fall back to the conventional location below. -->
    <Property Id="IISWWWROOT">
      <RegistrySearch Id="WwwRootSearch" Root="HKLM"
                      Key="SOFTWARE\Microsoft\InetStp"
                      Name="PathWWWRoot" Type="raw" />
    </Property>
    <SetProperty Id="IISWWWROOT" Value="C:\inetpub\wwwroot"
                 After="AppSearch" Sequence="both"
                 Condition="NOT IISWWWROOT" />
    <!-- WWWROOTDIR is a Directory table id; MSI resolves it during
         CostFinalize. The SetProperty must fire BEFORE CostFinalize so
         the directory resolves to [IISWWWROOT] rather than the default
         (TARGETDIR). -->
    <SetProperty Id="WWWROOTDIR" Value="[IISWWWROOT]"
                 Before="CostFinalize" Sequence="both" />

    <!-- ================================================================ -->
    <!--  Directory layout                                                -->
    <!-- ================================================================ -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="WEAMPDIR" Name="We-Amp">
        <Directory Id="INSTALLDIR" Name="PageSpeed" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="WEAMPDATADIR" Name="We-Amp">
        <Directory Id="PAGESPEEDDATA" Name="PageSpeed">
          <Directory Id="CACHEDIR" Name="cache" />
          <Directory Id="LOGDIR" Name="logs" />
        </Directory>
        <!-- Legacy directory name that pagespeed_iis.dll reads config from. -->
        <Directory Id="IISWEBSPEEDDIR" Name="IISWebSpeed" />
      </Directory>
    </StandardDirectory>

    <!-- Default wwwroot — path resolved at install time via IISWWWROOT property. -->
    <StandardDirectory Id="TARGETDIR">
      <Directory Id="WWWROOTDIR" />
    </StandardDirectory>

    <!-- ================================================================ -->
    <!--  Components                                                      -->
    <!-- ================================================================ -->

    <!-- Main DLL -->
    <Component Id="MainDll" Directory="INSTALLDIR" Guid="*">
      <File Id="pagespeed_iis.dll"
            Source="$(var.BinDir)\pagespeed_iis.dll"
            KeyPath="yes" />
    </Component>

    <!-- Sample configuration -->
    <Component Id="SampleConfig" Directory="INSTALLDIR" Guid="*">
      <File Id="web.config.sample"
            Source="$(var.SrcDir)\install\iis\web.config.sample"
            KeyPath="yes" />
    </Component>

    <!--
      IIS service control — cycles BOTH the Windows Process Activation
      Service (WAS) and the World Wide Web Publishing Service (W3SVC)
      during install/upgrade/uninstall so that pagespeed_iis.dll is
      released by every w3wp.exe worker before InstallFiles tries to
      replace it.

      Why stop WAS, not just W3SVC?
        w3wp.exe worker processes are children of WAS, not W3SVC
        (despite a common misreading of IIS architecture docs).
        W3SVC depends on WAS. Stopping W3SVC alone leaves WAS up and
        does NOT force-terminate live workers — they drain their
        application-pool shutdown timeout (default 90s, often longer
        on warm production sites with long-running requests), during
        which they continue to hold pagespeed_iis.dll mapped. MSI's
        InstallFiles then SILENTLY skips the in-use file (Windows
        Installer schedules a pending-reboot replace and returns
        success), so the customer ends up with a "successful upgrade"
        that still serves the old DLL after the post-install iisreset.
        This is the root cause of the beta.10-through-beta.14 stale
        X-Page-Speed header bug.

      Why also taskkill w3wp.exe (see ForceKillW3wp CustomAction)?
        WAS-stop is supposed to synchronously terminate workers, but
        a handful of community reports describe edge cases (crash-
        dump in flight, app-domain shutdown hang) where WAS returns
        before its workers are fully gone. A defensive `taskkill /F`
        scheduled AFTER WAS stop and BEFORE InstallFiles is cheap
        insurance. If no workers remain, taskkill returns 128 ("no
        matching processes") which we mask with Return="ignore".

      Both ServiceControl rows are MSI-native (no Wix4UtilCA CRT
      dependency, same reasoning as the appcmd Type-34 CAs below).
      Wait="yes" makes the InstallExecuteSequence block on the stop
      completing.
    -->
    <Component Id="IisServiceControl" Directory="INSTALLDIR"
               Guid="A1B2C3D4-1001-4000-8000-000000000003">
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\We-Amp\PageSpeed"
                     Name="ServiceControlKey"
                     Type="integer" Value="1" KeyPath="yes" />
      <!-- Stop WAS first; w3wp.exe workers are children of WAS, not W3SVC.
           No Start attribute - W3SVC depends on WAS, so starting W3SVC
           below transitively starts WAS. -->
      <ServiceControl Id="WAS"
                      Name="WAS"
                      Stop="both"
                      Wait="yes" />
      <ServiceControl Id="W3SVC"
                      Name="W3SVC"
                      Start="both"
                      Stop="both"
                      Wait="yes" />
    </Component>

    <!-- Cache directory — created with default inheritance. ACL for
         IIS_IUSRS write access is applied post-install via runtime
         bootstrap (module first-run creates subdirs under SYSTEM), or
         by admin post-install if stricter ACLs are needed.
         Permanent="yes" preserves cache on uninstall. -->
    <Component Id="CacheDirComp" Directory="CACHEDIR"
               Guid="A1B2C3D4-1001-4000-8000-000000000001"
               KeyPath="yes" Permanent="yes">
      <CreateFolder />
    </Component>

    <!-- Log directory — same policy as cache. -->
    <Component Id="LogDirComp" Directory="LOGDIR"
               Guid="A1B2C3D4-1001-4000-8000-000000000002"
               KeyPath="yes" Permanent="yes">
      <CreateFolder />
    </Component>

    <!-- Default pagespeed.config. NeverOverwrite preserves admin edits
         across upgrades; Permanent leaves the file on uninstall so a
         reinstall picks up existing customizations. -->
    <Component Id="PagespeedConfig" Directory="IISWEBSPEEDDIR"
               Guid="A1B2C3D4-1001-4000-8000-000000000004"
               NeverOverwrite="yes" Permanent="yes">
      <File Id="pagespeed.config"
            Source="$(var.SrcDir)\install\iis\pagespeed.config"
            KeyPath="yes" />
    </Component>

    <!-- Site-level pagespeed.config in the default wwwroot. The IIS module
         bails in OnBeginRequest unless the application's physical path
         contains a pagespeed.config / iiswebspeed.config, so a bare MSI
         install produces a no-op module. Dropping a default into the
         Default Web Site's root restores drop-in IISpeed 1.0 behavior.
         NeverOverwrite preserves existing IISpeed configs on upgrade;
         Permanent keeps admin edits through uninstall/reinstall.
         Conditional on IISWWWROOT in case the registry lookup and the
         fallback both leave the property empty on exotic setups. -->
    <Component Id="SitePagespeedConfig" Directory="WWWROOTDIR"
               Guid="A1B2C3D4-1001-4000-8000-000000000005"
               NeverOverwrite="yes" Permanent="yes"
               Condition="IISWWWROOT">
      <File Id="site_pagespeed.config"
            Name="pagespeed.config"
            Source="$(var.SrcDir)\install\iis\pagespeed.config"
            KeyPath="yes" />
    </Component>

    <!-- ================================================================ -->
    <!--  Feature                                                         -->
    <!-- ================================================================ -->
    <Feature Id="ProductFeature" Title="PageSpeed for IIS" Level="1">
      <ComponentRef Id="MainDll" />
      <ComponentRef Id="SampleConfig" />
      <ComponentRef Id="IisServiceControl" />
      <ComponentRef Id="CacheDirComp" />
      <ComponentRef Id="LogDirComp" />
      <ComponentRef Id="PagespeedConfig" />
      <ComponentRef Id="SitePagespeedConfig" />
    </Feature>

    <!-- ================================================================ -->
    <!--  appcmd module registration — Type 34 deferred exe CAs           -->
    <!--                                                                  -->
    <!--  Type 34 = Source is a Directory table id (resolved to literal   -->
    <!--  path at exec time); Target is the command line, where the       -->
    <!--  first token is the exe path relative to that directory. No      -->
    <!--  third-party CA DLL — Windows Installer launches the exe         -->
    <!--  directly. Sidesteps the Wix4UtilCA_X64 CRT dependency that      -->
    <!--  broke stock Windows Server 2016 installs.                       -->
    <!--                                                                  -->
    <!--  Deferred CAs receive formatted data via the CustomActionData    -->
    <!--  property, populated by a paired SetProperty (auto-generated by  -->
    <!--  WiX for attributes that contain [INSTALLDIR] tokens).           -->
    <!-- ================================================================ -->

    <!-- Defensive force-kill of any lingering w3wp.exe worker after
         StopServices but before InstallFiles. See the IisServiceControl
         comment block above for rationale. taskkill /F returns 128 when
         no matching processes exist; Return="ignore" masks that. -->
    <CustomAction Id="ForceKillW3wp"
                  Directory="SystemFolder"
                  ExeCommand='taskkill.exe /F /IM w3wp.exe /T'
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="CleanRegistration"
                  Directory="SystemFolder"
                  ExeCommand="inetsrv\appcmd.exe uninstall module PageSpeedModule"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="RegisterModule"
                  Directory="SystemFolder"
                  ExeCommand='inetsrv\appcmd.exe install module /name:PageSpeedModule /image:"[INSTALLDIR]pagespeed_iis.dll" /add:true'
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!-- Full uninstall: remove the module registration before files disappear.
         Skipped on MajorUpgrade (UPGRADINGPRODUCTCODE is set then) so the
         freshly-registered new version survives the old product's removal. -->
    <CustomAction Id="UnregisterModule"
                  Directory="SystemFolder"
                  ExeCommand="inetsrv\appcmd.exe uninstall module PageSpeedModule"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <!-- Defensive w3wp kill: scheduled AFTER StopServices (which runs the
           WAS+W3SVC <ServiceControl> Stop rows from IisServiceControl) and
           BEFORE InstallFiles, so any worker that survived WAS-stop is gone
           before the DLL replace. -->
      <Custom Action="ForceKillW3wp" After="StopServices" />
      <!-- Install/repair: remove any stale registration, then register. -->
      <Custom Action="CleanRegistration" After="InstallFiles"
              Condition="NOT Installed OR REINSTALL" />
      <Custom Action="RegisterModule" After="CleanRegistration"
              Condition="NOT Installed OR REINSTALL" />
      <!-- Uninstall: remove IIS module registration before files go away. -->
      <Custom Action="UnregisterModule" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

  </Package>
</Wix>
