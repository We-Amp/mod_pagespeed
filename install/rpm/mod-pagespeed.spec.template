#------------------------------------------------------------------------------
#   Post install script
#------------------------------------------------------------------------------
%post

# Join the web-server user(s) to the `pagespeed` group. After the optimizer
# daemon's privilege drop (2.1) its cache volume, notify socket and shared
# config are group-rw (0660/0640 pagespeed:pagespeed), and group membership is
# what lets the module reach them. The module package performs the join
# because it is the package that knows its web server. Guarded and idempotent;
# a no-op when the optimizer package (which creates the group) is not
# installed -- dep-free degraded channels (EA4/el8) have no such group -- and
# a usermod failure must not fail the install: the module logs the degraded
# state loudly at startup instead.
if getent group pagespeed >/dev/null 2>&1; then
  for webuser in apache nginx; do
    if id "$webuser" >/dev/null 2>&1; then
      usermod -a -G pagespeed "$webuser" || true
    fi
  done
fi

# SELinux policy for the optimizer daemon. The .pp is shipped only by
# serving-pair builds (-d), so the file guard makes every line a no-op on
# builds without it and on hosts with SELinux disabled. On an enforcing EL9
# host the stock targeted policy gives httpd_t no access to the daemon's
# cache volume and notify socket, so in-place optimization never turns on
# without this module. Same philosophy as the group join above: a policy
# hiccup must not fail the install -- the module logs the degraded state
# loudly at startup instead.
if [ -f /usr/share/selinux/targeted/pagespeed-optimizer.pp ] && \
   /usr/sbin/selinuxenabled 2>/dev/null; then
  # Install (or upgrade) the module. Its embedded file contexts (from
  # pagespeed-optimizer.fc) register in the policy store here, so the
  # labels applied below survive restorecon and a full relabel. A failure
  # stays non-fatal (the package itself is fine; the module logs its
  # degraded state at startup) but must not be silent either.
  if ! /usr/sbin/semodule -i \
       /usr/share/selinux/targeted/pagespeed-optimizer.pp; then
    echo "mod-pagespeed: could not install the pagespeed-optimizer SELinux" \
      "policy module. On SELinux-enforcing hosts the web server cannot" \
      "reach the optimizer daemon, so in-place optimization stays off;" \
      "everything else is unaffected. Retry as root with: semodule -i" \
      "/usr/share/selinux/targeted/pagespeed-optimizer.pp" >&2
  fi
  # Relabel the daemon's paths now that the types exist -- the daemon
  # package creates them under the generic var_t / var_run_t / bin_t labels.
  for p in /usr/bin/pagespeed-optimizer \
           /var/cache/pagespeed-optimizer \
           /run/pagespeed-optimizer; do
    if [ -e "$p" ]; then
      /usr/sbin/restorecon -R "$p" || true
    fi
  done
  # A daemon already running under the old unconfined label only enters
  # pagespeed_t through a fresh exec. try-restart is a no-op when the daemon
  # is not running (fresh installs where it has not started yet transition
  # on its first start).
  systemctl try-restart pagespeed-optimizer.service >/dev/null 2>&1 || true
fi

exit 0

#------------------------------------------------------------------------------
#   Pre uninstallation script
#------------------------------------------------------------------------------
%preun

if [ "$1" -eq "0" ]; then
  # Uninstall: disable the module so Apache doesn't crash on restart.
  # RPM has no a2dismod; comment out the LoadModule directive.
  if [ -f @@APACHE_CONFDIR@@/@@PAGESPEED_CONF_PREFIX@@pagespeed.conf ]; then
    sed -i 's/^LoadModule pagespeed_module/#LoadModule pagespeed_module/' \
      @@APACHE_CONFDIR@@/@@PAGESPEED_CONF_PREFIX@@pagespeed.conf
  fi
fi

exit 0

#------------------------------------------------------------------------------
#   Post uninstallation script
#------------------------------------------------------------------------------
%postun

if [ "$1" -eq "0" ] && /usr/sbin/selinuxenabled 2>/dev/null && \
   /usr/sbin/semodule -l 2>/dev/null | grep -q '^pagespeed-optimizer'; then
  # Final erase. Stop a running daemon FIRST, while its domain still exists
  # in the policy: after semodule -r its type is gone, a still-running
  # daemon's context becomes unlabeled_t, and that is a type even systemd
  # cannot signal (measured: 22x init_t -> unlabeled_t { signal signull
  # sigkill } denials, and a daemon init could not stop). Then remove the
  # module, put the labels back to stock, and start the daemon again --
  # it comes up in its stock (unconfined_service_t) domain, the pre-policy
  # status quo. Best-effort throughout: a partially removed policy must not
  # fail the erase. NB: %postun runs after this package's files are gone, so
  # the guard keys on the installed module, not on the shipped .pp file.
  daemon_was_active=0
  if systemctl is-active --quiet pagespeed-optimizer.service; then
    daemon_was_active=1
    systemctl stop pagespeed-optimizer.service || true
  fi
  /usr/sbin/semodule -r pagespeed-optimizer 2>/dev/null || true
  for p in /usr/bin/pagespeed-optimizer \
           /var/cache/pagespeed-optimizer \
           /run/pagespeed-optimizer; do
    if [ -e "$p" ]; then
      /usr/sbin/restorecon -R "$p" || true
    fi
  done
  if [ "$daemon_was_active" -eq 1 ]; then
    systemctl start pagespeed-optimizer.service >/dev/null 2>&1 || true
  fi
fi

exit 0
