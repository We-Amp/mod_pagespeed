#   Prologue information
#------------------------------------------------------------------------------
Summary         : @@SHORTDESC@@
License         : Apache Software License
Name            : @@PACKAGE@@
Version         : @@VERSION@@
Release         : @@REVISION@@
Group           : System Environment/Daemons
Vendor          : @@COMPANY_FULLNAME@@
Url             : @@PRODUCTURL@@
Packager        : @@MAINTNAME@@ <@@MAINTMAIL@@>

#------------------------------------------------------------------------------
# Tested on:
# TODO
#------------------------------------------------------------------------------

Provides        : @@PROVIDES@@ = %{version}
Requires        : @@DEPENDS@@

#------------------------------------------------------------------------------
#   Description
#------------------------------------------------------------------------------
%Description
@@FULLDESC@@

#------------------------------------------------------------------------------
#   Build rule - How to make the package
#------------------------------------------------------------------------------
%build

#------------------------------------------------------------------------------
#       Installation rule - how to install it (note that it
#   gets installed into a temp directory given by $RPM_BUILD_ROOT)
#------------------------------------------------------------------------------
%install
rm -rf "$RPM_BUILD_ROOT"

if [ -z "@@STAGEDIR@@" -o ! -d "@@STAGEDIR@@" ] ; then
    echo "@@STAGEDIR@@ appears to be incorrectly set - aborting"
    exit 1
fi

install -m 755 -d \
  "$RPM_BUILD_ROOT/etc" \
  "$RPM_BUILD_ROOT/usr" \
  "$RPM_BUILD_ROOT/var"
# This is hard coded for now
cp -a "@@STAGEDIR@@/etc/" "$RPM_BUILD_ROOT/"
cp -a "@@STAGEDIR@@/usr/" "$RPM_BUILD_ROOT/"
cp -a "@@STAGEDIR@@/var/" "$RPM_BUILD_ROOT/"

#------------------------------------------------------------------------------
#   Rule to clean up a build
#------------------------------------------------------------------------------
%clean
rm -rf "$RPM_BUILD_ROOT"

#------------------------------------------------------------------------------
#   Files listing.
#------------------------------------------------------------------------------
%files
%defattr(-,root,root)
@@APACHE_MODULEDIR@@/mod_pagespeed.so
%config(noreplace) @@APACHE_CONFDIR@@/@@PAGESPEED_CONF_PREFIX@@pagespeed.conf
%config(noreplace) @@APACHE_CONFDIR@@/@@PAGESPEED_CONF_PREFIX@@pagespeed_libraries.conf
%attr(-, @@APACHE_USER@@, @@APACHE_USER@@) @@MOD_PAGESPEED_CACHE@@
%attr(-, @@APACHE_USER@@, @@APACHE_USER@@) @@MOD_PAGESPEED_LOG@@

#------------------------------------------------------------------------------
#   Pre install script
#------------------------------------------------------------------------------
%pre

exit 0

#------------------------------------------------------------------------------
#   Post install script
#------------------------------------------------------------------------------
%post

# Join the web-server user(s) to the `pagespeed` group. After the optimizer
# daemon's privilege drop (2.1) its cache volume, notify socket and shared
# config are group-rw (0660/0640 pagespeed:pagespeed), and group membership is
# what lets the module reach them. The module package performs the join
# because it is the package that knows its web server. Guarded and idempotent;
# a no-op when the optimizer package (which creates the group) is not
# installed -- dep-free degraded channels (EA4/el8) have no such group -- and
# a usermod failure must not fail the install: the module logs the degraded
# state loudly at startup instead.
if getent group pagespeed >/dev/null 2>&1; then
  for webuser in apache nginx; do
    if id "$webuser" >/dev/null 2>&1; then
      usermod -a -G pagespeed "$webuser" || true
    fi
  done
fi

exit 0

#------------------------------------------------------------------------------
#   Pre uninstallation script
#------------------------------------------------------------------------------
%preun

if [ "$1" -eq "0" ]; then
  # Uninstall: disable the module so Apache doesn't crash on restart.
  # RPM has no a2dismod; comment out the LoadModule directive.
  if [ -f @@APACHE_CONFDIR@@/@@PAGESPEED_CONF_PREFIX@@pagespeed.conf ]; then
    sed -i 's/^LoadModule pagespeed_module/#LoadModule pagespeed_module/' \
      @@APACHE_CONFDIR@@/@@PAGESPEED_CONF_PREFIX@@pagespeed.conf
  fi
fi

exit 0

#------------------------------------------------------------------------------
#   Post uninstallation script
#------------------------------------------------------------------------------
%postun

exit 0
