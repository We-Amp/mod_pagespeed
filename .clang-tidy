# performance-enum-size is off in both lists: enum underlying types in this
# tree mirror a C ABI (daemon_abi.h) and change how enums print, so the check
# stays off; a name-keyed EnumIgnoreList is the path if it is ever wanted.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-unchecked-optional-access,
  -bugprone-narrowing-conversions,
  -bugprone-suspicious-missing-comma,
  -bugprone-exception-escape,
  -bugprone-pointer-arithmetic-on-polymorphic-object,
  -bugprone-multi-level-implicit-pointer-conversion,
  -bugprone-suspicious-stringview-data-usage,
  -bugprone-assignment-in-if-condition,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-deprecated-headers,
  modernize-redundant-void-arg,
  modernize-use-using,
  modernize-use-bool-literals,
  performance-*,
  -performance-enum-size
WarningsAsErrors: >
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-unchecked-optional-access,
  -bugprone-narrowing-conversions,
  -bugprone-suspicious-missing-comma,
  -bugprone-exception-escape,
  -bugprone-pointer-arithmetic-on-polymorphic-object,
  -bugprone-multi-level-implicit-pointer-conversion,
  -bugprone-suspicious-stringview-data-usage,
  -bugprone-assignment-in-if-condition,
  -bugprone-unused-return-value,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-using,
  performance-*,
  -performance-enum-size
CheckOptions:
  - key:   modernize-use-using.IgnoreExternC
    value: 'true'
# No header enforced yet; flips to '^(.*/execroot/[^/]+/)?(\./)?(base|net|pagespeed)/.*\.(h|hpp)$' plus an ExcludeHeaderFilterRegex once the header findings are fixed.
HeaderFilterRegex: '^$'
