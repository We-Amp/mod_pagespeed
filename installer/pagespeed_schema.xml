<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS Configuration Schema for PageSpeed Module

  This schema defines the configuration structure for the PageSpeed
  IIS native module. It enables IntelliSense in Visual Studio and
  validation in IIS Manager.

  Install by copying to:
  %windir%\System32\inetsrv\config\schema\pagespeed_schema.xml
-->
<configSchema>

  <!-- Main pagespeed section (under system.webServer) -->
  <sectionSchema name="system.webServer/pagespeed">
    <element name="settings">
      <!-- Master enable/disable switch -->
      <attribute name="enabled" type="bool" defaultValue="true">
        <description>Enable or disable PageSpeed optimization.</description>
      </attribute>

      <!-- License key for commercial features -->
      <attribute name="licenseKey" type="string" defaultValue="">
        <description>License key for commercial PageSpeed features.</description>
      </attribute>

      <!-- Cache configuration -->
      <element name="cache">
        <attribute name="fileCachePath" type="string" defaultValue="C:\PageSpeed\cache">
          <description>Path to the file-based cache directory.</description>
        </attribute>
        <attribute name="fileCacheSizeKb" type="int" defaultValue="102400">
          <description>Maximum size of the file cache in kilobytes (default 100MB).</description>
        </attribute>
        <attribute name="lruCacheSizeBytes" type="int" defaultValue="10485760">
          <description>Size of the in-memory LRU cache in bytes (default 10MB).</description>
        </attribute>
        <attribute name="fileCacheCleanIntervalMs" type="int" defaultValue="60000">
          <description>Interval between cache cleanup operations in milliseconds.</description>
        </attribute>

        <!-- Redis configuration -->
        <element name="redis">
          <attribute name="enabled" type="bool" defaultValue="false">
            <description>Enable Redis as external cache backend.</description>
          </attribute>
          <attribute name="server" type="string" defaultValue="localhost">
            <description>Redis server hostname.</description>
          </attribute>
          <attribute name="port" type="int" defaultValue="6379">
            <description>Redis server port.</description>
          </attribute>
          <attribute name="timeoutMs" type="int" defaultValue="5000">
            <description>Redis operation timeout in milliseconds.</description>
          </attribute>
          <attribute name="database" type="int" defaultValue="0">
            <description>Redis database index.</description>
          </attribute>
        </element>
      </element>

      <!-- Filter configuration -->
      <element name="filters">
        <attribute name="enabledFilters" type="string" defaultValue="">
          <description>
            Comma-separated list of filters to enable.
            Example: "combine_css,combine_javascript,rewrite_images"
          </description>
        </attribute>
        <attribute name="disabledFilters" type="string" defaultValue="">
          <description>
            Comma-separated list of filters to disable.
            Example: "inline_css,inline_javascript"
          </description>
        </attribute>
        <attribute name="level" type="enum" defaultValue="CoreFilters">
          <enum name="PassThrough" value="0" />
          <enum name="CoreFilters" value="1" />
          <enum name="OptimizeForBandwidth" value="2" />
          <enum name="MobilizeFilters" value="3" />
          <description>Preset filter level.</description>
        </attribute>
        <attribute name="rewriteDeadlineMs" type="int" defaultValue="2000">
          <description>Maximum time to wait for HTML rewriting in milliseconds.</description>
        </attribute>
      </element>

      <!-- Image optimization configuration -->
      <element name="images">
        <attribute name="recompressQuality" type="int" defaultValue="85">
          <description>JPEG recompression quality (0-100).</description>
        </attribute>
        <attribute name="webpQuality" type="int" defaultValue="80">
          <description>WebP conversion quality (0-100).</description>
        </attribute>
        <attribute name="webpEnabled" type="bool" defaultValue="true">
          <description>Enable WebP conversion for supporting browsers.</description>
        </attribute>
        <attribute name="lazyloadEnabled" type="bool" defaultValue="true">
          <description>Enable lazy loading of images.</description>
        </attribute>
        <attribute name="inlineMaxBytes" type="int" defaultValue="2048">
          <description>Maximum size for image inlining in bytes.</description>
        </attribute>
        <attribute name="resizeEnabled" type="bool" defaultValue="true">
          <description>Enable automatic image resizing.</description>
        </attribute>
        <attribute name="maxImageSizeBytes" type="int" defaultValue="8388608">
          <description>Maximum image size to process (default 8MB).</description>
        </attribute>
      </element>

      <!-- CSS optimization configuration -->
      <element name="css">
        <attribute name="combineEnabled" type="bool" defaultValue="true">
          <description>Enable CSS file combining.</description>
        </attribute>
        <attribute name="inlineEnabled" type="bool" defaultValue="true">
          <description>Enable CSS inlining.</description>
        </attribute>
        <attribute name="inlineMaxBytes" type="int" defaultValue="2048">
          <description>Maximum size for CSS inlining in bytes.</description>
        </attribute>
        <attribute name="minifyEnabled" type="bool" defaultValue="true">
          <description>Enable CSS minification.</description>
        </attribute>
        <attribute name="flattenImportsEnabled" type="bool" defaultValue="true">
          <description>Enable flattening of @import rules.</description>
        </attribute>
        <attribute name="flattenImportsMaxDepth" type="int" defaultValue="3">
          <description>Maximum depth for @import flattening.</description>
        </attribute>
      </element>

      <!-- JavaScript optimization configuration -->
      <element name="javascript">
        <attribute name="combineEnabled" type="bool" defaultValue="true">
          <description>Enable JavaScript file combining.</description>
        </attribute>
        <attribute name="inlineEnabled" type="bool" defaultValue="true">
          <description>Enable JavaScript inlining.</description>
        </attribute>
        <attribute name="inlineMaxBytes" type="int" defaultValue="2048">
          <description>Maximum size for JavaScript inlining in bytes.</description>
        </attribute>
        <attribute name="minifyEnabled" type="bool" defaultValue="true">
          <description>Enable JavaScript minification.</description>
        </attribute>
        <attribute name="deferEnabled" type="bool" defaultValue="false">
          <description>Enable JavaScript deferral.</description>
        </attribute>
      </element>

      <!-- HTML optimization configuration -->
      <element name="html">
        <attribute name="collapseWhitespace" type="bool" defaultValue="true">
          <description>Remove unnecessary whitespace from HTML.</description>
        </attribute>
        <attribute name="removeComments" type="bool" defaultValue="true">
          <description>Remove HTML comments.</description>
        </attribute>
        <attribute name="elideAttributes" type="bool" defaultValue="true">
          <description>Remove default attribute values.</description>
        </attribute>
        <attribute name="maxBufferBytes" type="int" defaultValue="2097152">
          <description>Maximum HTML buffer size (default 2MB).</description>
        </attribute>
      </element>

      <!-- Admin interface configuration -->
      <element name="admin">
        <attribute name="enabled" type="bool" defaultValue="true">
          <description>Enable the PageSpeed admin interface.</description>
        </attribute>
        <attribute name="path" type="string" defaultValue="/pagespeed_admin">
          <description>URL path for the admin interface.</description>
        </attribute>
        <attribute name="statisticsEnabled" type="bool" defaultValue="true">
          <description>Enable the statistics endpoint.</description>
        </attribute>
        <attribute name="statisticsPath" type="string" defaultValue="/pagespeed_statistics">
          <description>URL path for statistics.</description>
        </attribute>
        <attribute name="consolePath" type="string" defaultValue="/pagespeed_console">
          <description>URL path for the console.</description>
        </attribute>

        <!-- Admin authentication -->
        <element name="authentication">
          <attribute name="required" type="bool" defaultValue="false">
            <description>Require authentication for admin access.</description>
          </attribute>
          <attribute name="allowedIps" type="string" defaultValue="127.0.0.1,::1">
            <description>Comma-separated list of allowed IP addresses.</description>
          </attribute>
          <attribute name="token" type="string" defaultValue="">
            <description>Secret token for admin authentication.</description>
          </attribute>
        </element>
      </element>

      <!-- Fetcher configuration -->
      <element name="fetcher">
        <attribute name="timeoutMs" type="int" defaultValue="5000">
          <description>Timeout for resource fetches in milliseconds.</description>
        </attribute>
        <attribute name="proxy" type="string" defaultValue="">
          <description>HTTP proxy for resource fetches.</description>
        </attribute>
        <attribute name="maxConcurrentFetches" type="int" defaultValue="10">
          <description>Maximum concurrent resource fetches.</description>
        </attribute>
        <attribute name="sslCertFile" type="string" defaultValue="">
          <description>Path to SSL certificate file for HTTPS fetches.</description>
        </attribute>
      </element>

      <!-- Beacon configuration -->
      <element name="beacon">
        <attribute name="enabled" type="bool" defaultValue="false">
          <description>Enable the beacon endpoint for critical CSS/images.</description>
        </attribute>
        <attribute name="path" type="string" defaultValue="/pagespeed_beacon">
          <description>URL path for the beacon endpoint.</description>
        </attribute>
      </element>

      <!-- Domain configuration -->
      <element name="domains">
        <collection addElement="add" clearElement="clear" removeElement="remove">
          <attribute name="name" type="string" isUniqueKey="true" isRequired="true">
            <description>Domain name pattern.</description>
          </attribute>
          <attribute name="enabled" type="bool" defaultValue="true">
            <description>Enable optimization for this domain.</description>
          </attribute>
          <attribute name="mapTo" type="string" defaultValue="">
            <description>Map this domain to another for resource fetching.</description>
          </attribute>
        </collection>
      </element>

      <!-- URL patterns to allow/disallow -->
      <element name="urlPatterns">
        <element name="allow">
          <collection addElement="add" clearElement="clear" removeElement="remove">
            <attribute name="pattern" type="string" isRequired="true">
              <description>URL pattern to allow (regex).</description>
            </attribute>
          </collection>
        </element>
        <element name="disallow">
          <collection addElement="add" clearElement="clear" removeElement="remove">
            <attribute name="pattern" type="string" isRequired="true">
              <description>URL pattern to disallow (regex).</description>
            </attribute>
          </collection>
        </element>
      </element>

    </element>
  </sectionSchema>

</configSchema>
